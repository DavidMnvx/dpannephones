{# Modal + JS pour la création rapide d'une couleur.
   Le bouton "+ Nouvelle couleur" est injecté dans le photo picker.
   Après création, la couleur est ajoutée à tous les dropdowns .photo-thumb-color-select
   ainsi qu'à la variable JS `allColors` du photo picker. #}
<style>
    .color-inline-add {
        margin-left: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        background: transparent;
        border: 1px dashed #ec4899;
        color: #ec4899;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }
    .color-inline-add:hover { background: rgba(236,72,153,0.06); }
    .color-modal-overlay {
        display: none;
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 2000;
        align-items: center; justify-content: center;
    }
    .color-modal-overlay.open { display: flex; }
    .color-modal {
        background: #fff;
        border-radius: 14px;
        padding: 24px 26px;
        width: min(420px, 92vw);
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .color-modal h4 { margin: 0 0 4px; color: #1a2b4b; font-size: 18px; font-weight: 700; }
    .color-modal .modal-sub { color: #7d8896; font-size: 13px; margin-bottom: 20px; }
    .color-modal .form-row { display: flex; gap: 10px; align-items: flex-end; margin-bottom: 16px; }
    .color-modal .form-row > div { flex: 1; }
    .color-modal label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #1a2b4b; }
    .color-modal input[type="text"] {
        width: 100%; padding: 10px 14px; border-radius: 8px;
        border: 1.5px solid #dde3ea; font-size: 14px;
        box-sizing: border-box;
    }
    .color-modal input[type="color"] {
        width: 60px; height: 42px; border-radius: 8px; padding: 3px;
        border: 1.5px solid #dde3ea; cursor: pointer;
    }
    .color-modal .modal-actions {
        display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px;
    }
    .color-modal-error { color: #dc2626; font-size: 13px; margin-bottom: 12px; display: none; }
</style>

<div class="color-modal-overlay" id="colorAddModal">
    <div class="color-modal">
        <h4><i class="fas fa-palette mr-2" style="color:#ec4899;"></i>Nouvelle couleur</h4>
        <div class="modal-sub">Elle sera immédiatement disponible dans les sélecteurs de couleur des photos.</div>

        <div class="color-modal-error" id="colorModalError"></div>

        <div class="form-row">
            <div>
                <label for="colorModalName">Nom</label>
                <input type="text" id="colorModalName" placeholder="Ex. Bleu ciel, Rose pastel…" required>
            </div>
            <div style="flex:0 0 auto;">
                <label for="colorModalHexPicker">Code</label>
                <input type="color" id="colorModalHexPicker" value="#3B82F6">
            </div>
            <div style="flex:0 0 110px;">
                <label for="colorModalHex">Hex</label>
                <input type="text" id="colorModalHex" value="#3B82F6" style="font-family:monospace;text-transform:uppercase;" pattern="^#[0-9a-fA-F]{6}$">
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="closeColorModal()">Annuler</button>
            <button type="button" class="btn-admin-submit" onclick="submitColorModal()" id="colorModalSubmit">
                <i class="fas fa-plus mr-1"></i> Créer
            </button>
        </div>
    </div>
</div>

<script>
(function() {
    // Injecte le bouton "+ Nouvelle couleur" dans le slot dédié (au-dessus de description)
    var slot = document.getElementById('newColorButtonSlot');
    if (!slot) return;

    var newBtn = document.createElement('button');
    newBtn.type = 'button';
    newBtn.className = 'color-inline-add';
    newBtn.innerHTML = '<i class="fas fa-palette"></i> Créer une nouvelle couleur';
    newBtn.onclick = openColorModal;
    slot.appendChild(newBtn);

    // Sync hex picker <-> text
    var picker = document.getElementById('colorModalHexPicker');
    var text   = document.getElementById('colorModalHex');
    picker.addEventListener('input', function() { text.value = picker.value.toUpperCase(); });
    text.addEventListener('input', function() {
        if (/^#[0-9a-fA-F]{6}$/.test(text.value)) picker.value = text.value;
    });
})();

function openColorModal() {
    document.getElementById('colorAddModal').classList.add('open');
    document.getElementById('colorModalName').focus();
    document.getElementById('colorModalError').style.display = 'none';
}
function closeColorModal() {
    document.getElementById('colorAddModal').classList.remove('open');
    document.getElementById('colorModalName').value = '';
    document.getElementById('colorModalHex').value = '#3B82F6';
    document.getElementById('colorModalHexPicker').value = '#3B82F6';
}

async function submitColorModal() {
    var name = document.getElementById('colorModalName').value.trim();
    var hex  = document.getElementById('colorModalHex').value.trim();
    var err  = document.getElementById('colorModalError');
    var btn  = document.getElementById('colorModalSubmit');

    if (!name) { err.textContent = 'Nom requis.'; err.style.display = 'block'; return; }
    if (!/^#[0-9a-fA-F]{6}$/.test(hex)) { err.textContent = 'Code hex invalide (#RRGGBB).'; err.style.display = 'block'; return; }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Création…';

    try {
        var fd = new FormData();
        fd.append('name', name);
        fd.append('hex', hex);
        var res = await fetch('{{ path('admin_colors_ajax_create') }}', { method: 'POST', body: fd, credentials: 'include' });
        var data = await res.json();

        if (!data.ok) {
            err.textContent = data.error || 'Erreur inconnue.';
            err.style.display = 'block';
            return;
        }

        // Ajoute la nouvelle couleur à tous les <select> couleur des vignettes photo
        document.querySelectorAll('.photo-thumb-color-select').forEach(function(sel) {
            var opt = document.createElement('option');
            opt.value = String(data.color.id);
            opt.textContent = data.color.name;
            sel.appendChild(opt);
        });

        // Ajoute-la aussi à la variable JS `allColors` du photo picker si accessible
        if (window.__addPhotoPickerColor) {
            window.__addPhotoPickerColor(data.color);
        }

        closeColorModal();
    } catch (e) {
        err.textContent = 'Erreur réseau.';
        err.style.display = 'block';
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plus mr-1"></i> Créer';
    }
}
</script>
