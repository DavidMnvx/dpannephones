{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="container-fluid p-0">
    <div class="row no-gutters">

        {# Sidebar — liens simples, pas de listes imbriquées #}
        <nav id="sidebar" class="col-md-2 d-md-block">
            <div class="sidebar-header">Navigation</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="#" onclick="showContent('dashboard')">
                        <i class="fas fa-tachometer-alt"></i> Tableau de bord
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_stats') }}">
                        <i class="fas fa-chart-line"></i> Statistiques
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" onclick="showContent('marques')">
                        <i class="fas fa-tags"></i> Marques
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" onclick="showContent('modeles')">
                        <i class="fas fa-mobile-alt"></i> Modèles
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" onclick="showContent('reparations')">
                        <i class="fas fa-tools"></i> Réparations
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_article_index') }}">
                        <i class="fas fa-shopping-bag"></i> Articles boutique
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_commandes') }}">
                        <i class="fas fa-receipt"></i> Commandes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_promos') }}">
                        <i class="fas fa-ticket-alt" style="color:#16a34a;"></i> Codes promo
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_clients') }}">
                        <i class="fas fa-users"></i> Clients
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_partenaires') }}">
                        <i class="fas fa-handshake"></i> Partenaires
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_social_links') }}">
                        <i class="fas fa-share-alt" style="color:#3b82f6;"></i> Réseaux sociaux
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_site_images') }}">
                        <i class="fas fa-images"></i> Images du site
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_google_reviews') }}">
                        <i class="fab fa-google"></i> Avis Google
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_client_reviews') }}">
                        <i class="fas fa-star-half-alt" style="color:#f59e0b;"></i> Avis clients
                        {% set pendingCount = admin_pending_reviews_count() %}
                        {% if pendingCount > 0 %}
                            <span class="sidebar-notif-badge" title="{{ pendingCount }} avis en attente de modération">{{ pendingCount }}</span>
                        {% endif %}
                    </a>
                </li>
                <li class="nav-item" style="margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,0.08);">
                    <a class="nav-link" href="{{ path('admin_settings') }}">
                        <i class="fas fa-cog"></i> Paramètres
                    </a>
                </li>
            </ul>
        </nav>

        {# Contenu principal #}
        <main id="admin-main" class="col-md-10">

            {# Bannière de bienvenue #}
            <div class="admin-welcome">
                <div>
                    <h2>Tableau de bord</h2>
                    <p>Gérez vos marques, modèles et réparations</p>
                </div>
                <div class="admin-stats">
                    <div class="stat-box">
                        <span class="stat-number">{{ marques|length }}</span>
                        <span class="stat-label">Marques</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-number">{{ models|length }}</span>
                        <span class="stat-label">Modèles</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-number">{{ reparations|length }}</span>
                        <span class="stat-label">Réparations</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-number">{{ articles|length }}</span>
                        <span class="stat-label">Articles</span>
                    </div>
                </div>
            </div>

            {# Flash messages #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle mr-2"></i> {{ message }}
                    <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
                </div>
            {% endfor %}

            <div id="content-details">

                {# Dashboard #}
                <div id="dashboard-content" class="content-section">

                    {# KPI cards #}
                    <div class="row mb-4">
                        <div class="col-md-2 mb-3">
                            <div class="dash-card" onclick="showContent('marques')">
                                <i class="fas fa-tags"></i>
                                <h4>Marques</h4>
                                <p>{{ marques|length }} enregistrée(s)</p>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="dash-card" onclick="showContent('modeles')">
                                <i class="fas fa-mobile-alt"></i>
                                <h4>Modèles</h4>
                                <p>{{ models|length }} enregistré(s)</p>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <div class="dash-card" onclick="showContent('reparations')">
                                <i class="fas fa-tools"></i>
                                <h4>Réparations</h4>
                                <p>{{ reparations|length }} enregistrée(s)</p>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a href="{{ path('admin_article_index') }}" style="text-decoration:none;">
                                <div class="dash-card">
                                    <i class="fas fa-shopping-bag"></i>
                                    <h4>Articles boutique</h4>
                                    <p>{{ articles|length }} article(s)</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a href="{{ path('admin_commandes') }}" style="text-decoration:none;">
                                <div class="dash-card dash-card--commandes">
                                    <i class="fas fa-receipt"></i>
                                    <h4>Commandes</h4>
                                    <p>{{ nbCommandes }} au total</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a href="{{ path('admin_clients') }}" style="text-decoration:none;">
                                <div class="dash-card dash-card--clients">
                                    <i class="fas fa-users"></i>
                                    <h4>Clients</h4>
                                    <p>{{ nbClients }} inscrit(s)</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a href="{{ path('admin_partenaires') }}" style="text-decoration:none;">
                                <div class="dash-card">
                                    <i class="fas fa-handshake"></i>
                                    <h4>Partenaires</h4>
                                    <p>Gérer le réseau</p>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-2 mb-3">
                            <a href="{{ path('admin_client_reviews') }}" style="text-decoration:none;">
                                <div class="dash-card dash-card--reviews {{ nbReviewsPending > 0 ? 'dash-card--reviews-pending' : '' }}">
                                    {% if nbReviewsPending > 0 %}
                                        <span class="dash-card-badge">{{ nbReviewsPending }}</span>
                                    {% endif %}
                                    <i class="fas fa-star-half-alt"></i>
                                    <h4>Avis clients</h4>
                                    <p>
                                        {% if nbReviewsTotal > 0 %}
                                            {{ nbReviewsTotal }} au total
                                            {% if nbReviewsPending > 0 %}
                                                · <strong style="color:#d97706;">{{ nbReviewsPending }} à modérer</strong>
                                            {% endif %}
                                        {% else %}
                                            Aucun avis encore
                                        {% endif %}
                                    </p>
                                </div>
                            </a>
                        </div>
                    </div>

                    {# ═══ Widget — Avis en attente de modération ═══ #}
                    {% if nbReviewsPending > 0 %}
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="admin-card admin-card--pending-reviews">
                                <h3 style="margin-bottom:14px;">
                                    <i class="fas fa-clock mr-2" style="color:#f59e0b;"></i>
                                    Avis clients en attente de modération
                                    <span class="expedier-badge" style="background:#f59e0b;">{{ nbReviewsPending }}</span>
                                    <a href="{{ path('admin_client_reviews') }}"
                                       style="float:right;font-size:12px;font-weight:600;color:rgb(9,71,113);text-decoration:none;">
                                        Modérer maintenant →
                                    </a>
                                </h3>
                                <p style="font-size:13px;color:#6b7280;margin:0 0 6px;">
                                    Des clients attendent que leurs avis soient validés et publiés sur le site.
                                </p>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {# Widget — Commandes à expédier (PRIORITÉ métier) #}
                    {% if commandesAExpedier is not empty %}
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="admin-card admin-card--expedier">
                                <h3 style="margin-bottom:14px;">
                                    <i class="fas fa-shipping-fast mr-2" style="color:#e8732a;"></i>
                                    Commandes à expédier
                                    <span class="expedier-badge">{{ commandesAExpedier|length }}</span>
                                    <a href="{{ path('admin_commandes', {statut: 'en_preparation'}) }}" style="float:right;font-size:12px;font-weight:600;color:rgb(9,71,113);text-decoration:none;">Tout voir →</a>
                                </h3>
                                <div class="expedier-grid">
                                    {% for cmd in commandesAExpedier %}
                                    <a href="{{ path('admin_commande_show', {id: cmd.id}) }}" class="expedier-row">
                                        <div class="expedier-id">#{{ cmd.id }}</div>
                                        <div class="expedier-client">
                                            {% if cmd.user %}
                                                <i class="fas fa-user" style="color:#6c757d;margin-right:4px;font-size:11px;"></i>
                                                {{ cmd.user.prenom }} {{ cmd.user.nom }}
                                            {% else %}
                                                <span style="color:#adb5bd;">Invité</span>
                                            {% endif %}
                                        </div>
                                        <div class="expedier-date">
                                            <i class="fas fa-calendar-alt" style="color:#adb5bd;margin-right:4px;font-size:11px;"></i>
                                            {{ cmd.createdAt|date('d/m/Y') }}
                                        </div>
                                        <div class="expedier-total">{{ cmd.total|number_format(2, ',', ' ') }} €</div>
                                        <div class="expedier-action">
                                            <span class="expedier-btn"><i class="fas fa-truck mr-1"></i> Expédier</span>
                                        </div>
                                    </a>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {# ═══ Widget — Meilleures ventes (analytics) ═══ #}
                    {% if bestSellers is not empty %}
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="admin-card">
                                <h3 style="margin-bottom:14px;">
                                    <i class="fas fa-trophy mr-2" style="color:#fbbf24;"></i>
                                    Meilleures ventes
                                    <span class="bestseller-total-badge">
                                        {{ totalArticlesVendus }} article{{ totalArticlesVendus > 1 ? 's' : '' }} vendu{{ totalArticlesVendus > 1 ? 's' : '' }}
                                    </span>
                                    <a href="{{ path('admin_article_index') }}"
                                       style="float:right;font-size:12px;font-weight:600;color:rgb(9,71,113);text-decoration:none;">
                                        Voir tous les articles →
                                    </a>
                                </h3>

                                <div class="bestseller-list">
                                    {% for rank, item in bestSellers %}
                                        <div class="bestseller-row">
                                            <div class="bestseller-rank bestseller-rank--{{ rank + 1 }}">
                                                {% if rank == 0 %}
                                                    🥇
                                                {% elseif rank == 1 %}
                                                    🥈
                                                {% elseif rank == 2 %}
                                                    🥉
                                                {% else %}
                                                    #{{ rank + 1 }}
                                                {% endif %}
                                            </div>

                                            <div class="bestseller-thumb">
                                                {% if item.article_image %}
                                                    <img src="{{ asset('uploads/images/' ~ item.article_image) }}" alt="{{ item.article_name }}">
                                                {% else %}
                                                    <i class="fas fa-image"></i>
                                                {% endif %}
                                            </div>

                                            <div class="bestseller-info">
                                                <strong>{{ item.article_name }}</strong>
                                                {% if item.article_categorie %}
                                                    <small><i class="fas fa-tag" style="font-size:9px;"></i> {{ item.article_categorie|replace({'_': ' '})|capitalize }}</small>
                                                {% endif %}
                                            </div>

                                            <div class="bestseller-stats">
                                                <div class="bestseller-stat">
                                                    <span class="bestseller-stat-value">{{ item.quantite_vendue }}</span>
                                                    <span class="bestseller-stat-label">vendu{{ item.quantite_vendue > 1 ? 's' : '' }}</span>
                                                </div>
                                                <div class="bestseller-stat">
                                                    <span class="bestseller-stat-value">{{ item.nb_commandes }}</span>
                                                    <span class="bestseller-stat-label">commande{{ item.nb_commandes > 1 ? 's' : '' }}</span>
                                                </div>
                                            </div>

                                            <div class="bestseller-revenue">
                                                {{ item.ca_genere|number_format(2, ',', ' ') }} €
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {# Graphique + dernières commandes #}
                    <div class="row">
                        <div class="col-md-8 mb-4">
                            <div class="admin-card" style="padding-bottom:20px;">
                                <h3 style="margin-bottom:6px;">
                                    <i class="fas fa-chart-bar"></i> Ventes {{ annee }}
                                </h3>
                                <div style="font-size:13px;color:#6c757d;margin-bottom:20px;">
                                    Total annuel :
                                    <strong style="color:rgb(9,71,113);font-size:16px;">
                                        {{ totalAnnee|number_format(2, '.', ' ') }} €
                                    </strong>
                                </div>
                                <canvas id="salesChart" height="110"></canvas>
                            </div>
                        </div>

                        <div class="col-md-4 mb-4">

                            {# Dernières commandes #}
                            <div class="admin-card" style="padding-bottom:20px;margin-bottom:20px;">
                                <h3 style="margin-bottom:12px;">
                                    <i class="fas fa-receipt"></i> Dernières commandes
                                    <a href="{{ path('admin_commandes') }}" style="float:right;font-size:12px;font-weight:600;color:rgb(9,71,113);text-decoration:none;">Tout voir →</a>
                                </h3>
                                {% if commandes is empty %}
                                    <p class="text-muted text-center" style="font-size:13px;padding:20px 0;">
                                        Aucune commande pour l'instant.
                                    </p>
                                {% else %}
                                    <table class="table" style="font-size:13px;">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>Date</th>
                                                <th>Total</th>
                                                <th>Statut</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for cmd in commandes %}
                                                <tr>
                                                    <td><a href="{{ path('admin_commande_show', {id: cmd.id}) }}" style="font-weight:700;color:rgb(9,71,113);">#{{ cmd.id }}</a></td>
                                                    <td>{{ cmd.createdAt|date('d/m/Y') }}</td>
                                                    <td style="color:rgb(9,71,113);font-weight:700;">{{ cmd.total|number_format(2, '.', ' ') }} €</td>
                                                    <td>
                                                        {% set s = cmd.statut %}
                                                        <span style="font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px;
                                                            background:{{ s in ['livree','retiree','payee'] ? '#d4edda' : (s == 'annulee' ? '#f8d7da' : '#fff3cd') }};
                                                            color:{{ s in ['livree','retiree','payee'] ? '#155724' : (s == 'annulee' ? '#721c24' : '#856404') }};">
                                                            {{ s|replace({'_': ' '})|capitalize }}
                                                        </span>
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% endif %}
                            </div>

                            {# Graphique clients #}
                            <div class="admin-card" style="padding-bottom:20px;">
                                <h3 style="margin-bottom:4px;">
                                    <i class="fas fa-users"></i> Clients inscrits
                                    <a href="{{ path('admin_clients') }}" style="float:right;font-size:12px;font-weight:600;color:rgb(9,71,113);text-decoration:none;">Tout voir →</a>
                                </h3>
                                <div style="display:flex;align-items:center;gap:20px;margin-bottom:14px;">
                                    <div style="text-align:center;">
                                        <div style="font-size:28px;font-weight:800;color:rgb(9,71,113);line-height:1;">{{ nbClients }}</div>
                                        <div style="font-size:11px;color:#6c757d;">au total</div>
                                    </div>
                                    <div style="flex:1;">
                                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                                            <div style="width:10px;height:10px;border-radius:50%;background:#28a745;flex-shrink:0;"></div>
                                            <span style="font-size:12px;color:#374151;">Vérifiés</span>
                                            <strong style="margin-left:auto;font-size:13px;color:#155724;">{{ nbVerifies }}</strong>
                                        </div>
                                        <div style="display:flex;align-items:center;gap:8px;">
                                            <div style="width:10px;height:10px;border-radius:50%;background:#ffc107;flex-shrink:0;"></div>
                                            <span style="font-size:12px;color:#374151;">Non vérifiés</span>
                                            <strong style="margin-left:auto;font-size:13px;color:#856404;">{{ nbClients - nbVerifies }}</strong>
                                        </div>
                                    </div>
                                </div>
                                <div style="position:relative;height:140px;">
                                    <canvas id="clientsChart"></canvas>
                                </div>
                                {% if nbCommandes > 0 %}
                                <div style="margin-top:14px;padding-top:12px;border-top:1px solid #f1f3f5;">
                                    <div style="font-size:12px;color:#6c757d;margin-bottom:8px;font-weight:600;">Commandes par statut</div>
                                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                                        {% set statutColors = {
                                            'en_attente':     '#ffc107',
                                            'payee':          '#28a745',
                                            'en_preparation': 'rgb(9,71,113)',
                                            'expediee':       '#17a2b8',
                                            'livree':         '#6f42c1',
                                            'retiree':        '#6f42c1',
                                            'annulee':        '#dc3545'
                                        } %}
                                        {% set statutLabels = {
                                            'en_attente': 'En attente', 'payee': 'Payées',
                                            'en_preparation': 'En prépa.', 'expediee': 'Expédiées',
                                            'livree': 'Livrées', 'retiree': 'Retirées', 'annulee': 'Annulées'
                                        } %}
                                        {% for statut, nb in commandeCounts %}
                                            {% if nb > 0 %}
                                            <span style="font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px;
                                                         background:{{ statutColors[statut] ?? '#6c757d' }}22;
                                                         color:{{ statutColors[statut] ?? '#6c757d' }};
                                                         border:1px solid {{ statutColors[statut] ?? '#6c757d' }}44;">
                                                {{ statutLabels[statut] ?? statut }} <strong>{{ nb }}</strong>
                                            </span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                                {% endif %}
                            </div>

                        </div>
                    </div>

                </div>

                {# Marques #}
                <div id="marques-content" class="content-section" style="display: none;">
                    <div class="admin-card">
                        <h3><i class="fas fa-tags"></i> Ajouter une Marque</h3>
                        {{ form_start(marqueForm, {'attr': {'enctype': 'multipart/form-data', 'class': 'admin-form'}}) }}
                            <div class="form-section-title">Identité</div>
                            <div class="row">
                                <div class="col-md-6">{{ form_row(marqueForm.name) }}</div>
                                <div class="col-md-6">{{ form_row(marqueForm.image) }}</div>
                            </div>
                            <hr class="form-divider">
                            <div class="form-section-title">Compatible avec</div>
                            <div class="row">
                                <div class="col-md-3">{{ form_row(marqueForm.hasPhone) }}</div>
                                <div class="col-md-3">{{ form_row(marqueForm.hasTablet) }}</div>
                            </div>
                            <div style="margin-top:24px;">
                                <button type="submit" class="btn-admin-submit">
                                    <i class="fas fa-plus mr-1"></i> Ajouter la marque
                                </button>
                            </div>
                        {{ form_end(marqueForm) }}
                    </div>

                    <div class="admin-card">
                        <h3><i class="fas fa-list"></i> Liste des Marques ({{ marques|length }})</h3>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Logo</th>
                                    <th>Téléphone</th>
                                    <th>Tablette</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for marque in marques %}
                                    <tr>
                                        <td><strong>{{ marque.name }}</strong></td>
                                        <td>
                                            {% if marque.image %}
                                                <img src="{{ asset('uploads/images/' ~ marque.image) }}" alt="{{ marque.name }}" width="40" height="40">
                                            {% else %}—{% endif %}
                                        </td>
                                        <td>{% if marque.hasPhone %}<span class="badge-new">✓</span>{% else %}—{% endif %}</td>
                                        <td>{% if marque.hasTablet %}<span class="badge-new">✓</span>{% else %}—{% endif %}</td>
                                        <td>
                                            <a href="{{ path('admin_marque_edit', {'id': marque.id}) }}" class="btn btn-sm btn-warning">Éditer</a>
                                            <a href="{{ path('admin_marque_delete', {'id': marque.id}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Supprimer cette marque ?')">Supprimer</a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="5" class="text-center text-muted">Aucune marque enregistrée.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# Modèles #}
                <div id="modeles-content" class="content-section" style="display: none;">
                    <div class="admin-card">
                        <h3><i class="fas fa-mobile-alt"></i> Ajouter un Modèle</h3>
                        {{ form_start(modelForm, {'attr': {'enctype': 'multipart/form-data', 'class': 'admin-form'}}) }}
                            <div class="form-section-title">Identité</div>
                            <div class="row">
                                <div class="col-md-5">{{ form_row(modelForm.name) }}</div>
                                <div class="col-md-4">{{ form_row(modelForm.marque) }}</div>
                                <div class="col-md-3">{{ form_row(modelForm.image) }}</div>
                            </div>
                            <hr class="form-divider">
                            <div class="form-section-title">Compatible avec</div>
                            <div class="row">
                                <div class="col-md-3">{{ form_row(modelForm.hasPhone) }}</div>
                                <div class="col-md-3">{{ form_row(modelForm.hasTablet) }}</div>
                            </div>
                            <div style="margin-top:24px;">
                                <button type="submit" class="btn-admin-submit">
                                    <i class="fas fa-plus mr-1"></i> Ajouter le modèle
                                </button>
                            </div>
                        {{ form_end(modelForm) }}
                    </div>

                    <div class="admin-card">
                        <h3><i class="fas fa-list"></i> Liste des Modèles <span style="font-weight:400;color:#adb5bd;">({{ models|length }})</span></h3>

                        {# Onglets par marque #}
                        <div class="filter-tabs mb-3" id="modeles-tabs">
                            <div class="filter-tab active" onclick="filterModeles('tous', this)">
                                Toutes <span class="tab-count">{{ models|length }}</span>
                            </div>
                            {% set seen = [] %}
                            {% for model in models %}
                                {% if model.marque.name not in seen %}
                                    {% set seen = seen|merge([model.marque.name]) %}
                                    {% set cnt = models|filter(m => m.marque.name == model.marque.name)|length %}
                                    <div class="filter-tab" onclick="filterModeles('{{ model.marque.name|e('html_attr') }}', this)">
                                        {% if model.marque.image %}
                                            <img src="{{ asset('uploads/images/' ~ model.marque.image) }}"
                                                 width="16" height="16"
                                                 style="border-radius:3px;vertical-align:middle;margin-right:4px;object-fit:contain;">
                                        {% endif %}
                                        {{ model.marque.name }}
                                        <span class="tab-count">{{ cnt }}</span>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>

                        <table class="table" id="modeles-table">
                            <thead>
                                <tr>
                                    <th>Modèle</th>
                                    <th>Marque</th>
                                    <th>Image</th>
                                    <th>Tél.</th>
                                    <th>Tab.</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for model in models %}
                                    <tr data-marque="{{ model.marque.name }}">
                                        <td><strong>{{ model.name }}</strong></td>
                                        <td>
                                            {% if model.marque.image %}
                                                <img src="{{ asset('uploads/images/' ~ model.marque.image) }}" width="22" height="22" style="border-radius:4px;vertical-align:middle;margin-right:6px;object-fit:contain;">
                                            {% endif %}
                                            {{ model.marque.name }}
                                        </td>
                                        <td>
                                            {% if model.image %}
                                                <img src="{{ asset('uploads/images/' ~ model.image) }}" alt="{{ model.name }}" width="40" height="40">
                                            {% else %}—{% endif %}
                                        </td>
                                        <td>{% if model.hasPhone %}<span class="badge-new">✓</span>{% else %}—{% endif %}</td>
                                        <td>{% if model.hasTablet %}<span class="badge-new">✓</span>{% else %}—{% endif %}</td>
                                        <td>
                                            <a href="{{ path('admin_modele_edit', {'id': model.id}) }}" class="btn btn-sm btn-warning">Éditer</a>
                                            <a href="{{ path('admin_modele_delete', {'id': model.id}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Supprimer ce modèle ?')">Supprimer</a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="6" class="text-center text-muted">Aucun modèle enregistré.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                        <div id="no-modeles" style="display:none;text-align:center;padding:24px;color:#adb5bd;font-size:13px;">
                            Aucun modèle pour cette marque.
                        </div>
                    </div>
                </div>

                {# Réparations #}
                <div id="reparations-content" class="content-section" style="display: none;">
                    <div class="admin-card">
                        <h3><i class="fas fa-tools"></i> Ajouter une Réparation</h3>
                        {{ form_start(reparationForm, {'attr': {'class': 'admin-form'}}) }}
                            <div class="form-section-title">Identification</div>
                            <div class="row">
                                <div class="col-md-5">{{ form_row(reparationForm.name) }}</div>
                                <div class="col-md-4">{{ form_row(reparationForm.model) }}</div>
                                <div class="col-md-3">{{ form_row(reparationForm.prix) }}</div>
                            </div>
                            <hr class="form-divider">
                            <div class="form-section-title">Description</div>
                            {{ form_row(reparationForm.description) }}
                            <div style="margin-top:24px;">
                                <button type="submit" class="btn-admin-submit">
                                    <i class="fas fa-plus mr-1"></i> Ajouter la réparation
                                </button>
                            </div>
                        {{ form_end(reparationForm) }}
                    </div>

                    <div class="admin-card">
                        <h3><i class="fas fa-list"></i> Liste des Réparations ({{ reparations|length }})</h3>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Modèle</th>
                                    <th>Description</th>
                                    <th>Prix</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reparation in reparations %}
                                    <tr>
                                        <td><strong>{{ reparation.name }}</strong></td>
                                        <td>{{ reparation.model.name }}</td>
                                        <td>{{ reparation.description }}</td>
                                        <td><strong>{{ reparation.prix }} €</strong></td>
                                        <td>
                                            <a href="{{ path('admin_reparation_edit', {'id': reparation.id}) }}" class="btn btn-sm btn-warning">Éditer</a>
                                            <a href="{{ path('admin_reparation_delete', {'id': reparation.id}) }}" class="btn btn-sm btn-danger" onclick="return confirm('Supprimer cette réparation ?')">Supprimer</a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="5" class="text-center text-muted">Aucune réparation enregistrée.</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    function showContent(content) {
        document.querySelectorAll('.content-section').forEach(s => s.style.display = 'none');
        document.getElementById(content + '-content').style.display = 'block';
    }

    function filterModeles(marque, tabEl) {
        document.querySelectorAll('#modeles-tabs .filter-tab').forEach(t => t.classList.remove('active'));
        tabEl.classList.add('active');
        var rows = document.querySelectorAll('#modeles-table tbody tr[data-marque]');
        var visible = 0;
        rows.forEach(function(row) {
            var show = marque === 'tous' || row.getAttribute('data-marque') === marque;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });
        document.getElementById('no-modeles').style.display = visible === 0 ? 'block' : 'none';
    }

    // ── Graphique ventes (barres + ligne) ──
    const ventesData = {{ ventesParMois|json_encode|raw }};
    const moisLabels = ['Jan','Fév','Mar','Avr','Mai','Juin','Juil','Août','Sep','Oct','Nov','Déc'];
    const totaux = ventesData.map(v => v.total);
    const nbCmds = ventesData.map(v => v.nb);

    const ctx = document.getElementById('salesChart');
    if (ctx) {
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: moisLabels,
                datasets: [
                    {
                        label: 'CA mensuel (€)',
                        data: totaux,
                        backgroundColor: 'rgba(9, 71, 113, 0.75)',
                        borderColor: 'rgb(9, 71, 113)',
                        borderWidth: 1,
                        borderRadius: 6,
                        yAxisID: 'y',
                    },
                    {
                        label: 'Nb commandes',
                        data: nbCmds,
                        type: 'line',
                        borderColor: '#28a745',
                        backgroundColor: 'rgba(40,167,69,0.1)',
                        borderWidth: 2,
                        pointRadius: 4,
                        pointBackgroundColor: '#28a745',
                        tension: 0.3,
                        fill: true,
                        yAxisID: 'y2',
                    }
                ]
            },
            options: {
                responsive: true,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { labels: { font: { size: 12 }, boxWidth: 14 } },
                    tooltip: {
                        callbacks: {
                            label: ctx => ctx.datasetIndex === 0
                                ? ` ${ctx.parsed.y.toFixed(2)} €`
                                : ` ${ctx.parsed.y} commande(s)`
                        }
                    }
                },
                scales: {
                    y: {
                        type: 'linear', position: 'left', beginAtZero: true,
                        ticks: { callback: v => v + ' €', font: { size: 11 } },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    y2: {
                        type: 'linear', position: 'right', beginAtZero: true,
                        ticks: { stepSize: 1, font: { size: 11 } },
                        grid: { drawOnChartArea: false }
                    },
                    x: { ticks: { font: { size: 11 } }, grid: { display: false } }
                }
            }
        });
    }

    // ── Graphique donut clients ──
    const ctxClients = document.getElementById('clientsChart');
    if (ctxClients) {
        new Chart(ctxClients, {
            type: 'doughnut',
            data: {
                labels: ['Vérifiés', 'Non vérifiés'],
                datasets: [{
                    data: [{{ nbVerifies }}, {{ nbClients - nbVerifies }}],
                    backgroundColor: ['rgba(40,167,69,0.85)', 'rgba(255,193,7,0.85)'],
                    borderColor: ['#28a745', '#ffc107'],
                    borderWidth: 2,
                    hoverOffset: 6,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: c => ` ${c.parsed} client(s)`
                        }
                    }
                }
            }
        });
    }
</script>
{% endblock %}

{% endblock %}
