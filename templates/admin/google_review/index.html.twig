{% extends 'admin/layout.html.twig' %}
{% set active_section = 'google_reviews' %}

{% block admin_content %}
<div class="breadcrumb-admin">
    <a href="{{ path('admin_index') }}">Dashboard</a> › Avis Google
</div>

<div class="admin-welcome">
    <div>
        <h2><i class="fab fa-google mr-2"></i>Avis Google</h2>
        <p>La note et les avis de votre fiche Google, en direct sur le site — et les avis saisis à la main, en secours</p>
    </div>
    <div class="admin-stats">
        <div class="stat-box">
            <span class="stat-number">{{ reviews|length }}</span>
            <span class="stat-label">Avis</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">{{ reviews|filter(r => r.isActive)|length }}</span>
            <span class="stat-label">Visibles</span>
        </div>
        {% set avg = reviews|length > 0 ? (reviews|reduce((acc, r) => acc + r.rating, 0) / reviews|length)|round(1) : 0 %}
        <div class="stat-box">
            <span class="stat-number">{{ avg }}⭐</span>
            <span class="stat-label">Moyenne</span>
        </div>
    </div>
</div>

{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> {{ message }}
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> {{ message }}
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
{% endfor %}

{# ── Avis Google EN DIRECT (GooglePlacesService) : état, note, et les 5 avis lus sur la fiche ── #}
{% set state = google.state %}
{% set place = google.place %}
<div class="admin-card" id="google-direct">
    <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;">
        <h3 style="margin:0;"><i class="fas fa-satellite-dish"></i> En direct de Google
            {% if state == 'en_direct' %}
                <span class="badge badge-success" style="font-size:12px;vertical-align:middle;">Branché</span>
            {% elseif state == 'injoignable' %}
                <span class="badge badge-warning" style="font-size:12px;vertical-align:middle;">Google ne répond pas</span>
            {% else %}
                <span class="badge badge-secondary" style="font-size:12px;vertical-align:middle;">Pas branché</span>
            {% endif %}
        </h3>
        {% if state in ['en_direct', 'injoignable'] %}
            <form method="post" action="{{ path('admin_google_live_refresh') }}" style="margin:0;">
                <input type="hidden" name="_token" value="{{ csrf_token('google_live') }}">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-sync-alt mr-1"></i> Actualiser</button>
            </form>
        {% endif %}
    </div>

    {% if state == 'sans_cle' %}
        <p style="font-size:13.5px;color:#475569;margin:0;">
            Il manque la clé de l'API Google Places sur le serveur (<code>GOOGLE_PLACES_API_KEY</code>) : NosWeb s'en occupe.
            En attendant, le site affiche les avis saisis à la main ci-dessous.
        </p>
    {% elseif state == 'sans_fiche' %}
        <p style="font-size:13.5px;color:#475569;margin:0;">
            L'identifiant de la fiche Google n'est pas valable : corrigez-le dans
            <a href="{{ path('admin_settings') }}">Paramètres › Avis Google</a> (il commence par « ChIJ »).
            En attendant, le site affiche les avis saisis à la main ci-dessous.
        </p>
    {% elseif state == 'injoignable' %}
        <p style="font-size:13.5px;color:#475569;margin:0;">
            {{ google.error }} En attendant, le site affiche les avis saisis à la main ci-dessous.
        </p>
    {% else %}
        <p style="font-size:13.5px;color:#475569;">
            <strong style="color:#0f172a;">{{ place.rating|number_format(1, ',') }} ⭐ sur 5, {{ place.total }} avis</strong>,
            lus sur Google à {{ place.read_at|date('H\\hi', 'Europe/Paris') }}.
            Le site affiche cette note et ces avis, sauf ceux que vous masquez. Google relit la fiche toutes les heures,
            et ne donne que les 5 avis qu'il juge les plus pertinents.
        </p>
        {% if place.reviews is empty %}
            <p style="font-size:13px;color:#6b7280;margin:0;">La fiche n'a pas encore d'avis commenté : le site affiche les avis saisis à la main ci-dessous.</p>
        {% else %}
            <div class="row">
                {% for r in place.reviews %}
                    {% set off = r.hidden or not r.text %}
                    <div class="col-md-6 col-xl-4" style="margin-bottom:14px;">
                        <div style="height:100%;display:flex;flex-direction:column;gap:8px;padding:14px;border:1px solid #e5e7eb;border-radius:10px;background:{{ off ? '#f8fafc' : '#fff' }};">
                            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;">
                                <strong>{{ r.author_name }}</strong>
                                <span style="color:#f59e0b;font-size:14px;{{ off ? 'opacity:.55;' : '' }}" aria-label="{{ r.rating }} étoile{{ r.rating > 1 ? 's' }} sur 5">
                                    {%- for i in 1..5 %}<span style="{{ i > r.rating ? 'color:#e5e7eb;' : '' }}">★</span>{% endfor -%}
                                </span>
                                {% if r.relative_time %}<span style="font-size:12px;color:#6b7280;">{{ r.relative_time }}</span>{% endif %}
                                {% if r.hidden %}<span class="badge badge-secondary">Masqué</span>{% endif %}
                            </div>
                            {% if r.text %}
                                <p style="font-size:12.5px;color:#4b5563;margin:0;white-space:pre-line;{{ off ? 'opacity:.55;' : '' }}">{{ r.text }}</p>
                                <form method="post" action="{{ path('admin_google_live_toggle') }}" style="margin:auto 0 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('google_live') }}">
                                    <input type="hidden" name="key" value="{{ r.key }}">
                                    {% if r.hidden %}
                                        <button type="submit" class="btn btn-sm btn-outline-success"><i class="fas fa-eye mr-1"></i> Réafficher sur le site</button>
                                    {% else %}
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye-slash mr-1"></i> Masquer sur le site</button>
                                    {% endif %}
                                </form>
                            {% else %}
                                <p style="font-size:12px;color:#6b7280;margin:0;">Des étoiles sans commentaire : rien à afficher, le site ne le montre pas.</p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}
</div>

<div class="admin-card">
    <h3><i class="fas fa-plus-circle"></i> Ajouter un avis Google (secours)</h3>

    <p style="font-size:13px;color:#475569;">
        {% if state == 'en_direct' %}
            Le direct marche : les avis saisis à la main ne s'affichent que si Google cesse de répondre, ou si vous masquez tous ceux de Google.
        {% else %}
            Ce sont les avis saisis à la main qui s'affichent sur le site en ce moment.
        {% endif %}
    </p>

    <div style="background:#eff6fb;border-left:3px solid rgb(9,71,113);padding:12px 16px;border-radius:8px;margin-bottom:20px;">
        <div style="font-size:13px;font-weight:700;color:rgb(9,71,113);margin-bottom:4px;">
            <i class="fas fa-lightbulb mr-1"></i>Comment faire ?
        </div>
        <ol style="font-size:12.5px;color:#475569;margin:0;padding-left:20px;line-height:1.7;">
            <li>Allez sur votre <a href="https://www.google.com/search?q=D%27Panne+Phones+P%C3%A9lissanne" target="_blank">page Google D'Panne Phones</a> → "Voir tous les avis"</li>
            <li>Copiez le nom, la note, la date affichée (ex: "il y a 2 semaines") et le texte</li>
            <li>Collez ici et publiez — il apparaîtra immédiatement sur la page d'accueil</li>
        </ol>
    </div>

    {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
        <div class="form-section-title">Informations de l'avis</div>
        <div class="row">
            <div class="col-md-6">{{ form_row(form.authorName) }}</div>
            <div class="col-md-3">{{ form_row(form.rating) }}</div>
            <div class="col-md-3">{{ form_row(form.relativeTime) }}</div>
        </div>
        {{ form_row(form.text) }}

        <hr class="form-divider">
        <div class="form-section-title">Personnalisation</div>
        <div class="row">
            <div class="col-md-8">{{ form_row(form.profilePhotoUrl) }}</div>
            <div class="col-md-2">{{ form_row(form.sortOrder) }}</div>
            <div class="col-md-2 d-flex align-items-end">{{ form_row(form.isActive) }}</div>
        </div>

        <div style="margin-top:20px;">
            <button type="submit" class="btn-admin-submit">
                <i class="fas fa-plus mr-1"></i> Ajouter l'avis
            </button>
        </div>
    {{ form_end(form) }}
</div>

<div class="admin-card">
    <h3><i class="fas fa-list"></i> Liste des avis ({{ reviews|length }})</h3>

    <table class="table">
        <thead>
            <tr>
                <th style="width:50px;">Ordre</th>
                <th>Auteur</th>
                <th style="width:100px;">Note</th>
                <th>Texte</th>
                <th style="width:110px;">Date (texte)</th>
                <th style="width:80px;">Actif</th>
                <th style="width:200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for r in reviews %}
                <tr id="greview-{{ r.id }}" class="anchor-row">
                    <td><span class="badge badge-secondary">{{ r.sortOrder }}</span></td>
                    <td><strong>{{ r.authorName }}</strong></td>
                    <td style="color:#f59e0b;font-size:14px;">
                        {% for i in 1..5 %}<span style="{{ i > r.rating ? 'color:#e5e7eb;' : '' }}">★</span>{% endfor %}
                    </td>
                    <td style="font-size:12px;color:#4b5563;max-width:350px;">
                        {{ r.text|slice(0, 120) }}{% if r.text|length > 120 %}…{% endif %}
                    </td>
                    <td style="font-size:12px;color:#6b7280;">{{ r.relativeTime ?? '—' }}</td>
                    <td>
                        <form method="post" action="{{ path('admin_google_review_toggle', {id: r.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_google_review_' ~ r.id) }}">
                            <button type="submit" class="btn btn-sm {{ r.isActive ? 'btn-success' : 'btn-secondary' }}">
                                {% if r.isActive %}<i class="fas fa-check"></i>{% else %}<i class="fas fa-times"></i>{% endif %}
                            </button>
                        </form>
                    </td>
                    <td>
                        <a href="{{ path('admin_google_review_edit', {id: r.id}) }}" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Éditer
                        </a>
                        <form method="post" action="{{ path('admin_google_review_delete', {id: r.id}) }}" style="display:inline;"
                              onsubmit="return confirm('Supprimer cet avis ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_google_review_' ~ r.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted" style="padding:30px;">
                    Aucun avis enregistré. Ajoutez-en un via le formulaire ci-dessus.
                </td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div style="margin-top:16px;text-align:center;">
    <a href="{{ path('home') }}#reviews" target="_blank" class="btn-admin-back" style="display:inline-flex;align-items:center;gap:7px;">
        <i class="fas fa-external-link-alt mr-1"></i> Voir le rendu sur la page d'accueil
    </a>
</div>
{% endblock %}
