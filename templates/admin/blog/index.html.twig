{% extends 'admin/layout.html.twig' %}
{% set active_section = 'blog' %}

{% block admin_content %}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
    <div>
        <div class="admin-page-title">Le Blog — Conseils &amp; Actualités</div>
        <div class="admin-page-subtitle">Articles du blog — visibles sur <a href="{{ path('blog_index') }}" target="_blank">/blog</a> une fois publiés.</div>
    </div>
    <a href="{{ path('admin_blog_new') }}" class="btn-admin-submit" style="text-decoration:none;">
        <i class="fas fa-plus mr-1"></i> Nouvel article
    </a>
</div>

{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle mr-2"></i> {{ message }}
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
{% endfor %}
{% for message in app.flashes('warning') %}
    <div class="alert alert-warning alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle mr-2"></i> {{ message }}
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
{% endfor %}

<div class="admin-card">
    <h3><i class="fas fa-newspaper"></i> Articles
        <span style="font-weight:400;color:#adb5bd;">({{ countAll|default(posts|length) }})</span>
    </h3>

    {# Onglets par statut #}
    <div class="filter-tabs">
        <a href="{{ path('admin_blog_index') }}" style="text-decoration:none;"
           class="filter-tab {{ currentStatut|default(null) is null ? 'active' : '' }}">
            Tous <span class="tab-count">{{ countAll|default(0) }}</span>
        </a>
        <a href="{{ path('admin_blog_index', {statut: 'publies'}) }}" style="text-decoration:none;"
           class="filter-tab {{ currentStatut|default(null) == 'publies' ? 'active' : '' }}">
            En ligne <span class="tab-count">{{ countPublies|default(0) }}</span>
        </a>
        <a href="{{ path('admin_blog_index', {statut: 'brouillons'}) }}" style="text-decoration:none;"
           class="filter-tab {{ currentStatut|default(null) == 'brouillons' ? 'active' : '' }}">
            Brouillons <span class="tab-count">{{ countBrouillons|default(0) }}</span>
        </a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Titre</th>
                <th>Thème</th>
                <th>Statut</th>
                <th>Publié le</th>
                <th>Source</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for post in posts %}
                <tr>
                    <td>
                        {% if post.image %}
                            <img src="{{ asset('uploads/images/' ~ post.image) }}" width="46" height="46"
                                 style="border-radius:8px;object-fit:cover;">
                        {% else %}
                            <div style="width:46px;height:46px;background:#f0f2f5;border-radius:8px;
                                        display:flex;align-items:center;justify-content:center;">
                                <i class="fas fa-newspaper" style="color:#dee2e6;"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td>
                        <strong>{{ post.title }}</strong>
                        <div style="font-size:11.5px;color:#adb5bd;">/blog/{{ post.slug }}</div>
                    </td>
                    <td>{{ post.topicLabel ?? '—' }}</td>
                    <td>
                        {% if post.isPublished %}
                            <span style="background:#dcfce7;color:#15803d;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;">En ligne</span>
                        {% else %}
                            <span style="background:#fef3c7;color:#92400e;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;">Brouillon</span>
                        {% endif %}
                    </td>
                    <td>{{ post.publishedAt ? post.publishedAt|date('d/m/Y') : '—' }}</td>
                    <td>
                        {% if post.source %}
                            <span title="Déposé via l'API de brouillons"
                                  style="background:#ede9fe;color:#6d28d9;font-size:11px;font-weight:600;padding:3px 10px;border-radius:20px;">
                                <i class="fas fa-robot" style="font-size:10px;"></i> {{ post.source }}
                            </span>
                        {% else %}—{% endif %}
                    </td>
                    <td style="white-space:nowrap;">
                        <a href="{{ path('admin_blog_preview', {id: post.id}) }}" target="_blank"
                           class="btn btn-sm btn-outline-secondary" title="Voir l'article tel qu'il apparaîtra sur le site">
                            <i class="fas fa-eye"></i> Aperçu
                        </a>
                        <a href="{{ path('admin_blog_edit', {id: post.id}) }}" class="btn btn-sm btn-warning">Éditer</a>
                        <form method="post" action="{{ path('admin_blog_delete', {id: post.id}) }}" style="display:inline;"
                              onsubmit="return confirm('Supprimer cet article ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-blog-' ~ post.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">
                    Aucun article pour le moment — cliquez sur « Nouvel article » pour écrire le premier.
                </td></tr>
            {% endfor %}
        </tbody>
    </table>

    {# Pagination #}
    {% if totalPages|default(1) > 1 %}
        <div style="display:flex;justify-content:center;gap:6px;margin-top:14px;flex-wrap:wrap;">
            {% for p in 1..totalPages %}
                {% if p == currentPage %}
                    <span class="btn btn-sm" style="background:rgb(9,71,113);color:#fff;min-width:36px;">{{ p }}</span>
                {% else %}
                    <a href="{{ path('admin_blog_index', currentStatut ? {statut: currentStatut, page: p} : {page: p}) }}"
                       class="btn btn-sm btn-outline-secondary" style="min-width:36px;">{{ p }}</a>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</div>

{# ── Encart : connecter un agent IA ── #}
<div class="admin-card" style="margin-top:22px;">
    <h3><i class="fas fa-robot"></i> Connecter un agent IA (dépôt de brouillons)</h3>
    <p style="font-size:13.5px;color:#6c757d;line-height:1.6;">
        Un agent IA (assistant, script, automatisation…) peut déposer des articles via l'API.
        Ils arrivent <strong>toujours en brouillon</strong> : rien n'est publié sans votre relecture.
    </p>
    <div style="background:#f8f9fb;border:1px solid #e9edf2;border-radius:10px;padding:14px 16px;font-size:12.5px;">
        <div style="margin-bottom:8px;"><strong>Adresse :</strong> <code>POST {{ absolute_url(path('api_blog_draft_create')) }}</code></div>
        <div style="margin-bottom:8px;"><strong>En-tête :</strong> <code>X-Blog-Token: {{ apiToken }}</code></div>
        <div><strong>Corps JSON :</strong>
            <code>{"title": "…", "content": "…", "excerpt": "…", "topic": "reparation", "seo_title": "…", "meta_description": "…", "source": "mon-agent"}</code>
        </div>
    </div>
    <p style="font-size:12px;color:#adb5bd;margin-top:10px;margin-bottom:0;">
        <i class="fas fa-shield-alt mr-1"></i> Gardez ce jeton secret — il se change dans Admin &gt; Paramètres (videz le champ pour en régénérer un).
        Thèmes acceptés : <code>reparation, telephones, pc, gaming, batteries, securite, occasion, local, tendances</code>.
    </p>

    {# ── Le prompt de l'agent : éditable + copiable avec le jeton inséré ── #}
    <hr style="margin:20px 0;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:10px;">
        <div>
            <strong style="font-size:14px;color:#1b2e45;"><i class="fas fa-scroll mr-1"></i> Le prompt de l'agent</strong>
            <div style="font-size:12px;color:#adb5bd;">Les instructions à donner à votre agent IA. Modifiez, enregistrez, puis copiez-collez dans l'agent.</div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="copierPromptAgent(this)">
            <i class="fas fa-copy mr-1"></i> Copier le prompt (jeton inclus)
        </button>
    </div>
    <form method="post" action="{{ path('admin_blog_prompt_save') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('blog-prompt') }}">
        <textarea id="agent-prompt-text" name="prompt" rows="14"
                  style="width:100%;font-family:ui-monospace,Menlo,monospace;font-size:12px;line-height:1.55;border:1px solid #e9edf2;border-radius:10px;padding:12px 14px;background:#fbfcfe;">{{ agentPrompt }}</textarea>
        <button type="submit" class="btn-admin-submit" style="margin-top:10px;">
            <i class="fas fa-save mr-1"></i> Enregistrer le prompt
        </button>
    </form>
    <script>
    function copierPromptAgent(btn) {
        var texte = document.getElementById('agent-prompt-text').value
            .replaceAll('{{ '{{TOKEN}}' }}', {{ apiToken|json_encode|raw }});
        navigator.clipboard.writeText(texte).then(function() {
            btn.innerHTML = '<i class="fas fa-check mr-1"></i> Copié !';
            setTimeout(function() {
                btn.innerHTML = '<i class="fas fa-copy mr-1"></i> Copier le prompt (jeton inclus)';
            }, 2000);
        });
    }
    </script>
</div>

{% endblock %}
