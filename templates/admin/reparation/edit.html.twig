{% extends 'admin/layout.html.twig' %}
{% set active_section = 'reparations' %}

{% block admin_content %}
<div class="breadcrumb-admin">
    <a href="{{ path('admin_index') }}">Dashboard</a> › Réparations › Éditer
</div>

<div class="admin-card">
    <h3><i class="fas fa-tools"></i> Éditer la Réparation : {{ reparation.name }}</h3>

    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-4">{{ form_row(form.name) }}</div>
            <div class="col-md-4">{{ form_row(form.model) }}</div>
            <div class="col-md-4">{{ form_row(form.prix) }}</div>
        </div>
        {{ form_row(form.description) }}
        <button type="submit" class="btn-admin-submit">
            <i class="fas fa-save mr-1"></i> Sauvegarder
        </button>
        <a href="{{ path('admin_index') }}" class="btn-admin-back">
            <i class="fas fa-arrow-left mr-1"></i> Retour
        </a>
    {{ form_end(form) }}
</div>
{% endblock %}
