                <th>Catégorie</th>
                <th>Lien</th>
                <th style="width:80px;">Actif</th>
                <th style="width:220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for p in partenaires|filter(p => p.type == 'normal') %}
                <tr>
