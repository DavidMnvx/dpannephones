                            <button type="submit" class="btn btn-sm {{ p.isActive ? 'btn-success' : 'btn-secondary' }}">
                                {% if p.isActive %}<i class="fas fa-check"></i>{% else %}<i class="fas fa-times"></i>{% endif %}
                            </button>
                        </form>
                    </td>
                    <td>
                        <a href="{{ path('admin_partenaire_edit', {id: p.id}) }}" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Éditer
                        </a>
                        <form method="post" action="{{ path('admin_partenaire_delete', {id: p.id}) }}" style="display:inline;"
