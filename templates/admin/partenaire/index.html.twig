                            <input type="hidden" name="_token" value="{{ csrf_token('delete_partenaire_' ~ p.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted">Aucun partenaire Normal.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div style="margin-top:20px;text-align:center;">
    <a href="{{ path('partenaires_index') }}" target="_blank" class="btn-admin-back" style="display:inline-flex;align-items:center;gap:7px;">
        <i class="fas fa-external-link-alt mr-1"></i> Voir la page publique /partenaires
    </a>
</div>

{% endblock %}
