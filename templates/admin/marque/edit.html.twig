{% extends 'admin/layout.html.twig' %}
{% set active_section = 'marques' %}

{% block admin_content %}
<div class="breadcrumb-admin">
    <a href="{{ path('admin_index') }}">Dashboard</a> › Marques › Éditer
</div>

<div class="admin-card">
    <h3><i class="fas fa-tags"></i> Éditer la Marque : {{ marque.name }}</h3>

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
        <div class="row">
            <div class="col-md-6">{{ form_row(form.name) }}</div>
            <div class="col-md-6">{{ form_row(form.image) }}</div>
        </div>
        {% if marque.image %}
            <div class="mb-3">
                <label class="d-block">Image actuelle :</label>
                <img src="{{ asset('uploads/images/' ~ marque.image) }}" alt="{{ marque.name }}" height="60" style="border-radius:8px;">
            </div>
        {% endif %}
        <div class="row">
            <div class="col-md-3">{{ form_row(form.hasPhone) }}</div>
            <div class="col-md-3">{{ form_row(form.hasTablet) }}</div>
        </div>
        <button type="submit" class="btn-admin-submit">
            <i class="fas fa-save mr-1"></i> Sauvegarder
        </button>
        <a href="{{ path('admin_index') }}" class="btn-admin-back">
            <i class="fas fa-arrow-left mr-1"></i> Retour
        </a>
    {{ form_end(form) }}
</div>
{% endblock %}
