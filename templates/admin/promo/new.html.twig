{% extends 'admin/layout.html.twig' %}
{% set active_section = 'promos' %}
{% block title %}Nouveau code promo — Admin{% endblock %}

{% block admin_content %}
<div class="breadcrumb-admin">
    <a href="{{ path('admin_index') }}">Dashboard</a> ›
    <a href="{{ path('admin_promos') }}">Codes promo</a> ›
    Nouveau
</div>

<div style="margin-bottom:20px;">
    <a href="{{ path('admin_promos') }}" style="font-size:13px;color:#6c757d;text-decoration:none;">
        <i class="fas fa-arrow-left mr-1"></i> Retour à la liste
    </a>
</div>

<div class="admin-page-title">Créer un code promo</div>

<div class="admin-card">
    <h3><i class="fas fa-ticket-alt" style="color:#16a34a;"></i> Nouveau code</h3>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle mr-2"></i>{{ message }}
        </div>
    {% endfor %}

    {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}

        <div class="form-section-title">Identifiant</div>
        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.code) }}
            </div>
        </div>

        <hr class="section-divider">

        <div class="form-section-title">Type et valeur</div>
        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.type) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.value) }}
            </div>
        </div>

        <hr class="section-divider">

        <div class="form-section-title">Conditions d'utilisation (optionnelles)</div>
        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.minCartAmount) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.usageLimit) }}
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.validFrom) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.validUntil) }}
            </div>
        </div>

        <hr class="section-divider">

        <div class="form-section-title">Activation & note interne</div>
        <div class="row">
            <div class="col-md-4" style="display:flex;align-items:center;padding-top:28px;">
                {{ form_row(form.isActive) }}
            </div>
            <div class="col-md-8">
                {{ form_row(form.description) }}
            </div>
        </div>

        <div style="margin-top:28px;">
            <button type="submit" class="btn-admin-submit">
                <i class="fas fa-save mr-1"></i> Créer le code promo
            </button>
            <a href="{{ path('admin_promos') }}" class="btn-admin-back">
                <i class="fas fa-arrow-left mr-1"></i> Annuler
            </a>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
