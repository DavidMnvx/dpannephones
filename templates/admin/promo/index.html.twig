{% extends 'admin/layout.html.twig' %}
{% set active_section = 'promos' %}
{% block title %}Codes promo — Admin{% endblock %}

{% block admin_content %}
<div class="breadcrumb-admin">
    <a href="{{ path('admin_index') }}">Dashboard</a> › Codes promo
</div>

<div class="admin-welcome">
    <div>
        <h2><i class="fas fa-ticket-alt mr-2" style="color:#16a34a;"></i>Codes promo</h2>
        <p>Créez et gérez les codes de réduction utilisables par vos clients au moment du paiement.</p>
    </div>
    <div class="admin-stats">
        <div class="stat-box">
            <span class="stat-number">{{ promos|length }}</span>
            <span class="stat-label">Code{{ promos|length > 1 ? 's' : '' }}</span>
        </div>
        <div class="stat-box">
            <span class="stat-number">{{ promos|filter(p => p.isActive)|length }}</span>
            <span class="stat-label">Actif{{ promos|filter(p => p.isActive)|length > 1 ? 's' : '' }}</span>
        </div>
    </div>
</div>

{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> {{ message }}
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> {{ message }}
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
{% endfor %}

<div style="margin-bottom:20px;">
    <a href="{{ path('admin_promo_new') }}" class="btn-admin-submit">
        <i class="fas fa-plus mr-1"></i> Nouveau code promo
    </a>
</div>

{% if promos is empty %}
    <div class="admin-card" style="text-align:center;padding:50px 30px;">
        <i class="fas fa-ticket-alt" style="font-size:48px;color:#cbd5e1;margin-bottom:16px;"></i>
        <h3 style="font-size:18px;color:#6b7280;">Aucun code promo</h3>
        <p style="color:#9ca3af;font-size:13px;">Créez votre premier code promo pour offrir des réductions à vos clients.</p>
    </div>
{% else %}
    <div class="admin-card">
        <table class="table table-hover" style="margin-bottom:0;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Code</th>
                    <th style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Remise</th>
                    <th style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Min. panier</th>
                    <th style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Utilisations</th>
                    <th style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Validité</th>
                    <th style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;">Statut</th>
                    <th style="font-size:12px;text-transform:uppercase;letter-spacing:0.05em;color:#64748b;text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for p in promos %}
                <tr>
                    <td>
                        <code style="background:#eef2ff;color:#4338ca;padding:5px 10px;border-radius:6px;font-weight:700;font-size:13px;">
                            {{ p.code }}
                        </code>
                        {% if p.description %}
                            <div style="font-size:11.5px;color:#9ca3af;margin-top:4px;max-width:260px;">{{ p.description }}</div>
                        {% endif %}
                    </td>
                    <td>
                        <span style="font-weight:700;color:{{ p.type == 'percentage' ? '#16a34a' : '#dc2626' }};font-size:14px;">
                            {{ p.displayValue }}
                        </span>
                        <div style="font-size:11px;color:#9ca3af;">{{ p.type == 'percentage' ? 'Pourcentage' : 'Montant fixe' }}</div>
                    </td>
                    <td style="font-size:13px;color:#475569;">
                        {% if p.minCartAmount %}
                            {{ p.minCartAmount|number_format(2, ',', ' ') }} €
                        {% else %}
                            <span style="color:#cbd5e1;">—</span>
                        {% endif %}
                    </td>
                    <td style="font-size:13px;color:#475569;">
                        <strong>{{ p.usageCount }}</strong>
                        {% if p.usageLimit %}
                            / {{ p.usageLimit }}
                            {% set ratio = (p.usageCount / p.usageLimit) * 100 %}
                            <div style="width:80px;height:4px;background:#e5e7eb;border-radius:2px;margin-top:4px;">
                                <div style="width:{{ ratio }}%;height:100%;background:{{ ratio >= 90 ? '#dc2626' : (ratio >= 60 ? '#f59e0b' : '#16a34a') }};border-radius:2px;"></div>
                            </div>
                        {% else %}
                            <span style="color:#cbd5e1;font-size:11px;"> / illimité</span>
                        {% endif %}
                    </td>
                    <td style="font-size:12.5px;color:#475569;">
                        {% if p.validFrom or p.validUntil %}
                            {% if p.validFrom %}Du {{ p.validFrom|date('d/m/Y') }}<br>{% endif %}
                            {% if p.validUntil %}Au {{ p.validUntil|date('d/m/Y') }}{% endif %}
                        {% else %}
                            <span style="color:#cbd5e1;">Pas de limite</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if p.isCurrentlyValid %}
                            <span class="badge" style="background:#dcfce7;color:#15803d;padding:4px 10px;border-radius:12px;font-size:11.5px;font-weight:700;">
                                <i class="fas fa-check-circle mr-1"></i>Actif
                            </span>
                        {% elseif not p.isActive %}
                            <span class="badge" style="background:#f3f4f6;color:#6b7280;padding:4px 10px;border-radius:12px;font-size:11.5px;font-weight:700;">
                                <i class="fas fa-pause-circle mr-1"></i>Désactivé
                            </span>
                        {% else %}
                            <span class="badge" style="background:#fef3c7;color:#b45309;padding:4px 10px;border-radius:12px;font-size:11.5px;font-weight:700;">
                                <i class="fas fa-exclamation-circle mr-1"></i>Expiré/Limité
                            </span>
                        {% endif %}
                    </td>
                    <td style="text-align:right;white-space:nowrap;">
                        <a href="{{ path('admin_promo_edit', {id: p.id}) }}" class="btn btn-sm btn-outline-primary" style="margin-right:6px;">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form method="post" action="{{ path('admin_promo_toggle', {id: p.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_promo_' ~ p.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-{{ p.isActive ? 'warning' : 'success' }}" title="{{ p.isActive ? 'Désactiver' : 'Activer' }}" style="margin-right:6px;">
                                <i class="fas fa-{{ p.isActive ? 'pause' : 'play' }}"></i>
                            </button>
                        </form>
                        <form method="post" action="{{ path('admin_promo_delete', {id: p.id}) }}" style="display:inline;"
                              onsubmit="return confirm('Supprimer définitivement le code « {{ p.code }} » ? Les commandes existantes qui l\'ont utilisé garderont la trace du code.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_promo_' ~ p.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

<div style="background:#eff6fb;border-left:3px solid rgb(9,71,113);padding:14px 18px;border-radius:10px;margin-top:24px;">
    <div style="font-size:13px;font-weight:700;color:rgb(9,71,113);margin-bottom:4px;">
        <i class="fas fa-lightbulb mr-1"></i>Comment ça marche
    </div>
    <ul style="font-size:12.5px;color:#475569;margin:0;padding-left:20px;line-height:1.7;">
        <li>Le client saisit le code dans la page <strong>Panier</strong> avant de passer commande.</li>
        <li>La remise est appliquée <strong>avant la livraison</strong> — la livraison reste au tarif normal.</li>
        <li>Le compteur d'utilisations s'incrémente uniquement <strong>après paiement confirmé</strong> (pas sur panier abandonné).</li>
        <li>Vous pouvez <strong>désactiver temporairement</strong> un code sans le supprimer (bouton pause).</li>
        <li>Les commandes passées avec un code gardent <strong>la trace du code utilisé</strong>, même si vous le supprimez.</li>
    </ul>
</div>

{% endblock %}
