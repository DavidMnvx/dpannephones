{% extends 'admin/layout.html.twig' %}
{% set active_section = 'colors' %}

{% block admin_content %}

<style>
    .color-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 12px;
        margin-top: 8px;
    }
    .color-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: #f9fafc;
        border: 1px solid #e5e8ec;
        border-radius: 10px;
    }
    .color-swatch {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        border: 1px solid rgba(0,0,0,0.08);
        flex-shrink: 0;
    }
    .color-info { flex: 1; min-width: 0; }
    .color-name { font-weight: 600; color: #1a2b4b; }
    .color-hex  { font-size: 12px; color: #7d8896; font-family: monospace; }
    .color-delete-form { margin: 0; }
    .add-color-form {
        display: flex;
        gap: 10px;
        align-items: flex-end;
        flex-wrap: wrap;
        padding: 18px;
        background: linear-gradient(135deg, #f8fafd, #eef2f7);
        border: 1px solid #dde3ea;
        border-radius: 12px;
        margin-bottom: 24px;
    }
    .add-color-form > div { flex: 1; min-width: 160px; }
    .add-color-form input[type="text"] { min-height: 44px !important; }
    .add-color-form input[type="color"] {
        width: 60px !important; height: 44px !important;
        border-radius: 8px !important; border: 1.5px solid #dde3ea !important;
        padding: 4px !important; cursor: pointer;
    }
</style>

<div class="admin-page-title">Couleurs des articles</div>
<div class="admin-page-subtitle" style="margin-bottom:24px;">
    Palette réutilisable pour les accessoires (coques, câbles, etc.).
</div>

{% for message in app.flashes('success') %}
    <div class="alert alert-success">{{ message }}</div>
{% endfor %}
{% for message in app.flashes('warning') %}
    <div class="alert alert-warning">{{ message }}</div>
{% endfor %}

<div class="admin-card">
    <h3><i class="fas fa-palette"></i> Ajouter une couleur</h3>
    <form method="post" action="{{ path('admin_colors_new') }}" class="add-color-form">
        <div>
            <label for="new-color-name">Nom</label>
            <input type="text" id="new-color-name" name="name" placeholder="Ex. Bleu ciel, Rose pastel…" required>
        </div>
        <div style="flex:0 0 auto;">
            <label for="new-color-hex">Code</label>
            <input type="color" id="new-color-hex-picker" value="#3B82F6" oninput="document.getElementById('new-color-hex').value = this.value.toUpperCase();">
        </div>
        <div style="flex:0 0 130px;">
            <label for="new-color-hex-text">Hex</label>
            <input type="text" id="new-color-hex" name="hex" pattern="^#[0-9a-fA-F]{6}$" value="#3B82F6" style="font-family:monospace;text-transform:uppercase;">
        </div>
        <button type="submit" class="btn-admin-submit">
            <i class="fas fa-plus mr-1"></i> Ajouter
        </button>
    </form>
</div>

<div class="admin-card">
    <h3><i class="fas fa-swatchbook"></i> Palette existante ({{ colors|length }})</h3>
    {% if colors is empty %}
        <p class="text-muted">Aucune couleur pour le moment.</p>
    {% else %}
        <div class="color-list">
            {% for c in colors %}
                <div class="color-item">
                    <div class="color-swatch" style="background: {{ c.hex }};"></div>
                    <div class="color-info">
                        <div class="color-name">{{ c.name }}</div>
                        <div class="color-hex">{{ c.hex }}</div>
                    </div>
                    <form method="post" action="{{ path('admin_colors_delete', {id: c.id}) }}"
                          onsubmit="return confirm('Supprimer la couleur {{ c.name }} ?');"
                          class="color-delete-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-color-' ~ c.id) }}">
                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<script>
document.getElementById('new-color-hex').addEventListener('input', function() {
    if (/^#[0-9a-fA-F]{6}$/.test(this.value)) {
        document.getElementById('new-color-hex-picker').value = this.value;
    }
});
</script>

{% endblock %}
