{% extends 'admin/layout.html.twig' %}
{% set active_section = 'site_images' %}
{% block title %}Modifier {{ siteImage.label }} — Admin{% endblock %}

{% block admin_content %}
<div class="breadcrumb-admin">
    <a href="{{ path('admin_index') }}">Dashboard</a> ›
    <a href="{{ path('admin_site_images') }}">Images du site</a> ›
    Modifier
</div>

<div class="admin-card">
    <h3><i class="fas fa-upload"></i> Modifier : {{ siteImage.label }}</h3>

    {% if siteImage.description %}
        <p style="color:#64748b;font-size:13px;margin-bottom:20px;">{{ siteImage.description }}</p>
    {% endif %}

    <div class="row">
        {# Aperçu image actuelle #}
        <div class="col-md-6 mb-4">
            <div class="form-section-title">Image actuelle</div>
            <div style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;padding:16px;text-align:center;">
                {% if siteImage.webPath %}
                    <img src="{{ asset(siteImage.webPath) }}" alt="{{ siteImage.label }}"
                         style="max-width:100%;max-height:260px;border-radius:8px;">
                {% else %}
                    <div style="padding:60px 20px;color:#cbd5e1;">
                        <i class="fas fa-image" style="font-size:42px;"></i>
                        <p style="margin:10px 0 0;font-size:13px;">Aucune image</p>
                    </div>
                {% endif %}
                <div style="font-size:11px;color:#9ca3af;margin-top:10px;font-family:monospace;">
                    {% if siteImage.image %}
                        📷 Personnalisée : {{ siteImage.image }}
                    {% elseif siteImage.defaultImage %}
                        🎨 Par défaut : {{ siteImage.defaultImage }}
                    {% endif %}
                </div>
            </div>
        </div>

        {# Formulaire upload #}
        <div class="col-md-6 mb-4">
            <div class="form-section-title">Uploader une nouvelle image</div>
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'admin-form'}}) }}
                {{ form_row(form.image) }}

                <div style="background:#fffbeb;border-left:3px solid #f59e0b;padding:12px 16px;border-radius:8px;margin:16px 0;font-size:12.5px;color:#78350f;line-height:1.6;">
                    <strong><i class="fas fa-info-circle mr-1"></i>Conseils :</strong><br>
                    • Format recommandé : <strong>JPG</strong> ou <strong>WEBP</strong><br>
                    • Dimensions : minimum <strong>800×600 px</strong><br>
                    • Poids max : <strong>6 Mo</strong><br>
                    • La nouvelle photo s'affichera immédiatement sur le site
                </div>

                <div>
                    <button type="submit" class="btn-admin-submit">
                        <i class="fas fa-upload mr-1"></i> Uploader et remplacer
                    </button>
                    <a href="{{ path('admin_site_images') }}" class="btn-admin-back">
                        <i class="fas fa-arrow-left mr-1"></i> Annuler
                    </a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
