{% extends 'admin/layout.html.twig' %}
{% set active_section = 'popular_phones' %}

{% block admin_content %}

<style>
    .ppm-add-form {
        display: grid;
        grid-template-columns: 1fr 1.5fr 1fr auto;
        gap: 10px;
        align-items: end;
        padding: 18px;
        background: linear-gradient(135deg, #f8fafd, #eef2f7);
        border: 1px solid #dde3ea;
        border-radius: 12px;
        margin-bottom: 24px;
    }
    @media (max-width: 700px) {
        .ppm-add-form { grid-template-columns: 1fr; }
    }
    .ppm-brand-card {
        background: white;
        border: 1px solid #edf0f3;
        border-radius: 12px;
        padding: 16px 18px;
        margin-bottom: 12px;
    }
    .ppm-brand-name {
        font-size: 16px; font-weight: 700; color: #094771;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid #edf0f3;
        display: flex; align-items: center; justify-content: space-between;
    }
    .ppm-family {
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.06em;
        color: #7d8896; margin: 12px 0 6px;
    }
    .ppm-model-list {
        display: flex; flex-wrap: wrap; gap: 6px;
    }
    .ppm-model-chip {
        display: inline-flex; align-items: center; gap: 6px;
        background: #f5f7fa; border: 1px solid #dde3ea;
        padding: 4px 6px 4px 10px; border-radius: 6px;
        font-size: 13px; color: #1a2b4b;
    }
    .ppm-model-chip form { margin: 0; }
    .ppm-model-chip button {
        background: transparent; border: none;
        color: #7d8896; cursor: pointer;
        padding: 2px 4px; font-size: 11px;
    }
    .ppm-model-chip button:hover { color: #dc2626; }
    .ppm-badge-count {
        font-size: 12px; font-weight: 600; color: #7d8896;
        background: #f5f7fa; padding: 2px 10px; border-radius: 10px;
    }
</style>

<div class="admin-page-title">Téléphones populaires</div>
<div class="admin-page-subtitle" style="margin-bottom:24px;">
    Catalogue utilisé par le picker "Modèles compatibles" des coques et films hydrogel.
    Séparé de la table Modèles (réparations).
</div>

{% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
{% for message in app.flashes('warning') %}<div class="alert alert-warning">{{ message }}</div>{% endfor %}

<div class="admin-card">
    <h3><i class="fas fa-plus"></i> Ajouter un modèle</h3>
    <form method="post" action="{{ path('admin_popular_phones_new') }}" class="ppm-add-form">
        <div>
            <label>Marque</label>
            <input type="text" name="brand" placeholder="Ex. Apple, Samsung, Xiaomi…" required>
        </div>
        <div>
            <label>Modèle</label>
            <input type="text" name="model_name" placeholder="Ex. iPhone 16 Pro, Galaxy S25 Ultra…" required>
        </div>
        <div>
            <label>Série (optionnel)</label>
            <input type="text" name="famille" placeholder="Ex. Série S, Redmi Note, Foldable…">
        </div>
        <button type="submit" class="btn-admin-submit">
            <i class="fas fa-plus mr-1"></i> Ajouter
        </button>
    </form>
</div>

{% if grouped is empty %}
    <div class="admin-card">
        <p class="text-muted">Aucun modèle enregistré. Utilise le formulaire ci-dessus pour en ajouter.</p>
    </div>
{% else %}
    {% for brand, data in grouped %}
        {% set totalCount = 0 %}
        {% for models in data.families %}{% set totalCount = totalCount + models|length %}{% endfor %}

        <div class="ppm-brand-card">
            <div class="ppm-brand-name">
                <span>{{ brand }}</span>
                <span class="ppm-badge-count">{{ totalCount }} modèle{{ totalCount > 1 ? 's' : '' }}</span>
            </div>
            {% for famille, models in data.families %}
                {% if data.families|length > 1 or famille != 'Autres' %}
                    <div class="ppm-family">{{ famille }}</div>
                {% endif %}
                <div class="ppm-model-list">
                    {% for m in models %}
                        <span class="ppm-model-chip">
                            {{ m.modelName }}
                            <form method="post" action="{{ path('admin_popular_phones_delete', {id: m.id}) }}"
                                  onsubmit="return confirm('Supprimer {{ m.modelName|e('js') }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-ppm-' ~ m.id) }}">
                                <button type="submit" title="Supprimer"><i class="fas fa-times"></i></button>
                            </form>
                        </span>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endif %}

{% endblock %}
