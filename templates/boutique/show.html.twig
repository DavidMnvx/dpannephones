{% extends 'base.html.twig' %}

{% block title %}{{ article.name }} — D'panne Phones{% endblock %}

{# ── JSON-LD Product (pour rich snippets Google Search) ── #}
{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "{{ article.name|e('js') }}",
  "description": "{{ article.description|e('js') }}",
  {% if article.image %}"image": "{{ absolute_url(asset('uploads/images/' ~ article.image)) }}",{% endif %}
  {% if article.categorie %}"category": "{{ article.categorie|replace({'_': ' '})|capitalize|e('js') }}",{% endif %}
  "brand": {
    "@type": "Brand",
    "name": "{{ (article.specs.brand ?? "D'Panne Phones")|e('js') }}"
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ absolute_url(path('boutique_show', {id: article.id})) }}",
    "priceCurrency": "EUR",
    "price": "{{ article.price|number_format(2, '.', '') }}",
    "availability": "https://schema.org/InStock",
    "itemCondition": "{{ article.isNew ? 'https://schema.org/NewCondition' : 'https://schema.org/RefurbishedCondition' }}",
    "seller": {
      "@type": "Organization",
      "name": "D'Panne Phones"
    }
  }
  {% if articleAvgRating and articleReviews|length > 0 %}
  ,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ articleAvgRating }}",
    "reviewCount": "{{ articleReviews|length }}",
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": [
    {% for review in articleReviews|slice(0, 5) %}
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "{{ review.displayName|e('js') }}" },
      "datePublished": "{{ (review.publishedAt ?? review.createdAt)|date('Y-m-d') }}",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{{ review.rating }}",
        "bestRating": "5"
      },
      "reviewBody": "{{ review.comment|e('js') }}"
    }{{ not loop.last ? ',' : '' }}
    {% endfor %}
  ]
  {% endif %}
}
</script>
{% endblock %}

{% block body %}

{# Bannière #}
<div id="carouselExampleIndicators2" class="carousel slide mb-4" data-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset(site_image('banner_boutique', 'images/baner/Boutique.png')) }}" alt="Boutique">
            <div class="carousel-caption">
                <h5 id="uneRep">Notre Boutique</h5>
            </div>
        </div>
    </div>
</div>

<div style="width:90%;max-width:1200px;margin:0 auto 60px;padding:0 16px;">

    {# Fil d'Ariane #}
    <nav class="article-breadcrumb">
        <a href="{{ path('home') }}">Accueil</a>
        <span class="bc-sep">›</span>
        <a href="{{ path('boutique_index') }}">Boutique</a>
        {% if article.categorie and categories[article.categorie] is defined %}
            <span class="bc-sep">›</span>
            <a href="{{ path('boutique_index', {categorie: article.categorie}) }}">{{ categories[article.categorie] }}</a>
        {% endif %}
        <span class="bc-sep">›</span>
        <span class="bc-current">{{ article.name }}</span>
    </nav>

    <div class="article-detail-wrap">

        {# ══════════════════════════════════════
           COLONNE GAUCHE — Image + vignettes
           ══════════════════════════════════════ #}
        <div class="article-detail-img-col">

            {# ── Regroupement des photos par couleur ──
               availableColors = [{id, name, hex}, ...] (couleurs distinctes présentes sur les photos)
               photosByColor   = { color_id: [filenames], "none": [filenames sans couleur] }              #}
            {% set availableColors = [] %}
            {% set colorMap = {} %}

            {# Photo principale (article.image) : sa couleur est dans specs.main_photo_color_id #}
            {% set mainColorId = article.specs.main_photo_color_id|default(null) %}
            {% if article.image %}
                {% set key = mainColorId ? mainColorId|number_format : 'none' %}
                {% set arr = colorMap[key]|default([]) %}
                {% set arr = arr|merge([article.image]) %}
                {% set colorMap = colorMap|merge({(key): arr}) %}
            {% endif %}

            {# Photos supplémentaires (article.photos) : chacune peut avoir photo.color #}
            {% for photo in article.photos %}
                {% set cid = photo.color ? photo.color.id : null %}
                {% set key = cid ? cid|number_format : 'none' %}
                {% set arr = colorMap[key]|default([]) %}
                {% set arr = arr|merge([photo.filename]) %}
                {% set colorMap = colorMap|merge({(key): arr}) %}
                {% if photo.color and (availableColors|filter(c => c.id == photo.color.id)|length == 0) %}
                    {% set availableColors = availableColors|merge([{id: photo.color.id, name: photo.color.name, hex: photo.color.hex}]) %}
                {% endif %}
            {% endfor %}

            {# Ajouter la couleur de la photo principale si elle n'y est pas déjà #}
            {% if mainColorId %}
                {% set existsInAvailable = availableColors|filter(c => c.id == mainColorId)|length > 0 %}
                {% if not existsInAvailable %}
                    {% for photo in article.photos %}
                        {% if photo.color and photo.color.id == mainColorId %}
                            {% set availableColors = availableColors|merge([{id: photo.color.id, name: photo.color.name, hex: photo.color.hex}]) %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
            {% endif %}

            {# Image principale #}
            {% if article.image %}
                <div class="article-detail-img-frame">
                    <img id="mainArticleImage" src="{{ asset('uploads/images/' ~ article.image) }}" alt="{{ article.name }}">
                </div>
            {% elseif article.photos|length > 0 %}
                <div class="article-detail-img-frame">
                    <img id="mainArticleImage" src="{{ asset('uploads/images/' ~ article.photos|first.filename) }}" alt="{{ article.name }}">
                </div>
            {% else %}
                <div class="article-detail-no-img">
                    <i class="fas fa-image"></i>
                    <span>Pas d'image disponible</span>
                </div>
            {% endif %}

            {# ── Sélecteur de couleur ── #}
            {% if availableColors|length > 1 %}
                <div class="color-swatches" style="display:flex;gap:10px;margin-top:16px;flex-wrap:wrap;align-items:center;">
                    <strong style="font-size:13px;color:#1a2b4b;">Couleur :</strong>
                    <button type="button" class="color-swatch color-swatch--all active"
                            data-color-id="all" onclick="filterByColor(null, null)"
                            style="padding:5px 12px;border:1.5px solid #094771;background:#094771;color:#fff;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;">
                        Toutes
                    </button>
                    {% for c in availableColors %}
                        <button type="button" class="color-swatch"
                                data-color-id="{{ c.id }}"
                                onclick="filterByColor({{ c.id }}, '{{ c.name|e('js') }}')"
                                title="{{ c.name }}"
                                style="display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border:1.5px solid #dee2e6;background:#fff;color:#1a2b4b;border-radius:20px;font-size:12px;font-weight:600;cursor:pointer;">
                            <span style="width:14px;height:14px;border-radius:50%;background:{{ c.hex }};border:1px solid rgba(0,0,0,0.1);"></span>
                            {{ c.name }}
                        </button>
                    {% endfor %}
                </div>
            {% endif %}

            {# Galerie photos ── vignettes de toutes les photos, filtrées par JS #}
            {% if article.photos|length > 0 or article.image %}
                <div class="article-detail-gallery" id="articleGallery" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;">
                    {% if article.image %}
                        <img src="{{ asset('uploads/images/' ~ article.image) }}"
                             alt="{{ article.name }}"
                             data-color-id="{{ mainColorId ?: '' }}"
                             onclick="document.getElementById('mainArticleImage').src=this.src;"
                             style="width:70px;height:70px;object-fit:cover;border:2px solid #dee2e6;border-radius:6px;cursor:pointer;">
                    {% endif %}
                    {% for photo in article.photos %}
                        <img src="{{ asset('uploads/images/' ~ photo.filename) }}"
                             alt="{{ article.name }}"
                             data-color-id="{{ photo.color ? photo.color.id : '' }}"
                             data-main="{{ photo.isMain ? '1' : '0' }}"
                             onclick="document.getElementById('mainArticleImage').src=this.src;"
                             style="width:70px;height:70px;object-fit:cover;border:2px solid #dee2e6;border-radius:6px;cursor:pointer;">
                    {% endfor %}
                </div>
            {% endif %}

            <script>
            // Couleur sélectionnée globalement — transmise au panier via ?color=<name>
            window.selectedCartColor = null;
            window.selectedCartColorName = null;

            function filterByColor(colorId, colorName) {
                var gallery = document.getElementById('articleGallery');
                var mainImg = document.getElementById('mainArticleImage');
                if (!gallery) return;

                var firstMatch = null;
                var mainMatch  = null; // photo désignée "principale" du coloris
                Array.from(gallery.querySelectorAll('img')).forEach(function(im) {
                    var cid = im.getAttribute('data-color-id');
                    var show = (colorId === null) || (cid && parseInt(cid, 10) === colorId) || (colorId === null && !cid);
                    im.style.display = show ? '' : 'none';
                    if (show && !firstMatch) firstMatch = im;
                    if (show && !mainMatch && im.getAttribute('data-main') === '1') mainMatch = im;
                });
                var best = mainMatch || firstMatch;
                if (mainImg && best) mainImg.src = best.src;

                document.querySelectorAll('.color-swatch').forEach(function(b) {
                    var active = (b.getAttribute('data-color-id') === (colorId === null ? 'all' : String(colorId)));
                    b.style.borderColor = active ? '#094771' : '#dee2e6';
                    b.style.background  = active ? '#094771' : '#fff';
                    b.style.color       = active ? '#fff' : '#1a2b4b';
                });

                // Mémorise la couleur choisie pour l'ajout au panier
                window.selectedCartColor = colorId;
                window.selectedCartColorName = colorName || null;
                syncColorToCartControls();
            }

            // Propage la couleur choisie aux formulaires/liens "Ajouter au panier"
            function syncColorToCartControls() {
                var name = window.selectedCartColorName || '';
                // 1) forms → ajouter/mettre à jour un input hidden name="color"
                document.querySelectorAll('form[action*="cart/add"]').forEach(function(form) {
                    var input = form.querySelector('input[name="color"]');
                    if (!input) {
                        input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'color';
                        form.appendChild(input);
                    }
                    input.value = name;
                });
                // 2) liens directs → ajouter ?color=<name> dynamiquement au clic
                document.querySelectorAll('a[href*="cart/add"]:not([data-color-bound])').forEach(function(a) {
                    a.setAttribute('data-color-bound', '1');
                    a.addEventListener('click', function(e) {
                        var color = window.selectedCartColorName;
                        if (!color) return;
                        var href = a.getAttribute('href');
                        var sep = href.indexOf('?') === -1 ? '?' : '&';
                        a.setAttribute('href', href + sep + 'color=' + encodeURIComponent(color));
                    });
                });
            }
            document.addEventListener('DOMContentLoaded', syncColorToCartControls);
            </script>

            {# Vignettes specs clés — téléphones uniquement #}
            {% if article.categorie == 'telephone' and article.specs %}
                {% set s = article.specs %}
                <div class="spec-vignettes">
                    {% if s.os is defined %}
                        <div class="spec-vignette">
                            <i class="fab fa-{% if 'iOS' in s.os %}apple{% else %}android{% endif %}"></i>
                            <strong>OS</strong>
                            <span>{{ s.os }}</span>
                        </div>
                    {% endif %}
                    {% if s.storage_capacity is defined %}
                        <div class="spec-vignette">
                            <i class="fas fa-hdd"></i>
                            <strong>Stockage</strong>
                            <span>{{ s.storage_capacity }}</span>
                        </div>
                    {% endif %}
                    {% if s.ram is defined %}
                        <div class="spec-vignette">
                            <i class="fas fa-memory"></i>
                            <strong>RAM</strong>
                            <span>{{ s.ram }}</span>
                        </div>
                    {% endif %}
                    {% if s.screen_size is defined %}
                        <div class="spec-vignette">
                            <i class="fas fa-expand-arrows-alt"></i>
                            <strong>Écran</strong>
                            <span>{{ s.screen_size }}</span>
                        </div>
                    {% endif %}
                    {% if s.camera is defined %}
                        <div class="spec-vignette">
                            <i class="fas fa-camera"></i>
                            <strong>Photo</strong>
                            <span>{{ s.camera }}</span>
                        </div>
                    {% endif %}
                    {% if s.battery_capacity is defined %}
                        <div class="spec-vignette">
                            <i class="fas fa-battery-three-quarters"></i>
                            <strong>Batterie</strong>
                            <span>{{ s.battery_capacity }}</span>
                        </div>
                    {% endif %}
                    {% if s.sim is defined %}
                        <div class="spec-vignette">
                            <i class="fas fa-sim-card"></i>
                            <strong>SIM</strong>
                            <span>{{ s.sim }}</span>
                        </div>
                    {% endif %}
                    {% if s.color is defined %}
                        <div class="spec-vignette">
                            <i class="fas fa-palette"></i>
                            <strong>Couleur</strong>
                            <span>{{ s.color }}</span>
                        </div>
                    {% endif %}
                    {% if s.battery_health is defined %}
                        <div class="spec-vignette spec-vignette--{{ s.battery_health >= 85 ? 'good' : (s.battery_health >= 70 ? 'mid' : 'low') }}">
                            <i class="fas fa-heartbeat"></i>
                            <strong>État batterie</strong>
                            <span>{{ s.battery_health }}%</span>
                        </div>
                    {% endif %}
                    {% if article.grade %}
                        <div class="spec-vignette spec-vignette--grade">
                            <i class="fas fa-award"></i>
                            <strong>Grade</strong>
                            <span>Grade {{ article.grade }}</span>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

        </div>

        {# ══════════════════════════════════════
           COLONNE DROITE — Infos + Achat
           ══════════════════════════════════════ #}
        <div class="article-detail-info-col">

            {# Badges état / grade #}
            <div class="article-detail-badges">
                <span class="badge-etat {{ article.isNew ? 'badge-neuf' : 'badge-occasion' }}">
                    {{ article.isNew ? 'Neuf' : "D'occasion" }}
                </span>
                {% if article.grade %}
                    <span class="badge-grade grade-tooltip-wrap" tabindex="0">
                        Grade {{ article.grade }}
                        <span class="grade-tooltip">
                            <strong>Grade A</strong> — Excellent état, traces imperceptibles<br>
                            <strong>Grade B</strong> — Bon état, légères traces d'usage<br>
                            <strong>Grade C</strong> — État correct, traces visibles
                        </span>
                    </span>
                {% endif %}
            </div>

            {# Nom + description (mise en forme auto : titres, listes à puces, paragraphes) #}
            <h1 class="article-detail-name">{{ article.name }}</h1>
            {% if article.description %}
                <div class="article-detail-desc rich-desc">{{ article.description|rich_description }}</div>
            {% endif %}

            {# ── PRIX + PANIER (bloc achat principal) ── #}
            <div class="article-buy-block">
                <div class="article-buy-price">
                    <span class="article-price-amount">{{ article.price|number_format(2, ',', ' ') }} €</span>
                    {% if not article.isNew %}
                        <span class="article-price-hint">TVA incluse · Reconditionné</span>
                    {% else %}
                        <span class="article-price-hint">TVA incluse · Neuf</span>
                    {% endif %}
                </div>

                <div class="article-buy-actions">
                    {% if article.categorie == 'film_hydrogel' %}
                        {# Récupérer les modèles par marque (brand_models) ou liste plate (compatible_models) #}
                        {% set brandModels = article.specs.brand_models ?? {} %}
                        {% set flatModels  = article.specs.compatible_models ?? [] %}

                        {% if brandModels is not empty %}
                            {# Sélecteur marque + modèle avec filtrage JS #}
                            <form method="get" action="{{ path('cart_add', {id: article.id}) }}" class="hydrogel-form" id="hydrogel-form">

                                <label class="hydrogel-label"><i class="fas fa-mobile-alt mr-1"></i> Sélectionnez votre téléphone</label>

                                {# Étape 1 — Marque #}
                                <select id="hydrogel-brand" class="hydrogel-select" onchange="filterHydrogelModels()">
                                    <option value="">— Choisir une marque —</option>
                                    {% for brand, models in brandModels %}
                                        <option value="{{ brand }}">{{ brand }}</option>
                                    {% endfor %}
                                </select>

                                {# Étape 2 — Modèle (filtré par JS) #}
                                <select id="hydrogel-model" name="model" class="hydrogel-select" required disabled>
                                    <option value="">— Choisir d'abord une marque —</option>
                                </select>

                                {# Dataset JSON pour le JS #}
                                <script id="hydrogel-data" type="application/json">{{ brandModels|json_encode|raw }}</script>

                                <button type="submit" class="btn-cart-detail" id="hydrogel-submit" disabled>
                                    <i class="fas fa-shield-alt"></i>
                                    Ajouter le film hydrogel au panier
                                </button>
                            </form>

                            <script>
                            function filterHydrogelModels() {
                                const brand   = document.getElementById('hydrogel-brand').value;
                                const select  = document.getElementById('hydrogel-model');
                                const btn     = document.getElementById('hydrogel-submit');
                                const data    = JSON.parse(document.getElementById('hydrogel-data').textContent);

                                select.innerHTML = '';
                                if (!brand) {
                                    select.add(new Option('— Choisir d\'abord une marque —', ''));
                                    select.disabled = true;
                                    btn.disabled    = true;
                                    return;
                                }
                                select.add(new Option('— Choisir un modèle —', ''));
                                (data[brand] || []).forEach(function(m) {
                                    select.add(new Option(m, m));
                                });
                                select.disabled = false;
                                select.onchange = function() {
                                    btn.disabled = !select.value;
                                };
                            }
                            </script>

                        {% elseif flatModels is not empty %}
                            {# Fallback : liste plate sans marque #}
                            <form method="get" action="{{ path('cart_add', {id: article.id}) }}" class="hydrogel-form">
                                <label class="hydrogel-label"><i class="fas fa-mobile-alt mr-1"></i> Sélectionnez votre modèle</label>
                                <select name="model" class="hydrogel-select" required>
                                    <option value="">— Choisir un modèle compatible —</option>
                                    {% for model in flatModels %}
                                        <option value="{{ model }}">{{ model }}</option>
                                    {% endfor %}
                                </select>
                                <button type="submit" class="btn-cart-detail">
                                    <i class="fas fa-shield-alt"></i>
                                    Ajouter le film hydrogel au panier
                                </button>
                            </form>
                        {% else %}
                            <a href="{{ path('cart_add', {id: article.id}) }}" class="btn-cart-detail">
                                <i class="fas fa-shield-alt"></i> Ajouter au panier
                            </a>
                        {% endif %}

                    {% else %}
                        <a href="{{ path('cart_add', {id: article.id}) }}" class="btn-cart-detail">
                            <i class="fas fa-cart-plus"></i>
                            Ajouter au panier — D'Panne Phones
                        </a>
                    {% endif %}

                    <div class="article-buy-reassurance">
                        <span><i class="fas fa-store mr-1"></i> Retrait en boutique 1–2 jours</span>
                        <span><i class="fas fa-undo-alt mr-1"></i> Retour 14 jours</span>
                        <span><i class="fas fa-lock mr-1"></i> Paiement sécurisé</span>
                    </div>
                </div>
            </div>

            {# ── SPÉCIFICATIONS (Accordion) ── #}
            {% if article.specs %}
                <div class="article-detail-specs">
                    <div class="article-specs-title">
                        <i class="fas fa-list-ul mr-2"></i>Caractéristiques techniques
                    </div>

                    {% if article.categorie == 'telephone' %}
                        {% set s = article.specs %}
                        <div class="specs-accordion" id="specsAccordion" role="tablist">

                            {# Identification #}
                            {% if s.brand is defined or s.model is defined or s.os is defined or s.year is defined %}
                                <div class="specs-accordion-item">
                                    <h2 class="specs-accordion-header" id="heading1" role="tab">
                                        <button class="specs-accordion-button" type="button" data-toggle="collapse" data-target="#collapse1" aria-expanded="true" aria-controls="collapse1">
                                            <i class="fas fa-info-circle mr-2"></i>Identification
                                            <i class="fas fa-chevron-down specs-chevron ml-auto"></i>
                                        </button>
                                    </h2>
                                    <div id="collapse1" class="collapse show specs-accordion-collapse" role="tabpanel" aria-labelledby="heading1" data-parent="#specsAccordion">
                                        <div class="specs-accordion-body">
                                            {% if s.brand is defined %}<div class="article-spec-row"><span class="article-spec-key">Marque</span><span class="article-spec-val">{{ s.brand }}</span></div>{% endif %}
                                            {% if s.model is defined %}<div class="article-spec-row"><span class="article-spec-key">Modèle</span><span class="article-spec-val">{{ s.model }}</span></div>{% endif %}
                                            {% if s.os is defined %}<div class="article-spec-row"><span class="article-spec-key">Système</span><span class="article-spec-val">{{ s.os }}</span></div>{% endif %}
                                            {% if s.year is defined %}<div class="article-spec-row"><span class="article-spec-key">Année</span><span class="article-spec-val">{{ s.year }}</span></div>{% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {# Écran #}
                            {% if s.screen_size is defined or s.screen_type is defined or s.resolution is defined %}
                                <div class="specs-accordion-item">
                                    <h2 class="specs-accordion-header" id="heading2" role="tab">
                                        <button class="specs-accordion-button collapsed" type="button" data-toggle="collapse" data-target="#collapse2" aria-expanded="false" aria-controls="collapse2">
                                            <i class="fas fa-tv mr-2"></i>Écran
                                            <i class="fas fa-chevron-down specs-chevron ml-auto"></i>
                                        </button>
                                    </h2>
                                    <div id="collapse2" class="collapse specs-accordion-collapse" role="tabpanel" aria-labelledby="heading2" data-parent="#specsAccordion">
                                        <div class="specs-accordion-body">
                                            {% if s.screen_size is defined %}<div class="article-spec-row"><span class="article-spec-key">Taille</span><span class="article-spec-val">{{ s.screen_size }}</span></div>{% endif %}
                                            {% if s.screen_type is defined %}<div class="article-spec-row"><span class="article-spec-key">Type</span><span class="article-spec-val">{{ s.screen_type }}</span></div>{% endif %}
                                            {% if s.resolution is defined %}<div class="article-spec-row"><span class="article-spec-key">Résolution</span><span class="article-spec-val">{{ s.resolution }}</span></div>{% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}

                            {# Performances #}
                            {% if s.processor is defined or s.ram is defined or s.storage_capacity is defined %}
                                <div class="specs-accordion-item">
                                    <h2 class="specs-accordion-header" id="heading3" role="tab">
                                        <button class="specs-accordion-button collapsed" type="button" data-toggle="collapse" data-target="#collapse3" aria-expanded="false" aria-controls="collapse3">
                                            <i class="fas fa-tachometer-alt mr-2"></i>Performances
                                            <i class="fas fa-chevron-down specs-chevron ml-auto"></i>
                                        </button>
                                    </h2>
                                    <div id="collapse3" class="collapse specs-accordion-collapse" role="tabpanel" aria-labelledby="heading3" data-parent="#specsAccordion">
                                        <div class="specs-accordion-body">
                                            {% if s.processor is defined %}<div class="article-spec-row"><span class="article-spec-key">Processeur</span><span class="article-spec-val">{{ s.processor }}</span></div>{% endif %}
