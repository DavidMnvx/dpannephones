{# Carte produit boutique.
   Variables attendues :
     - article          : l'Article à afficher
     - currentCategorie : slug de la catégorie affichée (null sur l'accueil)
   Les specs détaillées ne s'affichent que sur la page de la catégorie de l'article. #}
<div class="product-card">
    <a href="{{ path('boutique_show', {id: article.id}) }}" class="product-img-link">
        <div class="product-img-wrap">
            {% if article.image %}
                <img src="{{ asset('uploads/images/' ~ article.image) }}" alt="{{ article.name }}">
            {% else %}
                <i class="fas fa-image no-img"></i>
            {% endif %}
        </div>
    </a>
    <div class="product-body">
        <div class="product-badges">
            <span class="badge-etat {{ article.isNew ? 'badge-neuf' : 'badge-occasion' }}">
                {{ article.isNew ? 'Neuf' : "D'occasion" }}
            </span>
            {% if article.grade %}
                <span class="badge-grade grade-tooltip-wrap" tabindex="0">
                    Grade {{ article.grade }}
                    <span class="grade-tooltip">
                        <strong>Grade A</strong> — Excellent état<br>
                        <strong>Grade B</strong> — Légères traces d'usage<br>
                        <strong>Grade C</strong> — Traces visibles
                    </span>
                </span>
            {% endif %}
        </div>
        <div class="product-name">
            <a href="{{ path('boutique_show', {id: article.id}) }}" class="product-name-link">{{ article.name }}</a>
        </div>
        <p class="product-desc">{{ article.description }}</p>

        {# Specs détaillées uniquement sur la page de la catégorie — cartes compactes sur l'accueil #}
        {% set catTpl = categoryTemplates[article.categorie]|default(article.categorie) %}
        {% if catTpl in ['pc_gamer', 'pc_bureautique', 'pc_portable'] and currentCategorie == article.categorie %}
            {% if article.specs %}
                {# Ordre canonique : chaque carte affiche les mêmes lignes dans le même ordre, à partir d'OS #}
                {% set specLabels = {
                    'os':              'OS',
                    'processeur':      'Processeur',
                    'ram':             'RAM',
                    'stockage':        'Stockage',
                    'carte_graphique': 'Carte graphique',
                    'carte_mere':      'Carte mère',
                    'alimentation':    'Alimentation',
                    'refroidissement': 'Refroidissement',
                    'boitier':         'Boîtier',
                    'eclairage_rgb':   'Éclairage RGB',
                    'garantie':        'Garantie'
                } %}
                {% set hiddenSpecs = ['brand_models', 'compatible_models', 'main_photo_color_id', 'photo_colors'] %}
                <div class="pc-specs-list">
                    {% for key, label in specLabels %}
                        {% if article.specs[key] is defined and article.specs[key] is not iterable and article.specs[key] %}
                            <div class="pc-spec-row">
                                <span class="pc-spec-key">{{ label }}</span>
                                <span class="pc-spec-val">{{ article.specs[key] }}</span>
                            </div>
                        {% endif %}
                    {% endfor %}
                    {% for key, val in article.specs %}
                        {% if specLabels[key] is not defined and key not in hiddenSpecs and val is not iterable %}
                            <div class="pc-spec-row">
                                <span class="pc-spec-key">{{ key|replace({'_': ' '})|capitalize }}</span>
                                <span class="pc-spec-val">{{ val }}</span>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        {% elseif catTpl == 'telephone' %}
            {% if article.specs %}
                <div class="pc-specs-list">
                    {% if article.specs.storage_capacity is defined %}
                        <div class="pc-spec-row">
                            <span class="pc-spec-key">Stockage</span>
                            <span class="pc-spec-val">{{ article.specs.storage_capacity }}</span>
                        </div>
                    {% endif %}
                    {% if article.specs.color is defined %}
                        <div class="pc-spec-row">
                            <span class="pc-spec-key">Couleur</span>
                            <span class="pc-spec-val">{{ article.specs.color }}</span>
                        </div>
                    {% endif %}
                    {% if article.specs.network is defined %}
                        <div class="pc-spec-row">
                            <span class="pc-spec-key">Réseau</span>
                            <span class="pc-spec-val">{{ article.specs.network }}</span>
                        </div>
                    {% endif %}
                    {% if article.specs.battery_health is defined %}
                        <div class="pc-spec-row">
                            <span class="pc-spec-key">Batterie</span>
                            <span class="pc-spec-val">{{ article.specs.battery_health }}%</span>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}

        <div class="product-footer">
            <span class="product-price">{{ article.price }} €</span>

            {% if article.categorie == 'film_hydrogel' %}
                <a href="{{ path('boutique_index', {categorie: 'film_hydrogel'}) }}" class="btn-cart btn-cart--hydrogel">
                    <i class="fas fa-shield-alt"></i> Découvrir
                </a>
            {% elseif article.categorie == 'coque' %}
                <button type="button" class="btn-cart" data-toggle="modal" data-target="#hydrogelModal{{ article.id }}">
                    <i class="fas fa-mobile-alt"></i> Choisir le modèle
                </button>
            {% else %}
                <a href="{{ path('cart_add', {id: article.id}) }}" class="btn-cart">
                    <i class="fas fa-cart-plus"></i> Ajouter
                </a>
            {% endif %}
        </div>
    </div>
</div>
