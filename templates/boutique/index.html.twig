{% extends 'base.html.twig' %}

{% block title %}Boutique — D'panne Phones{% endblock %}

{% block body %}

{# Bannière image classique — uniquement sur l'accueil, en repli quand aucun article n'est à la une.
   Les pages catégorie commencent directement (cohérence de navigation). #}
{% if currentCategorie is null and featuredArticles|default([])|length == 0 %}
<div id="carouselExampleIndicators2" class="carousel slide mb-5" data-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset(site_image('banner_boutique', 'images/baner/Boutique.png')) }}" alt="Boutique">
            <div class="carousel-caption">
                <h5 id="uneRep">Notre Boutique</h5>
            </div>
        </div>
    </div>
</div>
{% endif %}

<div style="width:80%;margin:0 auto 60px;padding:0 16px;">

    {# Fil d'ariane #}
    <nav class="bt-breadcrumb" aria-label="Fil d'ariane">
        <a href="{{ path('home') }}">Accueil</a>
        <span class="bt-bc-sep">›</span>
        {% if currentCategorie %}
            <a href="{{ path('boutique_index') }}">Boutique</a>
            <span class="bt-bc-sep">›</span>
            <span class="bt-bc-current">{{ currentCategorieLabel }}</span>
        {% else %}
            <span class="bt-bc-current">Boutique</span>
        {% endif %}
    </nav>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Accueil", "item": "{{ url('home') }}"},
            {"@type": "ListItem", "position": 2, "name": "Boutique", "item": "{{ url('boutique_index') }}"}
            {%- if currentCategorie -%}
            ,{"@type": "ListItem", "position": 3, "name": "{{ currentCategorieLabel }}", "item": "{{ url('boutique_index', {categorie: currentCategorie}) }}"}
            {%- endif %}
        ]
    }
    </script>

    <div class="boutique-header-row">
        <div class="boutique-page-title">Boutique</div>
    </div>

    {# ── Barre de catégories horizontale (tous écrans) — ordre géré dans Admin > Catégories ── #}
    <div class="cat-topbar-wrap">
    <div class="cat-topbar">
        <a href="{{ path('boutique_index') }}" class="cat-topbar-pill {{ currentCategorie is null ? 'active' : '' }}">
            <i class="fas fa-th-large"></i> Tous
            <span class="cat-topbar-count">{{ categoryCounts['__all__'] ?? 0 }}</span>
        </a>
        {% for slug, label in categories %}
            <a href="{{ path('boutique_index', {categorie: slug}) }}"
               class="cat-topbar-pill {{ currentCategorie == slug ? 'active' : '' }}">
                <i class="{{ categoryIcons[slug]|default('fas fa-box') }}"></i> {{ label }}
                {% if categoryCounts[slug] is defined and categoryCounts[slug] > 0 %}
                    <span class="cat-topbar-count">{{ categoryCounts[slug] }}</span>
                {% endif %}
            </a>
        {% endfor %}
        <a href="{{ path('boutique_index', {categorie: 'occasions'}) }}"
           class="cat-topbar-pill cat-topbar-pill--occasion {{ currentCategorie == 'occasions' ? 'active' : '' }}">
            <i class="fas fa-recycle"></i> Occasions
            {% if categoryCounts['occasions']|default(0) > 0 %}
                <span class="cat-topbar-count">{{ categoryCounts['occasions'] }}</span>
            {% endif %}
        </a>
    </div>
    <a href="{{ path('cart_index') }}" class="cat-topbar-cart">
        <i class="fas fa-shopping-cart"></i>
        Panier{% if cart is not empty %} · {{ cart|length }}{% endif %}
    </a>
    </div>

    {# ── Bannière commerciale : articles à la une (accueil uniquement) ── #}
    {% if currentCategorie is null and featuredArticles|default([])|length > 0 %}
        <div class="feat-banner" id="featBanner">
            {% for article in featuredArticles %}
                <div class="feat-slide {{ loop.first ? 'feat-slide--active' : '' }}">
                    <div class="feat-slide-text">
                        <span class="feat-badge"><i class="fas fa-star"></i>À la une</span>
                        <p class="feat-title">{{ article.name }}</p>
                        <p class="feat-sub">
                            {{ article.description|length > 110 ? article.description|slice(0, 110) ~ '…' : article.description }}
                        </p>
                        <div class="feat-cta-row">
                            <span class="feat-price">{{ article.price|number_format(2, ',', ' ') }} €</span>
                            <a href="{{ path('boutique_show', {id: article.id}) }}" class="feat-btn">
                                Découvrir <i class="fas fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>
                    <div class="feat-slide-img">
                        {% if article.image %}
                            <img src="{{ asset('uploads/images/' ~ article.image) }}" alt="{{ article.name }}">
                        {% else %}
                            <i class="fas fa-image"></i>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
            {% if featuredArticles|length > 1 %}
                <button type="button" class="feat-arrow feat-arrow--prev" aria-label="Article précédent"><i class="fas fa-chevron-left"></i></button>
                <button type="button" class="feat-arrow feat-arrow--next" aria-label="Article suivant"><i class="fas fa-chevron-right"></i></button>
                <div class="feat-dots">
                    {% for article in featuredArticles %}
                        <button type="button" class="feat-dot {{ loop.first ? 'feat-dot--active' : '' }}" data-index="{{ loop.index0 }}" aria-label="Aller à l'article {{ loop.index }}"></button>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        <script>
        (function() {
            var banner = document.getElementById('featBanner');
            if (!banner) return;
            var slides = banner.querySelectorAll('.feat-slide');
            if (slides.length < 2) return;
            var dots = banner.querySelectorAll('.feat-dot');
            var current = 0, timer = null;

            function show(i) {
                current = (i + slides.length) % slides.length;
                slides.forEach(function(s, k) { s.classList.toggle('feat-slide--active', k === current); });
                dots.forEach(function(d, k) { d.classList.toggle('feat-dot--active', k === current); });
            }
            function restart() {
                if (timer) clearInterval(timer);
                timer = setInterval(function() { show(current + 1); }, 5000);
            }
            banner.querySelector('.feat-arrow--prev').addEventListener('click', function() { show(current - 1); restart(); });
            banner.querySelector('.feat-arrow--next').addEventListener('click', function() { show(current + 1); restart(); });
            dots.forEach(function(d) {
                d.addEventListener('click', function() { show(parseInt(d.dataset.index, 10)); restart(); });
            });
            restart();
        })();
        </script>
    {% endif %}

    <p class="boutique-page-sub">
        {% if currentCategorie %}
            {{ currentCategorieLabel }} — {{ articles|length }} article{{ articles|length > 1 ? 's' : '' }} disponible{{ articles|length > 1 ? 's' : '' }}
        {% else %}
            Tous nos articles — {{ articles|length }} article{{ articles|length > 1 ? 's' : '' }} disponible{{ articles|length > 1 ? 's' : '' }}
        {% endif %}
    </p>

    <div class="boutique-fullwidth {{ cart is not empty ? 'boutique-fullwidth--with-cart' : '' }}">

        {# Grille produits #}
        <div class="products-area">

            {# ══════════════════════════════════════════════
               PAGE LANDING HYDROGEL (remplace la grille)
            ══════════════════════════════════════════════ #}
            {% if currentCategorie == 'film_hydrogel' %}

                {% set hydroArticle = articles|first %}

                {# ── HERO : image + présentation ── #}
                <div class="hlp-hero">
                    <div class="hlp-hero-img">
                        <img src="{{ asset('images/accueil/Hydrogel3.png') }}" alt="Film hydrogel sur mesure">
                    </div>
                    <div class="hlp-hero-content">
                        <h1 class="hlp-hero-title">Qu'est-ce qu'un film hydrogel ?</h1>
                        <div class="hlp-hero-sep"></div>
                        <p>L'hydrogel est un gel particulièrement solide et élastique. Composé d'eau et de polymères, il est utilisé notamment dans la fabrication des lentilles de contact. Fin, transparent et auto régénérant, le film hydrogel offre une résistance exceptionnelle aux chocs et rayures.</p>

                        <h2 class="hlp-hero-subtitle">L'alternative aux verres trempés</h2>
                        <div class="hlp-hero-sep"></div>
                        <p>Avant l'avènement du film hydrogel, les protections les plus courantes pour téléphone étaient en verre trempé. En chauffant à haute température ce verre (plus de 700 degrés) et en le refroidissant brusquement il devient plus résistant. Seul inconvénient au fil du temps, il garde les traces d'impact rendant l'écran du téléphone inesthétique. De plus, le verre trempé du fait de sa rigidité ne peut être utilisé sur les écrans avec les bords incurvés.</p>

                        {# CTA prix + bouton #}
                        {% if hydroArticle %}
                        <div class="hlp-hero-cta">
                            <div class="hlp-hero-price">
                                <span class="hlp-price-amount">{{ hydroArticle.price|number_format(2, ',', ' ') }} €</span>
                                <span class="hlp-price-hint">TTC · Découpe sur mesure</span>
                            </div>
                            <button type="button" class="btn-cart btn-cart--hydrogel btn-cart--lg"
                                    data-toggle="modal" data-target="#hydrogelModal{{ hydroArticle.id }}">
                                <i class="fas fa-mobile-alt"></i> Choisir mon modèle
                            </button>
                        </div>
                        {% endif %}
                    </div>
                </div>

                {# ── AVANTAGES (fond bleu foncé) ── #}
                <div class="hlp-advantages">
                    <h2 class="hlp-advantages-title">Les avantages du film hydrogel</h2>
                    <div class="hlp-advantages-sep"></div>
                    <div class="hlp-advantages-grid">
                        <ul class="hlp-advantages-list">
                            <li><i class="fas fa-check"></i> Compatible avec un grand nombre d'écrans (montre connectée, console de jeux style Switch, tablette, téléphone, appareil photo, etc.)</li>
                            <li><i class="fas fa-check"></i> Fin (≈ 0,40 mm)</li>
                            <li><i class="fas fa-check"></i> Résistant</li>
                            <li><i class="fas fa-check"></i> Transparent</li>
                        </ul>
                        <ul class="hlp-advantages-list">
                            <li><i class="fas fa-check"></i> Doux et agréable au toucher</li>
                            <li><i class="fas fa-check"></i> Compatible avec les lecteurs d'empreinte</li>
                            <li><i class="fas fa-check"></i> Durée de vie longue (supérieure à celle du verre trempé)</li>
                            <li><i class="fas fa-check"></i> Auto-régénérant. Le film grâce à sa plasticité s'auto-répare suite aux chocs ou aux rayures du quotidien</li>
                        </ul>
                    </div>
                </div>

                {# ── ÉTAPES DE POSE ── #}
                <div class="hlp-steps">
                    <h2 class="hlp-steps-title">Comment poser votre film hydrogel ?</h2>
                    <p class="hlp-steps-sub">Le kit inclut lingettes sèche et humide, autocollants anti-poussière et spatule de lissage.</p>

                    <div class="hlp-steps-grid">
                        <div class="hlp-step-card">
                            <div class="hlp-step-icon"><i class="fas fa-broom"></i></div>
                            <h3><span class="hlp-step-num">1</span> Nettoyer l'écran à l'aide du kit nettoyant</h3>
                            <p>Prendre la lingette humide (1) et enlever soigneusement de votre écran les traces et poussières. Ensuite, absorber avec la lingette sèche (2) les derniers résidus.</p>
                        </div>
                        <div class="hlp-step-card">
                            <div class="hlp-step-icon"><i class="fas fa-hand-paper"></i></div>
                            <h3><span class="hlp-step-num">2</span> Retirer le film hydrogel de son support</h3>
                            <p>La feuille est composée de trois couches distinctes.</p>
                        </div>
                        <div class="hlp-step-card">
                            <div class="hlp-step-icon"><i class="fas fa-layer-group"></i></div>
                            <h3><span class="hlp-step-num">3</span> Les trois couches de votre feuille hydrogel</h3>
                            <p>(1) la pellicule de positionnement (deux parties, basse et haute). (2) le film hydrogel qui va protéger votre écran. (3) la pellicule de soutien. Ne pas séparer les couches et les laisser assemblées.</p>
                        </div>
                        <div class="hlp-step-card">
                            <div class="hlp-step-icon"><i class="fas fa-mobile-alt"></i></div>
                            <h3><span class="hlp-step-num">4</span> Placer votre film hydrogel</h3>
                            <p>Mettre à plat votre smartphone pour positionner la feuille. Celle-ci adhérera à votre écran sans se coller directement. Exercer une petite pression sur la ligne prédécoupée (4).</p>
                        </div>
                        <div class="hlp-step-card">
                            <div class="hlp-step-icon"><i class="fas fa-angle-double-up"></i></div>
                            <h3><span class="hlp-step-num">5</span> Saisir la feuille</h3>
                            <p>Soulever par l'extrémité la partie basse à 90 degrés jusqu'à la ligne prédécoupée (4). Prendre comme repère cette ligne (4) et avec la spatule fournie, lisser délicatement pour que la pellicule de positionnement basse s'échappe.</p>
                        </div>
                        <div class="hlp-step-card">
                            <div class="hlp-step-icon"><i class="fas fa-angle-double-down"></i></div>
                            <h3><span class="hlp-step-num">6</span> Faire de même pour l'autre extrémité</h3>
                            <p>Soulever par l'extrémité la partie basse à 90 degrés jusqu'à la ligne prédécoupée (4). Prendre comme repère cette ligne (4) et avec la spatule fournie, lisser délicatement pour que la pellicule de positionnement basse s'échappe.</p>
                        </div>
                        <div class="hlp-step-card">
                            <div class="hlp-step-icon"><i class="fas fa-compress-arrows-alt"></i></div>
                            <h3><span class="hlp-step-num">7</span> Éliminer l'air et les bulles</h3>
                            <p>À l'aide de votre spatule ou de votre doigt, lisser intégralement l'ensemble pour chasser l'air et les bulles vers l'extérieur.</p>
                        </div>
                        <div class="hlp-step-card">
                            <div class="hlp-step-icon"><i class="fas fa-check-circle"></i></div>
                            <h3><span class="hlp-step-num">8</span> Ôter la pellicule de soutien</h3>
                            <p>C'est la dernière étape : sélectionner un des coins de votre smartphone et ôter la pellicule supérieure (3).</p>
                        </div>
                    </div>

                    <div class="hlp-tip">
                        <i class="fas fa-lightbulb"></i>
                        <div>
                            <strong>Conseil pro</strong> — Travaillez dans une pièce sans courant d'air pour éviter les poussières. Si une bulle persiste après la pose, elle disparaîtra d'elle-même en 24–48h grâce à l'auto-régénération du film.
                        </div>
                    </div>
                </div>

                {# ── CTA FINAL ── #}
                {% if hydroArticle %}
                <div class="hlp-cta">
                    <div class="hlp-cta-inner">
                        <div class="hlp-cta-text">
                            <h2>Protégez votre écran dès maintenant</h2>
                            <p>Découpe sur mesure pour votre smartphone — pose facile ou en boutique sans rendez-vous.</p>
                        </div>
                        <div class="hlp-cta-actions">
                            <div class="hlp-cta-price">{{ hydroArticle.price|number_format(2, ',', ' ') }} € <small>TTC</small></div>
                            <button type="button" class="btn-cart btn-cart--hydrogel btn-cart--lg"
                                    data-toggle="modal" data-target="#hydrogelModal{{ hydroArticle.id }}">
                                <i class="fas fa-shield-alt"></i> Commander mon film hydrogel
                            </button>
                            <a href="{{ path('contact') }}" class="hlp-cta-link">
                                <i class="fas fa-store mr-1"></i> Ou venez en boutique à Pélissanne
                            </a>
                        </div>
                    </div>
                </div>
                {% endif %}

            {# ══════════════════════════════════════════════
               PAGE COQUES (grille + sélecteur modèle par carte)
            ══════════════════════════════════════════════ #}
            {% elseif currentCategorie == 'coque' %}

                <div class="coque-intro">
                    <h1 class="coque-intro-title">Coques de protection</h1>
                    <p class="coque-intro-sub">
                        Choisissez votre coque, puis sélectionnez le modèle de votre téléphone.
                        Chaque coque est déclinée pour de nombreux modèles — vous ne payez qu'une fois.
                    </p>
                </div>

                {% if articles is empty %}
                    <div class="coque-empty">
                        <i class="fas fa-shield-alt"></i>
                        <p>Aucune coque disponible pour le moment.</p>
                    </div>
                {% else %}
                    <div class="coque-grid">
                        {% for article in articles %}
                            <article class="coque-card">
                                <div class="coque-card-img">
                                    {% if article.image %}
                                        <img src="{{ asset('uploads/images/' ~ article.image) }}" alt="{{ article.name }}" loading="lazy">
                                    {% else %}
                                        <div class="coque-card-noimg"><i class="fas fa-shield-alt"></i></div>
                                    {% endif %}
                                </div>
                                <div class="coque-card-body">
                                    <h3 class="coque-card-title">{{ article.name }}</h3>
                                    {% if article.description %}
                                        <p class="coque-card-desc">{{ article.description|length > 90 ? article.description|slice(0, 90) ~ '…' : article.description }}</p>
                                    {% endif %}
                                    <div class="coque-card-footer">
                                        <span class="coque-card-price">{{ article.price|number_format(2, ',', ' ') }} €</span>
                                        <button type="button" class="btn-cart btn-cart--coque"
                                                data-toggle="modal" data-target="#hydrogelModal{{ article.id }}">
                                            <i class="fas fa-mobile-alt mr-1"></i> Choisir mon modèle
                                        </button>
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}

            {# ══════════════════════════════════════════════
               GRILLE PRODUITS CLASSIQUE (autres catégories)
            ══════════════════════════════════════════════ #}
            {% else %}

                {# Accroche de réassurance éditable dans Admin > Paramètres > Accroches boutique #}
                {% if currentCategorie %}
                    {% set accroche = app_setting('boutique_accroche_' ~ currentCategorie) %}
                    {% if accroche %}
                        <div class="cat-accroche">
                            <i class="fas fa-award"></i>
                            <span>{{ accroche }}</span>
                        </div>
                    {% endif %}
                {% endif %}

                {# Filtre marques #}
                {% if currentCategorie == 'telephone' and availableBrands is not empty %}
                    <div class="brand-filter-bar">
                        <span class="brand-filter-label"><i class="fas fa-filter mr-1"></i>Marque :</span>
                        <a href="{{ path('boutique_index', {categorie: 'telephone'}) }}"
                           class="brand-pill {{ currentBrand is null ? 'brand-pill--active' : '' }}">
                            Toutes
                        </a>
                        {% for b in availableBrands %}
                            <a href="{{ path('boutique_index', {categorie: 'telephone', brand: b}) }}"
                               class="brand-pill {{ currentBrand == b ? 'brand-pill--active' : '' }}">
                                {{ b }}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if articles is empty %}
                    <div class="empty-state">
                        <i class="fas fa-box-open"></i>
                        <p style="font-size:16px;font-weight:600;color:#6c757d;margin-bottom:6px;">Aucun article pour le moment.</p>
                        <small>Revenez bientôt ou consultez une autre catégorie.</small><br><br>
                        <a href="{{ path('boutique_index') }}" style="display:inline-flex;align-items:center;gap:7px;margin-top:6px;background:rgb(9,71,113);color:white;padding:9px 18px;border-radius:8px;font-size:13px;font-weight:600;text-decoration:none;">
                            <i class="fas fa-arrow-left"></i> Voir tout
                        </a>
                    </div>
                {% elseif currentCategorie is null %}

                    {# ── Nouveautés : les derniers articles ajoutés ── #}
                    {% if latestArticles|default([])|length > 0 %}
                        <section class="cat-section">
                            <div class="cat-section-head">
                                <h2 class="cat-section-title">
                                    <i class="fas fa-bolt"></i>
                                    Nouveautés
                                    <span class="cat-section-sub-inline">Ils viennent d'arriver en boutique</span>
                                </h2>
                            </div>
                            <div class="cat-section-row">
                                {% for article in latestArticles %}
                                    {{ include('boutique/_product_card.html.twig', {article: article, currentCategorie: currentCategorie, isNewArrival: true}) }}
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {# ── Occasions : matériel révisé à prix doux ── #}
                    {% if occasionArticles|default([])|length > 0 %}
                        <section class="cat-section">
                            <div class="cat-section-head">
                                <h2 class="cat-section-title">
                                    <i class="fas fa-recycle" style="color:#16a34a;"></i>
                                    Occasions
                                    <span class="cat-section-sub-inline">Révisées par notre atelier, garanties et à prix doux</span>
                                </h2>
                                <a href="{{ path('boutique_index', {categorie: 'occasions'}) }}" class="cat-section-more">
                                    Voir tout <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                            <div class="cat-section-row">
                                {% for article in occasionArticles %}
                                    {{ include('boutique/_product_card.html.twig', {article: article, currentCategorie: currentCategorie}) }}
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                    {# ── Accueil : une section par catégorie, rangée défilante + "Voir tout" ── #}
                    {% for slug, label in categories %}
                        {% set catArticles = articles|filter(a => a.categorie == slug) %}
                        {% if catArticles|length > 0 %}
                            <section class="cat-section">
                                <div class="cat-section-head">
                                    <h2 class="cat-section-title">
                                        <i class="{{ categoryIcons[slug]|default('fas fa-box') }}"></i>
                                        {{ label }}
                                        <span class="cat-section-count">{{ catArticles|length }}</span>
                                    </h2>
                                    <a href="{{ path('boutique_index', {categorie: slug}) }}" class="cat-section-more">
                                        Voir tout <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                                <div class="cat-section-row">
                                    {% for article in catArticles %}
                                        {{ include('boutique/_product_card.html.twig', {article: article, currentCategorie: currentCategorie}) }}
                                    {% endfor %}
                                </div>
                            </section>
                        {% endif %}
                    {% endfor %}

                    {# Articles sans catégorie connue #}
                    {% set orphans = articles|filter(a => a.categorie is null or categories[a.categorie] is not defined) %}
                    {% if orphans|length > 0 %}
                        <section class="cat-section">
                            <div class="cat-section-head">
                                <h2 class="cat-section-title"><i class="fas fa-box"></i> Autres <span class="cat-section-count">{{ orphans|length }}</span></h2>
                            </div>
                            <div class="cat-section-row">
                                {% for article in orphans %}
                                    {{ include('boutique/_product_card.html.twig', {article: article, currentCategorie: currentCategorie}) }}
                                {% endfor %}
                            </div>
                        </section>
                    {% endif %}

                {% else %}
                    <div class="products-grid">
                        {% for article in articles %}
                            {{ include('boutique/_product_card.html.twig', {article: article, currentCategorie: currentCategorie}) }}
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}

        </div>

        {# ── Aperçu du panier en cours (sticky, masqué si vide) ── #}
        {% if cart is not empty %}
            <aside class="side-cart">
                <div class="mini-cart">
