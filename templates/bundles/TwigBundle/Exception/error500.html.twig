{% extends 'base.html.twig' %}

{% block title %}Erreur serveur — D'Panne Phones{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{% block body %}
<div class="err-page err-page--500">
    <div class="err-page-bg">
        <span class="err-blob err-blob--1" style="background:radial-gradient(circle, #ef4444, transparent 70%);"></span>
        <span class="err-blob err-blob--2" style="background:radial-gradient(circle, #f59e0b, transparent 70%);"></span>
    </div>

    <div class="err-page-inner">
        <div class="err-icon">
            <i class="fas fa-tools"></i>
        </div>
        <div class="err-code">500</div>
        <h1 class="err-title">Oups, une erreur est survenue…</h1>
        <p class="err-text">
            Notre serveur rencontre un problème temporaire. Notre équipe technique est automatiquement informée
            et s'occupe de régler ça au plus vite.
        </p>
        <p class="err-text" style="font-size:14px;color:#64748b;">
            <strong>Vous pouvez :</strong><br>
            Réessayer dans quelques instants · Retourner à la page d'accueil · Nous contacter si le problème persiste
        </p>

        <div class="err-actions">
            <a href="{{ path('home') }}" class="err-btn err-btn--primary">
                <i class="fas fa-home mr-2"></i>Retour à l'accueil
            </a>
            <a href="javascript:location.reload();" class="err-btn err-btn--ghost">
                <i class="fas fa-redo mr-2"></i>Réessayer
            </a>
            <a href="tel:+33783748311" class="err-btn err-btn--ghost">
                <i class="fas fa-phone mr-2"></i>07 83 74 83 11
            </a>
        </div>

        <div style="margin-top:40px;padding:18px 22px;background:#fffbeb;border:1px solid #fde68a;border-left:3px solid #f59e0b;border-radius:10px;text-align:left;max-width:520px;margin-left:auto;margin-right:auto;">
            <div style="font-size:13px;font-weight:700;color:#92400e;margin-bottom:6px;">
                <i class="fas fa-lightbulb mr-1"></i>Besoin urgent ?
            </div>
            <p style="margin:0;font-size:13px;color:#78350f;line-height:1.55;">
                Vous pouvez passer directement en boutique — Avenue Pasteur, Centre Commercial Le Galion (Parking Aldi), 13330 Pélissanne.
                Ou appelez-nous au <a href="tel:+33783748311" style="color:#92400e;font-weight:700;">07 83 74 83 11</a>.
            </p>
        </div>
    </div>
</div>
{% endblock %}
