{# Rangée discrète des moyens de paiement — réassurance près des boutons d'achat.
   Les moyens affichés suivent ceux du dashboard Stripe (CB, wallets…). #}
<div class="pay-trust-row" aria-label="Moyens de paiement acceptés">
    <span class="pay-trust-lock"><i class="fas fa-lock"></i> Paiement sécurisé <strong>Stripe</strong></span>
    <span class="pay-trust-icons">
        <i class="fab fa-cc-visa" title="Visa"></i>
        <i class="fab fa-cc-mastercard" title="Mastercard"></i>
        <span class="pay-trust-badge" title="Carte Bancaire">CB</span>
        <i class="fab fa-apple-pay" title="Apple Pay"></i>
        <span class="pay-trust-badge" title="Google Pay">G&nbsp;Pay</span>
    </span>
</div>
