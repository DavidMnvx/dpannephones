<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}D'Panne Phones — Réparation Smartphone, Tablette & PC à Pélissanne{% endblock %}</title>

        {# ── Balises SEO surchargeables par chaque page ── #}
        <meta name="description"    content="{% block meta_description %}D'Panne Phones, spécialiste réparation smartphone, tablette et ordinateur à Pélissanne depuis 2017. Devis gratuit, pièces de qualité, garantie 6 mois.{% endblock %}">
        <meta name="keywords"       content="{% block meta_keywords %}réparation téléphone Pélissanne, réparation smartphone, réparation iPhone, réparation Samsung, réparation tablette, réparation PC, D'Panne Phones{% endblock %}">
        <meta name="robots"         content="{% block meta_robots %}index, follow{% endblock %}">
        <link rel="canonical"       href="{% block canonical %}{% endblock %}">

        {# ── Open Graph ── #}
        <meta property="og:type"        content="website">
        <meta property="og:site_name"   content="D'Panne Phones">
        <meta property="og:title"       content="{% block og_title %}D'Panne Phones — Réparation & Vente à Pélissanne{% endblock %}">
        <meta property="og:description" content="{% block og_description %}Réparation smartphone, tablette et ordinateur à Pélissanne. Diagnostique gratuit, pièces de qualité, garantie 6 mois. Depuis 2017.{% endblock %}">
        <meta property="og:image"       content="{% block og_image %}{{ absolute_url(asset('images/logo_dpannephones/Logo_dpannephones.png')) }}{% endblock %}">
        <meta property="og:locale"      content="fr_FR">

        {# ── Favicons (référence Google Search + navigateurs + PWA) ── #}
        <link rel="icon"          href="{{ asset('favicon.ico') }}" sizes="any">
        <link rel="icon"          href="{{ asset('favicon-32.png') }}"  sizes="32x32"   type="image/png">
        <link rel="icon"          href="{{ asset('favicon-192.png') }}" sizes="192x192" type="image/png">
        <link rel="icon"          href="{{ asset('favicon-512.png') }}" sizes="512x512" type="image/png">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
        <link rel="manifest"      href="{{ asset('site.webmanifest') }}">
        <meta name="theme-color"  content="#094771">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css" integrity="sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm" crossorigin="anonymous">
        
        
        {% block stylesheets %}
          <link rel="stylesheet" href="{{ asset('styles/app.css') }}?v={{ 'now'|date('YmdHi') }}">
        {% endblock %}

        {# ── JSON-LD : LocalBusiness (global sur toutes les pages pour le SEO) ── #}
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          "name": "D'Panne Phones",
          "image": "{{ absolute_url(asset('images/logo_dpannephones/Logo_dpannephones.png')) }}",
          "url": "{{ absolute_url('/') }}",
          "telephone": "+33783748311",
          "email": "contact@dpannephones.com",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Avenue Pasteur — Centre Commercial Le Galion (Parking Aldi)",
            "addressLocality": "Pélissanne",
            "postalCode": "13330",
            "addressCountry": "FR"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 43.629783,
            "longitude": 5.154775
          },
          "openingHoursSpecification": [
            {% set dayNames = {1: 'Monday', 2: 'Tuesday', 3: 'Wednesday', 4: 'Thursday', 5: 'Friday', 6: 'Saturday', 7: 'Sunday'} %}
            {% set specs = [] %}
            {% for horaire in horaires_semaine() %}
              {% if not horaire.ferme %}
                {% if horaire.matinOuverture and horaire.matinFermeture %}
                  {% set specs = specs|merge([{
                    day: dayNames[horaire.jourNumero],
                    opens: horaire.matinOuverture|date('H:i'),
                    closes: horaire.matinFermeture|date('H:i')
                  }]) %}
                {% endif %}
                {% if horaire.apresmidiOuverture and horaire.apresmidiFermeture %}
                  {% set specs = specs|merge([{
                    day: dayNames[horaire.jourNumero],
                    opens: horaire.apresmidiOuverture|date('H:i'),
                    closes: horaire.apresmidiFermeture|date('H:i')
                  }]) %}
                {% endif %}
              {% endif %}
            {% endfor %}
            {% for s in specs %}
            { "@type": "OpeningHoursSpecification", "dayOfWeek": "{{ s.day }}", "opens": "{{ s.opens }}", "closes": "{{ s.closes }}" }{% if not loop.last %},{% endif %}
            {% endfor %}
          ],
          "priceRange": "€€"
        }
        </script>

        {# ── JSON-LD surchargeable par page (aggregateRating, Product, etc.) ── #}
        {% block jsonld %}{% endblock %}

        {# ═══════════════════════════════════════════════════
           Tarteaucitron — Gestionnaire de consentement RGPD
           ═══════════════════════════════════════════════════
           Gère le consentement pour :
             - Google Analytics 4 (tracking trafic)
             - Autres services tiers (Stripe : tech, exempté du consentement)

           L'utilisateur doit explicitement accepter avant que GA4 charge.
           Si pas de GOOGLE_ANALYTICS_ID configuré, Tarteaucitron n'affiche rien.
           ─────────────────────────────────────────────────── #}
        {% if google_analytics_id and app.environment == 'prod' %}
        <script src="https://cdn.jsdelivr.net/gh/AmauriC/tarteaucitron.js@V1.17.0/tarteaucitron.min.js"></script>
        <script>
            tarteaucitron.init({
                "privacyUrl": "{{ path('legal_confidentialite') }}",
                "bodyPosition": "bottom",
                "hashtag": "#tarteaucitron",
                "cookieName": "tarteaucitron",
                "orientation": "middle",
                "groupServices": false,
                "showDetailsOnClick": true,
                "serviceDefaultState": "wait",
                "showAlertSmall": false,
                "cookieslist": false,
                "closePopup": false,
                "showIcon": true,
                "iconPosition": "BottomRight",
                "adblocker": false,
                "DenyAllCta" : true,
                "AcceptAllCta" : true,
                "highPrivacy": true,
                "handleBrowserDNTRequest": false,
                "removeCredit": false,
                "moreInfoLink": true,
                "useExternalCss": false,
                "useExternalJs": false,
                "readmoreLink": "{{ path('legal_confidentialite') }}",
                "mandatory": true,
                "mandatoryCta": true
            });

            // Google Analytics 4 — chargé après consentement uniquement
            tarteaucitron.user.gtagUa = '{{ google_analytics_id }}';
            tarteaucitron.user.gtagMore = function () {
                gtag('config', '{{ google_analytics_id }}', {
                    'anonymize_ip': true,
                    'allow_google_signals': false,
                    'allow_ad_personalization_signals': false
                });
            };
            (tarteaucitron.job = tarteaucitron.job || []).push('gtag');
        </script>
        {% endif %}
    </head>

    <body>
        {# ── Calcul de la page active pour la surbrillance navbar ── #}
        {% set currentPath = app.request.pathInfo ?? '/' %}
        {% set isHome         = (currentPath == '/') %}
        {% set isReparations  = (currentPath starts with '/reparations') or (currentPath starts with '/ordinateur') or (currentPath starts with '/marques') or (currentPath starts with '/modeles') %}
        {% set isBoutique     = (currentPath starts with '/boutique') %}
        {% set isContact      = (currentPath starts with '/contact') %}
        {% set isPartenaires  = (currentPath starts with '/partenaires') %}
        {% set isAbout        = (currentPath starts with '/about') %}
        {% set isAccount      = (currentPath starts with '/compte') or (currentPath starts with '/login') or (currentPath starts with '/register') or (currentPath starts with '/account') %}

        <nav class="navbar navbar-expand-lg navbar-light bg-light ">
            <a class="navbar-brand " href="{{ path('home') }}"><img src="{{asset ('images/logo_dpannephones/Logo_engrenage.png') }}" alt="Logo" height="65" ></a>
            <a class="navbar-brand " href="{{ path('home') }}"><img src="{{asset ('images/logo_dpannephones/Logo_dpannephones.png') }}" alt="Logo" height="35" ></a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse " id="navbarNavDropdown">
                {# ═════ Liens principaux — centrés ═════ #}
                <ul class="navbar-nav mx-auto">
                    {# Accueil = icône maison (pas de texte) #}
                    <li class="nav-item {{ isHome ? 'active' : '' }}">
                        <a class="nav-link nav-link--home" href="{{ path('home') }}" title="Accueil" aria-label="Accueil">
                            <i class="fas fa-home"></i>
                            <span class="sr-only">Accueil</span>
                        </a>
                    </li>

                    {# Réparation — masqué si page désactivée dans le CRUD #}
                    {% if page_enabled('reparations') %}
                    <li class="nav-item {{ isReparations ? 'active' : '' }}">
                        <a class="nav-link" href="{{ path('reparations_home') }}">Réparation</a>
                    </li>
                    {% endif %}

                    {# Boutique — masqué si désactivée #}
                    {% if page_enabled('boutique') %}
                    <li class="nav-item {{ isBoutique ? 'active' : '' }}">
                        <a class="nav-link" href="{{ path('boutique_index') }}">La Boutique</a>
                    </li>
                    {% endif %}

                    {# Contact — masqué si désactivée #}
                    {% if page_enabled('contact') %}
                    <li class="nav-item {{ isContact ? 'active' : '' }}">
                        <a class="nav-link" href="{{ path('contact') }}">Contact</a>
                    </li>
                    {% endif %}

                    {# Partenaires — masqué si désactivée #}
                    {% if page_enabled('partenaires') %}
                    <li class="nav-item {{ isPartenaires ? 'active' : '' }}">
                        <a class="nav-link" href="{{ path('partenaires_index') }}">Partenaires</a>
                    </li>
                    {% endif %}

                    {# Qui sommes-nous — masqué si désactivée #}
                    {% if page_enabled('about') %}
                    <li class="nav-item {{ isAbout ? 'active' : '' }}">
                        <a class="nav-link" href="{{ path('app_about') }}">Qui sommes-nous ?</a>
                    </li>
                    {% endif %}

                    {# Création de sites — vitrine NosWeb #}
                    <li class="nav-item {{ currentPath starts with '/creation-de-sites' ? 'active' : '' }}">
                        <a class="nav-link" href="{{ path('site_creation') }}">Création de sites</a>
                    </li>
                </ul>

                {# ═════ À droite : Admin, Compte, Téléphone ═════ #}
                <ul class="navbar-nav ml-auto mr-3 navbar-nav--right">
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-primary mr-2" id="regisconn" href="/admin">
                                <i class="fas fa-cog mr-1"></i>Back-office
                            </a>
                        </li>
                    {% endif %}
                    {% if is_granted('ROLE_USER') %}
                        <li class="nav-item dropdown">
                            <a class="nav-link btn btn-outline-primary mr-2 dropdown-toggle" href="#" id="accountDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-user-circle mr-1"></i>
                                {{ app.user.prenom ?? app.user.email }}
                            </a>
                            <div class="dropdown-menu dropdown-menu-right navbar-account-dropdown" aria-labelledby="accountDropdown">
                                <div class="dropdown-account-header">
                                    <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong>
                                    <small>{{ app.user.email }}</small>
                                </div>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item" href="{{ path('account_index') }}">
                                    <i class="fas fa-user mr-2"></i>Mon Compte
                                </a>
                                <a class="dropdown-item" href="{{ path('cart_index') }}">
                                    <i class="fas fa-shopping-cart mr-2"></i>Mon Panier
                                </a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item dropdown-item--logout" href="{{ path('app_logout') }}">
                                    <i class="fas fa-sign-out-alt mr-2"></i>Déconnexion
                                </a>
                            </div>
                        </li>
                    {% else %}
                        {# Remplace Inscription + Connexion par un seul lien "Mon compte" #}
                        <li class="nav-item {{ isAccount ? 'active' : '' }}">
                            <a class="nav-link btn btn-outline-primary mr-2" id="regisconn" href="{{ path('app_login') }}">
                                <i class="fas fa-user-circle mr-1"></i>Mon compte
                            </a>
                        </li>
                    {% endif %}

                    {# Téléphone — toujours tout à droite #}
                    <li class="nav-item nav-item--phone">
                        <a class="nav-link phone-btn" href="tel:+33783748311">
                            <i class="fas fa-phone-alt mr-1"></i>07 83 74 83 11
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        {# ═════ Widget flottant Google Rating ═════ #}
        {# Pastille fixe en bas à droite avec CTA explicite "Voir les avis" #}
        {# Masquée sur la page /avis pour éviter la redondance #}
        {% set _googleRating = google_rating() %}
        {% set _googleCount = google_reviews_count() %}
        {% set _isReviewsPage = (currentPath starts with '/avis') or (currentPath starts with '/reviews') %}
        {% if _googleRating and not _isReviewsPage %}
        <a href="{{ path('reviews_index') }}"
           class="google-rating-float"
           id="google-rating-float"
           aria-label="Voir tous les avis Google">
            {# Badge compact (état replié) #}
            <span class="grf-compact" aria-hidden="true">
                <i class="fab fa-google grf-g"></i>
                <span class="grf-compact-score">{{ _googleRating }}</span>
                <i class="fas fa-star grf-compact-star"></i>
            </span>

            {# Panneau détaillé (état déplié au survol / tap) #}
            <span class="google-rating-float-icon" aria-hidden="true"><i class="fab fa-google grf-g"></i></span>

            <span class="google-rating-float-main">
                <span class="google-rating-float-score">{{ _googleRating }}</span>
                <span class="google-rating-float-stars" aria-hidden="true">
                    {% for i in 1..5 %}
                        <i class="{{ i <= _googleRating|round ? 'fas' : 'far' }} fa-star"></i>
                    {% endfor %}
                </span>
                {% if _googleCount %}
                <span class="google-rating-float-count">{{ _googleCount }} avis Google</span>
                {% endif %}
            </span>

            <span class="google-rating-float-cta-bottom">
                Voir les avis <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </span>
        </a>
        <script>
        (function () {
            var f = document.getElementById('google-rating-float');
            if (!f || !('ontouchstart' in window)) return;
            // Mobile : le 1er tap déplie le badge, le 2e navigue
            f.addEventListener('click', function (e) {
                if (!f.classList.contains('grf-open')) {
                    e.preventDefault();
                    f.classList.add('grf-open');
                }
            });
            document.addEventListener('click', function (e) {
                if (!f.contains(e.target)) f.classList.remove('grf-open');
            });
        })();
        </script>
        {% endif %}

         {% block body %}{% endblock %}

