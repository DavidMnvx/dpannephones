{% extends 'base.html.twig' %}

{% block title %}Réparations — {{ modele.name }} — D'Panne Phones{% endblock %}

{% block body %}

{% include 'reparations/_hero_reparation.html.twig' with {
    step: 4,
    type: type,
    title: 'Réparations ' ~ modele.name,
    subtitle: 'Sélectionnez les prestations souhaitées — le devis se met à jour automatiquement.',
    breadcrumb: [
        { label: 'Réparation', url: path('reparations_home') },
        { label: 'Marques',    url: path('choix_marque', {type: type}) },
        { label: modele.marque.name, url: path('choix_modele', {marqueId: modele.marque.id, type: type}) },
        { label: modele.name }
    ]
} %}

<div class="rep-container rep-container--flex">

    {# ══ Colonne gauche : liste des réparations ══ #}
    <div class="rep-main-col">

        {# Bandeau récap modèle #}
        <div class="rep-context-bar">
            <div class="rep-context-brand">
                {% if modele.image %}
                    <img src="{{ asset('uploads/images/' ~ modele.image) }}" alt="{{ modele.name }}">
                {% elseif modele.marque.image %}
                    <img src="{{ asset('uploads/images/' ~ modele.marque.image) }}" alt="{{ modele.marque.name }}">
                {% endif %}
                <div>
                    <small>Modèle sélectionné</small>
                    <strong>{{ modele.marque.name }} {{ modele.name }}</strong>
                </div>
            </div>
            <a href="{{ path('choix_modele', {marqueId: modele.marque.id, type: type}) }}" class="rep-context-change">
                <i class="fas fa-exchange-alt mr-1"></i> Changer
            </a>
        </div>

        {# Info guide #}
        <div class="rep-guide-info">
            <i class="fas fa-info-circle"></i>
            <div>
                <strong>Comment ça marche ?</strong>
                <span>Cochez les réparations nécessaires ci-dessous. Votre devis estimatif s'affiche à droite. Cliquez sur "Prendre rendez-vous" pour finaliser.</span>
            </div>
        </div>

        {# ── Réparations spécifiques au modèle ── #}
        {% if reparations is not empty %}
            <div class="rep-section">
                <div class="rep-section-head">
                    <i class="fas fa-wrench" style="color:rgb(9,71,113);"></i>
                    <h2>Réparations pour votre {{ modele.name }}</h2>
                </div>
                <div class="rep-list">
                    {% for reparation in reparations %}
                        <label class="rep-item" for="rep-{{ reparation.id }}"
                               style="animation-delay: {{ (loop.index0 * 0.03) }}s;">
                            <input type="checkbox"
                                   id="rep-{{ reparation.id }}"
                                   class="rep-item-checkbox reparation-checkbox"
                                   data-price="{{ reparation.prix }}"
                                   data-name="{{ reparation.name }}">
                            <div class="rep-item-content">
                                <div class="rep-item-main">
                                    <div class="rep-item-name">{{ reparation.name }}</div>
                                    {% if reparation.description %}
                                        <p class="rep-item-desc">{{ reparation.description }}</p>
                                    {% endif %}
                                </div>
                                <div class="rep-item-right">
                                    <span class="rep-item-price {{ reparation.prix == 0 ? 'rep-item-price--free' : '' }}">
                                        {{ reparation.prix == 0 ? 'Gratuit' : reparation.prix ~ ' €' }}
                                    </span>
                                    <div class="rep-item-check">
                                        <i class="fas fa-check"></i>
                                    </div>
                                </div>
                            </div>
                        </label>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        {# ── Services communs ── #}
        <div class="rep-section">
            <div class="rep-section-head">
                <i class="fas fa-tools" style="color:#f59e0b;"></i>
                <h2>Services communs</h2>
                <small>Disponibles pour tous les modèles</small>
            </div>

            {% set predefined_reparations = [
                {'id': 'sim',       'name': 'Tiroir SIM',           'description': 'Remplacement tiroir SIM — pièce sur commande 24-48h.',           'prix': 10,  'icon': 'fa-sim-card'},
                {'id': 'desox',     'name': 'Désoxydation',         'description': 'Traitement après contact avec liquide — résultat sous 24-48h.',  'prix': 49,  'icon': 'fa-tint'},
                {'id': 'transfert', 'name': 'Transfert de données', 'description': 'Migration complète de vos données vers un nouvel appareil.',    'prix': 19,  'icon': 'fa-exchange-alt'},
                {'id': 'diag',      'name': 'Diagnostique',         'description': 'Analyse complète directement en boutique — sans rendez-vous.',  'prix': 0,   'icon': 'fa-stethoscope'}
            ] %}
            <div class="rep-list">
                {% for rep in predefined_reparations %}
                    <label class="rep-item rep-item--common" for="rep-{{ rep.id }}"
                           style="animation-delay: {{ (loop.index0 * 0.03) }}s;">
                        <input type="checkbox"
                               id="rep-{{ rep.id }}"
                               class="rep-item-checkbox reparation-checkbox"
                               data-price="{{ rep.prix }}"
                               data-name="{{ rep.name }}">
                        <div class="rep-item-content">
                            <div class="rep-item-icon">
                                <i class="fas {{ rep.icon }}"></i>
                            </div>
                            <div class="rep-item-main">
                                <div class="rep-item-name">{{ rep.name }}</div>
                                <p class="rep-item-desc">{{ rep.description }}</p>
                            </div>
                            <div class="rep-item-right">
                                <span class="rep-item-price {{ rep.prix == 0 ? 'rep-item-price--free' : '' }}">
                                    {{ rep.prix == 0 ? 'Gratuit' : rep.prix ~ ' €' }}
                                </span>
                                <div class="rep-item-check">
                                    <i class="fas fa-check"></i>
                                </div>
                            </div>
                        </div>
                    </label>
                {% endfor %}
            </div>
        </div>

        {# Aide #}
        <div class="rep-help-box">
            <div class="rep-help-icon"><i class="fas fa-question-circle"></i></div>
            <div class="rep-help-content">
                <strong>Une panne qui n'est pas dans la liste ?</strong>
                <p>Nous traitons aussi les cas particuliers — contactez-nous pour un devis sur-mesure.</p>
                <div class="rep-help-actions">
                    <a href="{{ path('contact') }}" class="rep-help-btn">
                        <i class="fas fa-envelope mr-1"></i> Nous écrire
                    </a>
                    <a href="tel:+33783748311" class="rep-help-btn rep-help-btn--phone">
                        <i class="fas fa-phone mr-1"></i> 07 83 74 83 11
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# ══ Colonne droite : devis sticky ══ #}
    <aside class="rep-devis">
        <div class="rep-devis-sticky">
            <div class="rep-devis-header">
                <i class="fas fa-receipt mr-2"></i>
                <span>Mon devis</span>
            </div>

            <div class="rep-devis-empty" id="devisEmpty">
                <i class="fas fa-hand-pointer"></i>
                <p>Cochez une réparation pour commencer votre devis</p>
            </div>

            <ul class="rep-devis-list" id="devisList"></ul>

            <div class="rep-devis-summary" id="devisSummary" style="display:none;">
                <div class="rep-devis-row">
                    <span>Nombre de réparations</span>
                    <span id="devisCount">0</span>
                </div>
                <div class="rep-devis-total">
                    <span>Total estimé TTC</span>
                    <span class="rep-devis-amount"><span id="total-price">0,00</span> €</span>
                </div>
            </div>

            <a href="{{ path('contact') }}" class="rep-devis-cta" id="devisCta">
                <i class="fas fa-calendar-check mr-2"></i>
                Prendre rendez-vous
            </a>

            <div class="rep-devis-reassurance">
                <div><i class="fas fa-shield-alt"></i> Garantie 6 mois</div>
                <div><i class="fas fa-clock"></i> Réparation sous 24-48h</div>
                <div><i class="fas fa-euro-sign"></i> Devis sans engagement</div>
            </div>
        </div>
    </aside>

</div>

{# ── Barre devis mobile (sticky bas) ── #}
<div class="rep-mobile-devis" id="mobileDevis" style="display:none;">
    <div class="rep-mobile-devis-info">
        <small><span id="mobileDevisCount">0</span> réparation(s)</small>
        <strong><span id="mobileTotal">0,00</span> €</strong>
    </div>
    <a href="{{ path('contact') }}" class="rep-mobile-devis-btn">
        <i class="fas fa-calendar-check mr-1"></i> Rendez-vous
    </a>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
(function() {
    const checkboxes = document.querySelectorAll('.reparation-checkbox');
    const devisList  = document.getElementById('devisList');
    const devisEmpty = document.getElementById('devisEmpty');
    const devisSummary = document.getElementById('devisSummary');
    const totalEl    = document.getElementById('total-price');
    const countEl    = document.getElementById('devisCount');
    const mobileDevis = document.getElementById('mobileDevis');
    const mobileTotal = document.getElementById('mobileTotal');
    const mobileCount = document.getElementById('mobileDevisCount');

    function formatPrice(n) {
        return n.toFixed(2).replace('.', ',');
    }

    function updateDevis() {
        const selected = [];
        let total = 0;

        checkboxes.forEach(cb => {
            // Toggle class selected sur le label parent
            const item = cb.closest('.rep-item');
            if (cb.checked) {
                item.classList.add('rep-item--selected');
                const price = parseFloat(cb.dataset.price) || 0;
                selected.push({
                    name: cb.dataset.name,
                    price: price
                });
                total += price;
            } else {
                item.classList.remove('rep-item--selected');
            }
        });

        // Mise à jour liste devis
        devisList.innerHTML = '';
        selected.forEach(item => {
            const li = document.createElement('li');
            li.className = 'rep-devis-item';
            li.innerHTML = `
                <span class="rep-devis-item-name">${item.name}</span>
                <span class="rep-devis-item-price">${item.price === 0 ? 'Gratuit' : formatPrice(item.price) + ' €'}</span>
            `;
            devisList.appendChild(li);
        });

        // Affichage empty / summary
        if (selected.length === 0) {
            devisEmpty.style.display = 'block';
            devisSummary.style.display = 'none';
            mobileDevis.style.display = 'none';
        } else {
            devisEmpty.style.display = 'none';
            devisSummary.style.display = 'block';
            mobileDevis.style.display = 'flex';
        }

        // Totaux
        totalEl.textContent = formatPrice(total);
        mobileTotal.textContent = formatPrice(total);
        countEl.textContent = selected.length;
        mobileCount.textContent = selected.length;

        // Animation du total
        totalEl.parentElement.classList.remove('rep-devis-amount--pulse');
        void totalEl.parentElement.offsetWidth;
        totalEl.parentElement.classList.add('rep-devis-amount--pulse');
    }

    checkboxes.forEach(cb => cb.addEventListener('change', updateDevis));
})();
</script>
{% endblock %}
