{% extends 'base.html.twig' %}

{% block title %}Réparations — {{ modele.name }}{% endblock %}

{% block body %}

{# Bannière #}
<div id="carouselExampleIndicators2" class="carousel slide mb-5" data-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset('images/reparation/reparation_mobile2.jpeg') }}" alt="Réparation">
        </div>
    </div>
</div>

<div class="container mt-4 mb-5">
    <div class="text-center mb-5">
        <h1 class="rep-page-title">Réparations disponibles pour le {{ modele.name }}</h1>
        <p class="rep-page-subtitle">Cochez les réparations souhaitées pour estimer votre devis, puis contactez-nous pour prendre rendez-vous.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            {% if reparations is not empty %}
                <p class="section-label">Réparations spécifiques au modèle</p>
                {% for reparation in reparations %}
                    <div class="rep-card" onclick="toggleCheck(this)">
                        <div class="rep-info">
                            <div class="rep-name">{{ reparation.name }}</div>
                            {% if reparation.description %}
                                <p class="rep-desc">{{ reparation.description }}</p>
                            {% endif %}
                        </div>
                        <div class="rep-right">
                            <span class="rep-price {{ reparation.prix == 0 ? 'free' : '' }}">
                                {{ reparation.prix == 0 ? 'Gratuit' : reparation.prix ~ ' € TTC' }}
                            </span>
                            <input type="checkbox" class="rep-checkbox reparation-checkbox" data-price="{{ reparation.prix }}" onclick="event.stopPropagation()">
                        </div>
                    </div>
                {% endfor %}
                <hr class="section-divider">
            {% endif %}

            <p class="section-label">Services communs</p>
            {% set predefined_reparations = [
                {'name': 'Tiroir SIM', 'description': 'Sur commande en 24h-48h.', 'prix': 10},
                {'name': 'Désoxydation', 'description': 'Résultat en 24h-48h selon les dégâts.', 'prix': 49},
                {'name': 'Transfert de données', 'description': 'Le temps varie selon l\'espace disque.', 'prix': 19},
                {'name': 'Diagnostique', 'description': 'Réalisé directement en boutique.', 'prix': 0}
            ] %}
            {% for reparation in predefined_reparations %}
                <div class="rep-card" onclick="toggleCheck(this)">
                    <div class="rep-info">
                        <div class="rep-name">{{ reparation.name }}</div>
                        <p class="rep-desc">{{ reparation.description }}</p>
                    </div>
                    <div class="rep-right">
                        <span class="rep-price {{ reparation.prix == 0 ? 'free' : '' }}">
                            {{ reparation.prix == 0 ? 'Gratuit' : reparation.prix ~ ' € TTC' }}
                        </span>
                        <input type="checkbox" class="rep-checkbox reparation-checkbox" data-price="{{ reparation.prix }}" onclick="event.stopPropagation()">
                    </div>
                </div>
            {% endfor %}

            {# Total bar #}
            <div class="total-bar mt-4">
                <div>
                    <div class="total-label">Estimation totale (TTC)</div>
                    <div class="total-amount"><span id="total-price">0.00</span> €</div>
                </div>
                <a href="{{ path('contact') }}" class="btn-rdv">
                    <i class="fas fa-calendar-alt mr-2"></i> Prendre rendez-vous
                </a>
            </div>

        </div>
    </div>
</div>

{# Contact #}
<div class="container contact-section mt-5 mb-5">
    <div class="row justify-content-center text-center mb-3">
        <div class="col-12">
            <p id="pDoute" class="mb-3">Vous ne trouvez pas votre réparation ou avez un doute sur la panne ?</p>
        </div>
        <div class="col-md-3 mt-3 d-flex flex-column align-items-center">
            <p>Contactez-nous par mail</p>
            <a href="{{ path('contact') }}" id="contactezNous" class="btn btn-outline-primary btn-contact mb-5">Contactez-nous</a>
        </div>
        <div class="col-md-1 d-flex align-items-center justify-content-center">
            <p class="font-weight-bold">OU</p>
        </div>
        <div class="col-md-3 mt-3 d-flex flex-column align-items-center">
            <p>par téléphone</p>
            <a class="btn btn-outline-primary btn-contact" id="contactezNous" href="tel:+33783748311">07 83 74 83 11</a>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function toggleCheck(card) {
    const checkbox = card.querySelector('.reparation-checkbox');
    checkbox.checked = !checkbox.checked;
    card.classList.toggle('selected', checkbox.checked);
    updateTotal();
}

document.querySelectorAll('.reparation-checkbox').forEach(cb => {
    cb.addEventListener('change', function() {
        this.closest('.rep-card').classList.toggle('selected', this.checked);
        updateTotal();
    });
});

function updateTotal() {
    let total = 0;
    document.querySelectorAll('.reparation-checkbox:checked').forEach(cb => {
        total += parseFloat(cb.getAttribute('data-price'));
    });
    document.getElementById('total-price').textContent = total.toFixed(2);
}
</script>
{% endblock %}
