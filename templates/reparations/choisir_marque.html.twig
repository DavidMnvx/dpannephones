{% extends 'base.html.twig' %}

{% block title %}Choix de la marque — D'Panne Phones{% endblock %}

{% block body %}

{% include 'reparations/_hero_reparation.html.twig' with {
    step: 2,
    type: type,
    title: 'Choisissez votre marque',
    subtitle: 'Sélectionnez la marque de votre ' ~ (type == 'tablet' ? 'tablette' : 'téléphone') ~ ' — nous vous afficherons tous les modèles disponibles.',
    breadcrumb: [
        { label: 'Réparation', url: path('reparations_home') },
        { label: 'Marques' }
    ]
} %}

<div class="rep-container">

    {% if marques is empty %}
        <div class="rep-empty">
            <i class="fas fa-tags"></i>
            <h3>Aucune marque disponible</h3>
            <p>Contactez-nous pour nous signaler votre appareil — nous ajoutons régulièrement de nouvelles marques.</p>
            <a href="{{ path('contact') }}" class="rep-empty-btn">
                <i class="fas fa-envelope mr-1"></i> Nous contacter
            </a>
        </div>
    {% else %}
        <div class="rep-brands-grid">
            {% for marque in marques %}
                <a href="{{ path('choix_modele', {'marqueId': marque.id, 'type': type}) }}"
                   class="rep-brand-card"
                   style="animation-delay: {{ (loop.index0 * 0.05) }}s;">
                    <div class="rep-brand-img">
                        {% if marque.image %}
                            <img src="{{ asset('uploads/images/' ~ marque.image) }}" alt="{{ marque.name }}" loading="lazy">
                        {% else %}
                            <i class="fas fa-mobile-alt"></i>
                        {% endif %}
                    </div>
                    <div class="rep-brand-name">{{ marque.name }}</div>
                    <div class="rep-brand-arrow">
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {# Bloc aide / contact #}
    <div class="rep-help-box">
        <div class="rep-help-icon">
            <i class="fas fa-comments"></i>
        </div>
        <div class="rep-help-content">
            <strong>Vous ne trouvez pas votre marque ?</strong>
            <p>Nous travaillons sur de nombreuses autres marques — contactez-nous pour nous décrire votre appareil.</p>
            <div class="rep-help-actions">
                <a href="{{ path('contact') }}" class="rep-help-btn">
                    <i class="fas fa-envelope mr-1"></i> Nous écrire
                </a>
                <a href="tel:+33783748311" class="rep-help-btn rep-help-btn--phone">
                    <i class="fas fa-phone mr-1"></i> 07 83 74 83 11
                </a>
            </div>
        </div>
    </div>

</div>

{% endblock %}
