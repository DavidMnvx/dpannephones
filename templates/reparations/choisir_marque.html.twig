{% extends 'base.html.twig' %}

{% block title %}Choix de la marque {% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}

{# Banière #}

<div id="carouselExampleIndicators2"  class="carousel slide mb-5" data-ride="carousel" data-interval="4000" >
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset('images/reparation/reparation_mobile2.jpeg') }}" alt="First slide">
            <div class="carousel-caption">
                <h5 id="uneRep" >Une Réparation ?</h5>

            </div>
        </div>
    </div>
</div>

{# Banière #}

{# card section marques #}

<div class="container mt-5 mb-2 text-center">
    <h1 class="marques-title">Quelle est la marque de votre appareil ?</h1>
    <p class="marques-subtitle">Sélectionnez votre marque ci-dessous — nous vous afficherons toutes les réparations disponibles pour votre modèle.</p>
</div>

<div class="container mt-5 pt-3">
    {% if marques is empty %}
        <p class="text-center text-muted">Aucune marque disponible pour ce type d'appareil.</p>
    {% else %}
        <div class="marques-grid">
            {% for marque in marques %}
                <a href="{{ path('choix_modele', {'marqueId': marque.id, 'type': type}) }}"
                   class="marque-card reveal delay-{{ loop.index <= 4 ? loop.index : 4 }}"
                   style="width:100%;max-width:180px;">
                    {% if marque.image %}
                        <img src="{{ asset('uploads/images/' ~ marque.image) }}" alt="{{ marque.name }}">
                    {% else %}
                        <div style="height:70px; display:flex; align-items:center; justify-content:center;">
                            <i class="fas fa-mobile-alt fa-2x" style="color:#dee2e6;"></i>
                        </div>
                    {% endif %}
                    <span>{{ marque.name }}</span>
                </a>
            {% endfor %}
        </div>
    {% endif %}
</div>

{# card section marques #}

{# contact #}

<div class="container contact-section mt-5 mb-5">
    <div class="row justify-content-center text-center mb-3">
        <div class="col-12">
            <p id="pDoute" class="mb-3">Vous ne trouvez pas votre marque ou vous avez un doute sur la panne ?</p>
        </div>
        <div class="col-md-3 mt-5 d-flex flex-column align-items-center">
            <p>Contactez nous par mail</p>
            <a href="{{ path('contact') }}" id="contactezNous" class="btn btn-outline-primary btn-contact mb-5">Contactez nous</a>
        </div>
        <div class="col-md-1 d-flex align-items-center justify-content-center">
            <p class="font-weight-bold">OU</p>
        </div>
        <div class="col-md-3 mt-5 d-flex flex-column align-items-center">
            <p>par téléphone</p>
            <a class="btn btn-outline-primary btn-contact" id="contactezNous" href="tel:+33783748311">07 83 74 83 11</a>
        </div>
    </div>
</div>

{# contact #}



{% endblock %}
