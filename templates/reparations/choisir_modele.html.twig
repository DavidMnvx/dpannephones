{% extends 'base.html.twig' %}

{% block title %}Modèles {{ marque.name }} — D'Panne Phones{% endblock %}

{% block body %}

{% include 'reparations/_hero_reparation.html.twig' with {
    step: 3,
    type: type,
    title: 'Choisissez votre modèle ' ~ marque.name,
    subtitle: 'Sélectionnez votre modèle exact pour découvrir les réparations disponibles et leurs tarifs.',
    breadcrumb: [
        { label: 'Réparation', url: path('reparations_home') },
        { label: 'Marques',    url: path('choix_marque', {type: type}) },
        { label: marque.name }
    ]
} %}

<div class="rep-container">

    {# Marque sélectionnée — bandeau récap #}
    <div class="rep-context-bar">
        <div class="rep-context-brand">
            {% if marque.image %}
                <img src="{{ asset('uploads/images/' ~ marque.image) }}" alt="{{ marque.name }}">
            {% endif %}
            <div>
                <small>Marque sélectionnée</small>
                <strong>{{ marque.name }}</strong>
            </div>
        </div>
        <a href="{{ path('choix_marque', {type: type}) }}" class="rep-context-change">
            <i class="fas fa-exchange-alt mr-1"></i> Changer de marque
        </a>
    </div>

    {# ─── Filtre rapide (recherche live dans la liste) ─── #}
    {% if modeles|length > 6 %}
        <div class="rep-filter-box">
            <i class="fas fa-search rep-filter-icon"></i>
            <input type="text" id="repModelFilter" class="rep-filter-input"
                   placeholder="Filtrer dans la liste — ex: S22, Note, A20..."
                   autocomplete="off" aria-label="Filtrer les modèles">
            <button type="button" id="repModelFilterClear" class="rep-filter-clear" aria-label="Effacer" hidden>&times;</button>
        </div>
        <style>
            .rep-filter-box {
                position: relative;
                margin: 0 0 18px;
                display: flex;
                align-items: center;
            }
            .rep-filter-icon {
                position: absolute;
                left: 16px;
                color: #94a3b8;
                font-size: 14px;
                pointer-events: none;
            }
            .rep-filter-input {
                width: 100%;
                padding: 12px 44px;
                border: 2px solid #e2e8f0;
                border-radius: 10px;
                font-size: 14px;
                background: #fff;
                outline: none;
                transition: all .2s;
            }
            .rep-filter-input:focus {
                border-color: rgb(9, 71, 113);
                box-shadow: 0 0 0 3px rgba(9, 71, 113, 0.08);
            }
            .rep-filter-clear {
                position: absolute;
                right: 12px;
                background: #e2e8f0;
                border: 0;
                width: 24px;
                height: 24px;
                border-radius: 50%;
                cursor: pointer;
                font-size: 16px;
                line-height: 1;
                color: #475569;
            }
            .rep-filter-clear:hover { background: #cbd5e1; }
            .rep-empty-filter {
                text-align: center;
                padding: 30px 16px;
                color: #64748b;
                font-size: 14px;
                grid-column: 1 / -1;
            }
        </style>
    {% endif %}

    {% if modeles is empty %}
        <div class="rep-empty">
            <i class="fas fa-microchip"></i>
            <h3>Aucun modèle enregistré pour {{ marque.name }}</h3>
            <p>Décrivez-nous votre modèle — nous faisons toutes les marques en boutique.</p>
            <a href="{{ path('contact') }}" class="rep-empty-btn">
                <i class="fas fa-envelope mr-1"></i> Nous contacter
            </a>
        </div>
    {% elseif hasFamilles %}
        {# ─── Affichage avec sous-catégories (Série A, Série S…) ─── #}
        <div class="rep-famille-tabs" role="tablist">
            <button type="button" class="rep-famille-tab is-active" data-famille="__all__" role="tab" aria-selected="true">
                <i class="fas fa-th-large mr-1"></i> Tous
                <span class="rep-famille-count">{{ modeles|length }}</span>
            </button>
            {% for famille, list in modelesByFamille %}
                <button type="button" class="rep-famille-tab" data-famille="{{ famille|e('html_attr') }}" role="tab" aria-selected="false">
                    {{ famille }}
                    <span class="rep-famille-count">{{ list|length }}</span>
                </button>
            {% endfor %}
        </div>

        <div class="rep-models-grid" id="repModelsGrid">
            {% for famille, list in modelesByFamille %}
                {% for model in list %}
                    <a href="{{ path('liste_reparations', {'modeleName': model.name, 'type': type == 'phone' ? 'phone' : 'tablet'}) }}"
                       class="rep-model-card"
                       data-famille="{{ famille|e('html_attr') }}"
                       style="animation-delay: {{ (loop.index0 * 0.03) }}s;">
                        <div class="rep-model-img">
                            {% if model.image %}
                                <img src="{{ asset('uploads/images/' ~ model.image) }}" alt="{{ model.name }}" loading="lazy">
                            {% else %}
                                <i class="fas fa-mobile-alt"></i>
                            {% endif %}
                        </div>
                        <div class="rep-model-info">
                            <div class="rep-model-brand">{{ marque.name }}{% if famille != 'Autres' %} · {{ famille }}{% endif %}</div>
                            <div class="rep-model-name">{{ model.name }}</div>
                            <div class="rep-model-cta">
                                Voir les réparations <i class="fas fa-arrow-right"></i>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            {% endfor %}
        </div>
    {% else %}
        {# ─── Affichage plat (comportement historique, ex: Apple) ─── #}
        <div class="rep-models-grid">
            {% for model in modeles %}
                <a href="{{ path('liste_reparations', {'modeleName': model.name, 'type': type == 'phone' ? 'phone' : 'tablet'}) }}"
                   class="rep-model-card"
                   style="animation-delay: {{ (loop.index0 * 0.03) }}s;">
                    <div class="rep-model-img">
                        {% if model.image %}
                            <img src="{{ asset('uploads/images/' ~ model.image) }}" alt="{{ model.name }}" loading="lazy">
                        {% else %}
                            <i class="fas fa-mobile-alt"></i>
                        {% endif %}
                    </div>
                    <div class="rep-model-info">
                        <div class="rep-model-brand">{{ marque.name }}</div>
                        <div class="rep-model-name">{{ model.name }}</div>
                        <div class="rep-model-cta">
                            Voir les réparations <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {# ─── JS du filtre rapide (marche pour affichage plat ET avec familles) ─── #}
    {% if modeles|length > 6 %}
    <script>
        (function () {
            var input    = document.getElementById('repModelFilter');
            var clearBtn = document.getElementById('repModelFilterClear');
            if (!input) return;

            // Toutes les cards à filtrer (qu'on soit en mode familles ou plat)
            var cards = document.querySelectorAll('.rep-model-card');
            // Conteneur grid pour insérer un message "aucun résultat"
            var grid  = document.querySelector('.rep-models-grid');

            function applyFilter() {
                var q     = input.value.trim().toLowerCase();
                clearBtn.hidden = (q.length === 0);

                // Onglet famille actif (si présent)
                var activeFamille = null;
                var activeTab = document.querySelector('.rep-famille-tab.is-active');
                if (activeTab) activeFamille = activeTab.getAttribute('data-famille');

                var visibleCount = 0;
                cards.forEach(function (card) {
                    var name = (card.querySelector('.rep-model-name') || {}).textContent || '';
                    var matchText = q === '' || name.toLowerCase().indexOf(q) !== -1;

                    var matchFamille = true;
                    if (activeFamille && activeFamille !== '__all__') {
                        matchFamille = (card.getAttribute('data-famille') === activeFamille);
                    }

                    var visible = matchText && matchFamille;
                    card.style.display = visible ? '' : 'none';
                    if (visible) visibleCount++;
                });

                // Message "aucun résultat" dans la grille
                var existingMsg = grid && grid.querySelector('.rep-empty-filter');
                if (visibleCount === 0 && q.length > 0) {
                    if (!existingMsg && grid) {
                        var div = document.createElement('div');
                        div.className   = 'rep-empty-filter';
                        div.innerHTML   = '<i class="fas fa-search mr-1"></i> Aucun modèle ne correspond à <strong>« ' + q.replace(/[<>]/g, '') + ' »</strong>.';
                        grid.appendChild(div);
                    }
                } else if (existingMsg) {
                    existingMsg.remove();
                }
            }

            input.addEventListener('input', applyFilter);
            clearBtn.addEventListener('click', function () {
                input.value = '';
                applyFilter();
                input.focus();
            });

            // Quand on clique un onglet famille, on relance le filtre pour combiner les 2 critères
            document.querySelectorAll('.rep-famille-tab').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    // léger délai pour laisser l'onglet s'activer d'abord
                    setTimeout(applyFilter, 0);
                });
            });
        })();
    </script>
    {% endif %}

    {# ─── Styles & JS pour les onglets de famille ─── #}
    {% if hasFamilles %}
        <style>
            .rep-famille-tabs {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin: 18px 0 24px;
                padding: 10px;
                background: #f8fafc;
                border-radius: 12px;
                border: 1px solid #e2e8f0;
            }
            .rep-famille-tab {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 9px 16px;
                border: 2px solid #e2e8f0;
                background: #fff;
                color: #475569;
                font-size: 14px;
                font-weight: 600;
                border-radius: 10px;
                cursor: pointer;
                transition: all .2s;
            }
            .rep-famille-tab:hover {
                border-color: rgb(9, 71, 113);
                color: rgb(9, 71, 113);
            }
            .rep-famille-tab.is-active {
                background: rgb(9, 71, 113);
                border-color: rgb(9, 71, 113);
                color: #fff;
            }
            .rep-famille-count {
                background: rgba(255, 255, 255, .25);
                color: inherit;
                padding: 1px 8px;
                border-radius: 10px;
                font-size: 12px;
                font-weight: 700;
            }
            .rep-famille-tab:not(.is-active) .rep-famille-count {
                background: #e2e8f0;
                color: #64748b;
            }
        </style>
        <script>
            (function () {
                var tabs = document.querySelectorAll('.rep-famille-tab');

                tabs.forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        // Activer l'onglet cliqué (visuel) — le filtre des cards
                        // est géré par le script "filter rapide" plus haut, ou par
                        // ce script si pas de filtre texte présent.
                        tabs.forEach(function (t) {
                            t.classList.remove('is-active');
                            t.setAttribute('aria-selected', 'false');
                        });
                        tab.classList.add('is-active');
                        tab.setAttribute('aria-selected', 'true');

                        // Si pas de filtre texte (≤ 6 modèles), on filtre ici directement
                        if (!document.getElementById('repModelFilter')) {
                            var target = tab.getAttribute('data-famille');
                            document.querySelectorAll('.rep-model-card[data-famille]').forEach(function (card) {
                                var visible = (target === '__all__' || card.getAttribute('data-famille') === target);
                                card.style.display = visible ? '' : 'none';
                            });
                        }
                    });
                });
            })();
        </script>
    {% endif %}

    <div class="rep-help-box">
        <div class="rep-help-icon"><i class="fas fa-search"></i></div>
        <div class="rep-help-content">
            <strong>Vous ne trouvez pas votre modèle exact ?</strong>
            <p>Notre équipe peut identifier votre appareil à partir de son numéro de modèle — contactez-nous.</p>
            <div class="rep-help-actions">
                <a href="{{ path('contact') }}" class="rep-help-btn">
                    <i class="fas fa-envelope mr-1"></i> Nous écrire
                </a>
                <a href="tel:+33783748311" class="rep-help-btn rep-help-btn--phone">
                    <i class="fas fa-phone mr-1"></i> 07 83 74 83 11
                </a>
            </div>
        </div>
    </div>

</div>

{% endblock %}
