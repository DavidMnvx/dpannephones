{% extends 'base.html.twig' %}

{% block title %}Modèles {{ marque.name }} — D'Panne Phones{% endblock %}

{% block body %}

{% include 'reparations/_hero_reparation.html.twig' with {
    step: 3,
    type: type,
    title: 'Choisissez votre modèle ' ~ marque.name,
    subtitle: 'Sélectionnez votre modèle exact pour découvrir les réparations disponibles et leurs tarifs.',
    breadcrumb: [
        { label: 'Réparation', url: path('reparations_home') },
        { label: 'Marques',    url: path('choix_marque', {type: type}) },
        { label: marque.name }
    ]
} %}

<div class="rep-container">

    {# Marque sélectionnée — bandeau récap #}
    <div class="rep-context-bar">
        <div class="rep-context-brand">
            {% if marque.image %}
                <img src="{{ asset('uploads/images/' ~ marque.image) }}" alt="{{ marque.name }}">
            {% endif %}
            <div>
                <small>Marque sélectionnée</small>
                <strong>{{ marque.name }}</strong>
            </div>
        </div>
        <a href="{{ path('choix_marque', {type: type}) }}" class="rep-context-change">
            <i class="fas fa-exchange-alt mr-1"></i> Changer de marque
        </a>
    </div>

    {% if modeles is empty %}
        <div class="rep-empty">
            <i class="fas fa-microchip"></i>
            <h3>Aucun modèle enregistré pour {{ marque.name }}</h3>
            <p>Décrivez-nous votre modèle — nous faisons toutes les marques en boutique.</p>
            <a href="{{ path('contact') }}" class="rep-empty-btn">
                <i class="fas fa-envelope mr-1"></i> Nous contacter
            </a>
        </div>
    {% elseif hasFamilles %}
        {# ─── Affichage avec sous-catégories (Série A, Série S…) ─── #}
        <div class="rep-famille-tabs" role="tablist">
            <button type="button" class="rep-famille-tab is-active" data-famille="__all__" role="tab" aria-selected="true">
                <i class="fas fa-th-large mr-1"></i> Tous
                <span class="rep-famille-count">{{ modeles|length }}</span>
            </button>
            {% for famille, list in modelesByFamille %}
                <button type="button" class="rep-famille-tab" data-famille="{{ famille|e('html_attr') }}" role="tab" aria-selected="false">
                    {{ famille }}
                    <span class="rep-famille-count">{{ list|length }}</span>
                </button>
            {% endfor %}
        </div>

        <div class="rep-models-grid" id="repModelsGrid">
            {% for famille, list in modelesByFamille %}
                {% for model in list %}
                    <a href="{{ path('liste_reparations', {'modeleName': model.name, 'type': type == 'phone' ? 'phone' : 'tablet'}) }}"
                       class="rep-model-card"
                       data-famille="{{ famille|e('html_attr') }}"
                       style="animation-delay: {{ (loop.index0 * 0.03) }}s;">
                        <div class="rep-model-img">
                            {% if model.image %}
                                <img src="{{ asset('uploads/images/' ~ model.image) }}" alt="{{ model.name }}" loading="lazy">
                            {% else %}
                                <i class="fas fa-mobile-alt"></i>
                            {% endif %}
                        </div>
                        <div class="rep-model-info">
                            <div class="rep-model-brand">{{ marque.name }}{% if famille != 'Autres' %} · {{ famille }}{% endif %}</div>
                            <div class="rep-model-name">{{ model.name }}</div>
                            <div class="rep-model-cta">
                                Voir les réparations <i class="fas fa-arrow-right"></i>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            {% endfor %}
        </div>
    {% else %}
        {# ─── Affichage plat (comportement historique, ex: Apple) ─── #}
        <div class="rep-models-grid">
            {% for model in modeles %}
                <a href="{{ path('liste_reparations', {'modeleName': model.name, 'type': type == 'phone' ? 'phone' : 'tablet'}) }}"
                   class="rep-model-card"
                   style="animation-delay: {{ (loop.index0 * 0.03) }}s;">
                    <div class="rep-model-img">
                        {% if model.image %}
                            <img src="{{ asset('uploads/images/' ~ model.image) }}" alt="{{ model.name }}" loading="lazy">
                        {% else %}
                            <i class="fas fa-mobile-alt"></i>
                        {% endif %}
                    </div>
                    <div class="rep-model-info">
                        <div class="rep-model-brand">{{ marque.name }}</div>
                        <div class="rep-model-name">{{ model.name }}</div>
                        <div class="rep-model-cta">
                            Voir les réparations <i class="fas fa-arrow-right"></i>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {# ─── Styles & JS pour les onglets de famille ─── #}
    {% if hasFamilles %}
        <style>
            .rep-famille-tabs {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin: 18px 0 24px;
                padding: 10px;
                background: #f8fafc;
                border-radius: 12px;
                border: 1px solid #e2e8f0;
            }
            .rep-famille-tab {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 9px 16px;
                border: 2px solid #e2e8f0;
                background: #fff;
                color: #475569;
                font-size: 14px;
                font-weight: 600;
                border-radius: 10px;
                cursor: pointer;
                transition: all .2s;
            }
            .rep-famille-tab:hover {
                border-color: rgb(9, 71, 113);
                color: rgb(9, 71, 113);
            }
            .rep-famille-tab.is-active {
                background: rgb(9, 71, 113);
                border-color: rgb(9, 71, 113);
                color: #fff;
            }
            .rep-famille-count {
                background: rgba(255, 255, 255, .25);
                color: inherit;
                padding: 1px 8px;
                border-radius: 10px;
                font-size: 12px;
                font-weight: 700;
            }
            .rep-famille-tab:not(.is-active) .rep-famille-count {
                background: #e2e8f0;
                color: #64748b;
            }
            .rep-model-card.is-hidden {
                display: none !important;
            }
        </style>
        <script>
            (function () {
                var tabs = document.querySelectorAll('.rep-famille-tab');
                var cards = document.querySelectorAll('.rep-model-card[data-famille]');

                tabs.forEach(function (tab) {
                    tab.addEventListener('click', function () {
                        var target = tab.getAttribute('data-famille');

                        // Activer l'onglet cliqué
                        tabs.forEach(function (t) {
                            t.classList.remove('is-active');
                            t.setAttribute('aria-selected', 'false');
                        });
                        tab.classList.add('is-active');
                        tab.setAttribute('aria-selected', 'true');

                        // Filtrer les cards
                        cards.forEach(function (card) {
                            if (target === '__all__' || card.getAttribute('data-famille') === target) {
                                card.classList.remove('is-hidden');
                            } else {
                                card.classList.add('is-hidden');
                            }
                        });
                    });
                });
            })();
        </script>
    {% endif %}

    <div class="rep-help-box">
        <div class="rep-help-icon"><i class="fas fa-search"></i></div>
        <div class="rep-help-content">
            <strong>Vous ne trouvez pas votre modèle exact ?</strong>
            <p>Notre équipe peut identifier votre appareil à partir de son numéro de modèle — contactez-nous.</p>
            <div class="rep-help-actions">
                <a href="{{ path('contact') }}" class="rep-help-btn">
                    <i class="fas fa-envelope mr-1"></i> Nous écrire
                </a>
                <a href="tel:+33783748311" class="rep-help-btn rep-help-btn--phone">
                    <i class="fas fa-phone mr-1"></i> 07 83 74 83 11
                </a>
            </div>
        </div>
    </div>

</div>

{% endblock %}
