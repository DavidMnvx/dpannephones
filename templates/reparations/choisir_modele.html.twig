{% extends 'base.html.twig' %}

{% block title %}Choisir un Modèle pour {{ marque.name }}{% endblock %}

{% block body %}

{# Banière #}

<div id="carouselExampleIndicators" class="carousel slide mb-5" data-ride="carousel" data-interval="4000">
    
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset('images/reparation/reparation_mobile2.jpeg') }}" alt="First slide">
            <div class="carousel-caption">
                <h5 id="uneRep" >Une Réparation ?</h5>

            </div>
        </div>
    </div>
</div>

{# Banière #}

{# Card Model #}

<div class="container mt-4">
    <h1 class="text-center mb-5">Modèles pour {{ marque.name }}</h1>
    <div class="row">
        {% for model in modeles %}
            <div class="col-md-2 mb-3">
                <div class="card">
                    <a href="{{ path('liste_reparations', {'modeleName': model.name, 'type': type == 'phone' ? 'phone' : 'tablet'}) }}">
                        <img  src="{{ asset('uploads/images/' ~ model.image) }}" class="card-img-top " id="img-model" alt="Image de {{ model.name }}">
                        <div class="card-body text-center">
                    </a>
                            <h6 class="card-title">{{ model.name }}</h6>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{# Card Model #}

{% endblock %}