{# ── Schema.org FAQ (données structurées pour Google) ── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Mon écran est cassé, dois-je remplacer uniquement la vitre ou le bloc écran entier ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sur les smartphones récents, l'écran est une pièce composite solidaire. Le remplacement du bloc écran complet est nécessaire pour garantir un résultat optimal et durable."
      }
    },
    {
      "@type": "Question",
      "name": "Dois-je prendre rendez-vous pour ma réparation ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vous pouvez venir avec ou sans rendez-vous. Nous recommandons cependant d'appeler avant pour vérifier la disponibilité immédiate de la pièce."
      }
    },
    {
      "@type": "Question",
      "name": "Quelle est la durée de garantie sur les réparations ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Toutes nos réparations sont couvertes par une garantie de 6 mois sur la pièce remplacée et la main-d'œuvre."
      }
    },
    {
      "@type": "Question",
      "name": "Pouvez-vous débloquer un iPhone verrouillé par un compte iCloud ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Le déblocage est réservé au propriétaire légitime du compte Apple, sur présentation d'une preuve d'achat. Tout déblocage sans consentement du propriétaire est illégal et ne sera pas effectué."
      }
    }
  ]
}
</script>

