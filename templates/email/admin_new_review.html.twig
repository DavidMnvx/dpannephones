<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Nouvel avis à modérer — D'Panne Phones</title>
<style>
  body { margin:0; padding:0; background:#f4f6f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; }
  .wrapper { max-width:600px; margin:30px auto; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.08); }
  .header { background:linear-gradient(135deg, #7a2c8e 0%, #a855f7 100%); padding:28px 36px; text-align:center; color:#fff; }
  .header h1 { color:#fff; font-size:20px; margin:6px 0 4px; font-weight:800; }
  .eyebrow { display:inline-block; background:rgba(255,255,255,0.18); color:#fff; padding:5px 12px; border-radius:18px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; }
  .body { padding:26px 36px 18px; }
  .rating { font-size:28px; color:#f59e0b; letter-spacing:4px; text-align:center; margin:10px 0; }
  .author { text-align:center; color:#6b7280; margin-bottom:20px; font-size:13px; }
  .author strong { color:#1a2b4b; font-size:15px; }
  .review-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:18px 22px; margin-bottom:18px; }
  .review-title { font-size:17px; font-weight:800; color:#1a2b4b; margin:0 0 8px; }
  .review-text { font-size:14px; color:#374151; line-height:1.65; margin:0; white-space:pre-wrap; }
  .info-row { display:table; width:100%; padding:8px 0; font-size:13px; border-bottom:1px solid #f1f5f9; }
  .info-row:last-child { border-bottom:none; }
  .info-label { display:table-cell; color:#6b7280; font-weight:600; width:140px; font-size:12px; text-transform:uppercase; letter-spacing:0.04em; }
  .info-value { display:table-cell; color:#1a2b4b; font-weight:600; }
  .cta-row { text-align:center; margin:22px 0 10px; }
  .cta { display:inline-block; background:rgb(9,71,113); color:#fff !important; text-decoration:none !important; padding:13px 28px; border-radius:8px; font-weight:700; font-size:14px; margin:0 4px; }
  .cta--approve { background:#16a34a; }
  .cta--reject { background:#fff; color:#ef4444 !important; border:1px solid #fecaca; }
  .footer { background:#f8fafc; border-top:1px solid #e2e8f0; padding:16px 36px; text-align:center; font-size:11px; color:#9ca3af; line-height:1.7; }
</style>
</head>
<body>
<div class="wrapper">
  <div class="header">
    <div class="eyebrow">📝 À modérer</div>
    <h1>Nouvel avis client</h1>
  </div>

  <div class="body">
    <div class="rating">
      {% for i in 1..5 %}<span style="{{ i > review.rating ? 'color:#e5e7eb;' : '' }}">★</span>{% endfor %}
    </div>
    <div class="author">
      par <strong>{{ review.displayName }}</strong>{% if review.user %} ({{ review.user.email }}){% endif %}
    </div>

    <div class="review-box">
      <h2 class="review-title">{{ review.title }}</h2>
      <p class="review-text">{{ review.comment }}</p>
    </div>

    <div style="background:#f8fafc;border-radius:10px;padding:14px 20px;margin-bottom:16px;">
      <div class="info-row">
        <span class="info-label">Auteur réel</span>
        <span class="info-value">{{ review.user.prenom }} {{ review.user.nom }}</span>
      </div>
      <div class="info-row">
        <span class="info-label">Email</span>
        <span class="info-value">{{ review.user.email }}</span>
      </div>
      <div class="info-row">
        <span class="info-label">Affichage choisi</span>
        <span class="info-value">
          {% if review.displayNameChoice == 'full' %}Nom complet
          {% elseif review.displayNameChoice == 'initial' %}Prénom + initiale
          {% elseif review.displayNameChoice == 'firstname' %}Prénom seul
          {% else %}Anonyme{% endif %}
        </span>
      </div>
      {% if review.commande %}
        <div class="info-row">
          <span class="info-label">Commande</span>
          <span class="info-value">#{{ review.commande.id }} ({{ review.commande.total|number_format(2, ',', ' ') }} €) — ✅ Vérifié</span>
        </div>
      {% endif %}
      <div class="info-row">
        <span class="info-label">Date</span>
        <span class="info-value">{{ review.createdAt|date('d/m/Y à H:i') }}</span>
      </div>
    </div>

    <div class="cta-row">
      <a href="https://dpannephones.com/admin/avis-clients" class="cta">
        📋 Modérer les avis
      </a>
    </div>

    <p style="font-size:12px;color:#9ca3af;text-align:center;margin-top:20px;">
      L'avis ne sera visible sur le site qu'après votre approbation.
    </p>
  </div>

  <div class="footer">
    <strong>D'Panne Phones</strong> — Notification interne
  </div>
</div>
</body>
</html>
