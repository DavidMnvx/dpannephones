<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nouvelle commande #{{ commande.id }} — D'Panne Phones</title>
<style>
  body { margin:0; padding:0; background:#f4f6f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; }
  .wrapper { max-width:640px; margin:30px auto; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.08); }

  .header { background:linear-gradient(135deg, #0a1f3a 0%, rgb(9,71,113) 100%); padding:30px 40px; text-align:center; position:relative; }
  .header h1 { color:#fff; font-size:22px; margin:10px 0 4px; font-weight:800; letter-spacing:-0.01em; }
  .header p { color:rgba(255,255,255,0.75); font-size:13px; margin:0; }
  .eyebrow { display:inline-block; background:rgba(251,191,36,0.2); color:#fbbf24; padding:5px 14px; border-radius:20px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; border:1px solid rgba(251,191,36,0.3); }

  .total-banner { background:#16a34a; color:#fff; text-align:center; padding:18px 20px; }
  .total-banner .label { font-size:12px; text-transform:uppercase; letter-spacing:0.1em; opacity:0.85; font-weight:600; }
  .total-banner .amount { font-size:30px; font-weight:900; margin-top:4px; }

  .body { padding:28px 40px 20px; }

  .order-meta { display:table; width:100%; margin-bottom:22px; padding-bottom:16px; border-bottom:1px solid #eef2f6; }
  .meta-col { display:table-cell; vertical-align:top; }
  .meta-label { font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:#9ca3af; font-weight:700; margin-bottom:4px; }
  .meta-value { font-size:14px; color:#1a2b4b; font-weight:700; }

  .section-title { font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:0.1em; color:#9ca3af; margin:22px 0 12px; }

  .client-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px 20px; margin-bottom:20px; }
  .client-row { padding:5px 0; font-size:14px; color:#1a2b4b; }
  .client-row strong { display:inline-block; width:92px; color:#6b7280; font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:0.04em; }
  .client-row a { color:rgb(9,71,113); text-decoration:none; font-weight:700; }

  .items-table { width:100%; border-collapse:collapse; margin-bottom:10px; }
  .items-table thead th { font-size:11px; font-weight:700; text-transform:uppercase; color:#9ca3af; padding:8px 4px; border-bottom:2px solid #e2e8f0; text-align:left; letter-spacing:0.04em; }
  .items-table thead th.right { text-align:right; }
  .items-table tbody td { padding:12px 4px; font-size:14px; color:#374151; border-bottom:1px solid #f1f5f9; }
  .items-table tbody td.right { text-align:right; font-weight:700; color:#1a2b4b; }
  .items-table tbody tr:last-child td { border-bottom:none; }
  .item-name { font-weight:700; color:#1a2b4b; }
  .item-cat { font-size:11px; color:#9ca3af; margin-top:2px; text-transform:uppercase; letter-spacing:0.04em; font-weight:600; }

  .totals-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:14px 20px; margin-top:14px; }
  .totals-row { display:table; width:100%; padding:4px 0; font-size:13px; color:#6b7280; }
  .totals-row > span { display:table-cell; }
  .totals-row > span:last-child { text-align:right; color:#374151; font-weight:600; }
  .totals-row--final { border-top:2px solid #e2e8f0; margin-top:8px; padding-top:10px; font-size:16px; color:#1a2b4b !important; font-weight:800; }
  .totals-row--final > span:last-child { color:rgb(9,71,113) !important; font-size:18px; }

  .shipping-box { background:#eff6fb; border:1px solid rgba(9,71,113,0.15); border-left:3px solid rgb(9,71,113); border-radius:10px; padding:14px 18px; margin-bottom:20px; }
  .shipping-box strong { color:rgb(9,71,113); font-size:13px; display:block; margin-bottom:2px; }
  .shipping-box span { font-size:13px; color:#475569; }

  .cta { text-align:center; margin:26px 0 10px; }
  .cta a { display:inline-block; background:rgb(9,71,113); color:#fff !important; text-decoration:none !important; padding:14px 30px; border-radius:8px; font-weight:700; font-size:14px; box-shadow:0 3px 10px rgba(9,71,113,0.25); }

  .footer { background:#f8fafc; border-top:1px solid #e2e8f0; padding:18px 40px; text-align:center; font-size:11px; color:#9ca3af; line-height:1.8; }
  .footer strong { color:#6b7280; }
</style>
</head>
<body>
<div class="wrapper">

  {# ── Header ── #}
  <div class="header">
    <div class="eyebrow">🛒 Nouvelle commande</div>
    <h1>Commande #{{ commande.id }}</h1>
    <p>Paiement reçu · {{ commande.createdAt|date('d/m/Y à H:i') }}</p>
  </div>

  {# ── Bandeau total ── #}
  <div class="total-banner">
    <div class="label">Montant total encaissé</div>
    <div class="amount">{{ commande.total|number_format(2, ',', ' ') }} €</div>
  </div>

  <div class="body">

    {# ── Meta commande ── #}
    <div class="order-meta">
      <div class="meta-col">
        <div class="meta-label">N° commande</div>
        <div class="meta-value">#{{ commande.id }}</div>
      </div>
      <div class="meta-col">
        <div class="meta-label">Date</div>
        <div class="meta-value">{{ commande.createdAt|date('d/m/Y H:i') }}</div>
      </div>
      <div class="meta-col">
        <div class="meta-label">Statut</div>
        <div class="meta-value" style="color:#16a34a;">✓ Payée</div>
      </div>
    </div>

    {# ── Informations client ── #}
    <div class="section-title">👤 Client</div>
    <div class="client-box">
      {% if commande.user %}
        <div class="client-row">
          <strong>Nom</strong>
          {{ commande.user.prenom }} {{ commande.user.nom }}
        </div>
        <div class="client-row">
          <strong>Email</strong>
          <a href="mailto:{{ commande.user.email }}">{{ commande.user.email }}</a>
        </div>
        {% if commande.user.telephone is defined and commande.user.telephone %}
          <div class="client-row">
            <strong>Téléphone</strong>
            <a href="tel:{{ commande.user.telephone }}">{{ commande.user.telephone }}</a>
          </div>
        {% endif %}
      {% else %}
        <div class="client-row" style="color:#9ca3af;font-style:italic;">
          Commande invité (pas de compte créé)
        </div>
      {% endif %}
    </div>

    {# ── Livraison ── #}
    {% if commande.shippingMode %}
      <div class="section-title">🚚 Livraison</div>
      <div class="shipping-box">
        <strong>
          {{ commande.transporteur ?? commande.shippingMode }}
          {% if commande.shippingCost == 0 %}· Gratuit{% else %}· {{ commande.shippingCost|number_format(2, ',', ' ') }} €{% endif %}
        </strong>
        <span>
          {% if commande.shippingMode == 'retrait' %}
            Le client viendra retirer sa commande en boutique.
          {% else %}
            Préparer le colis et expédier dès que possible.
          {% endif %}
        </span>
      </div>
    {% endif %}

    {# ── Articles ── #}
    <div class="section-title">📦 Articles commandés ({{ commande.items|length }})</div>
    <table class="items-table">
      <thead>
        <tr>
          <th>Produit</th>
          <th class="right">Qté</th>
          <th class="right">P.U.</th>
          <th class="right">Total</th>
        </tr>
      </thead>
      <tbody>
        {% for item in commande.items %}
          <tr>
            <td>
              <div class="item-name">{{ item.articleName }}</div>
              {% if item.article and item.article.categorie %}
                <div class="item-cat">{{ item.article.categorie|replace({'_': ' '}) }}</div>
              {% endif %}
            </td>
            <td class="right">× {{ item.quantite }}</td>
            <td class="right">{{ item.prix|number_format(2, ',', ' ') }} €</td>
            <td class="right">{{ item.sousTotal|number_format(2, ',', ' ') }} €</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>

    {# ── Totaux ── #}
    {% set articlesTotal = commande.shippingCost is not null ? commande.total - commande.shippingCost : commande.total %}
    <div class="totals-box">
      <div class="totals-row">
        <span>Sous-total articles</span>
        <span>{{ articlesTotal|number_format(2, ',', ' ') }} €</span>
      </div>
      {% if commande.shippingCost is not null %}
        <div class="totals-row">
          <span>Livraison</span>
          <span>
            {% if commande.shippingCost > 0 %}
              {{ commande.shippingCost|number_format(2, ',', ' ') }} €
            {% else %}
              <span style="color:#16a34a;font-weight:700;">Gratuit</span>
            {% endif %}
          </span>
        </div>
      {% endif %}
      <div class="totals-row totals-row--final">
        <span>Total TTC</span>
        <span>{{ commande.total|number_format(2, ',', ' ') }} €</span>
      </div>
    </div>

    {# ── CTA ── #}
    <div class="cta">
      <a href="https://dpannephones.com/admin/commandes/{{ commande.id }}">
        📋 Voir la commande dans l'admin →
      </a>
    </div>

  </div>

  <div class="footer">
    <strong>D'Panne Phones</strong> — Notification interne<br>
    Cette commande doit être préparée et expédiée/retirée selon le mode choisi par le client
  </div>
</div>
</body>
</html>
