{% extends 'base.html.twig' %}

{% block title %}Le Blog — Conseils & Actualités — D'panne Phones Pélissanne{% endblock %}
{% block meta_description %}Le blog de D'panne Phones : conseils réparation, réparabilité, entretien de vos téléphones et PC — par notre atelier de Pélissanne.{% endblock %}
{% block og_title %}Le Blog — Conseils & Actualités — D'panne Phones{% endblock %}
{% block og_description %}Conseils réparation, réparabilité et entretien de vos appareils, par notre atelier de Pélissanne.{% endblock %}

{% block body %}

{# Bannière — même gabarit que les autres pages du site, image gérée dans Admin > Images du site.
   L'id carouselExampleIndicators2 est la convention du site : tout le style
   "bannière flottante" (largeur contenue, arrondis, voile, caption) y est accroché. #}
<div id="carouselExampleIndicators2" class="carousel slide mb-4" data-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset(site_image('banner_blog', 'images/baner/Boutique.png')) }}" alt="Le Blog D'panne Phones">
            <div class="carousel-caption">
                <h5 id="uneRep">Le Blog</h5>
            </div>
        </div>
    </div>
</div>

<div class="blog-wrap">

    <nav class="article-breadcrumb">
        <a href="{{ path('home') }}">Accueil</a>
        <span class="bc-sep">›</span>
        <span class="bc-current">Blog</span>
    </nav>

    <header class="blog-head">
        <p class="blog-sub">
            Réparation, réparabilité, entretien : les conseils de notre atelier de Pélissanne
            pour faire durer vos téléphones et vos PC.
        </p>
    </header>

    {# ── Recherche + tri ── #}
    <div class="blog-toolbar">
        <form method="get" action="{{ path('blog_index') }}" class="blog-search" role="search">
            <i class="fas fa-search"></i>
            <input type="search" name="q" value="{{ searchQuery|default('') }}"
                   placeholder="Rechercher un article…" aria-label="Rechercher un article">
            {% if currentSort|default(null) %}<input type="hidden" name="tri" value="{{ currentSort }}">{% endif %}
        </form>
        <div class="sort-bar" style="margin:0;">
            <label for="blogSort"><i class="fas fa-sort-amount-down"></i> Trier&nbsp;:</label>
            {# window.URL impératif : "URL" nu = document.URL (chaîne) dans un handler inline #}
            <select id="blogSort"
                    onchange="var u=new window.URL(window.location.href);u.searchParams.set('tri',this.value);window.location.assign(u.toString());">
                <option value="recents" {{ currentSort|default(null) not in ['anciens', 'alpha'] ? 'selected' }}>Plus récents</option>
                <option value="anciens" {{ currentSort|default(null) == 'anciens' ? 'selected' }}>Plus anciens</option>
                <option value="alpha" {{ currentSort|default(null) == 'alpha' ? 'selected' }}>Titre A → Z</option>
            </select>
        </div>
    </div>

    {% if searchQuery|default('') %}
        <p class="blog-search-info">
            {{ posts|length }} résultat{{ posts|length > 1 ? 's' : '' }} pour «&nbsp;{{ searchQuery }}&nbsp;»
            — <a href="{{ path('blog_index') }}">tout afficher</a>
        </p>
    {% endif %}

    {% if posts is empty %}
        <div class="blog-empty">
            <i class="fas fa-pen-nib"></i>
            {% if searchQuery|default('') %}
                <p>Aucun article ne correspond à cette recherche.</p>
            {% else %}
                <p>Les premiers articles arrivent bientôt.</p>
            {% endif %}
        </div>
    {% else %}

        {# ── À la une : le dernier article en grande carte (vue par défaut uniquement) ── #}
        {% set vedette = null %}
        {% if searchQuery|default('') == '' and currentSort|default(null) not in ['anciens', 'alpha'] and posts|length > 1 %}
            {% set vedette = posts|first %}
            <a href="{{ path('blog_show', {slug: vedette.slug}) }}" class="blog-featured">
                <div class="blog-featured-img">
                    {% if vedette.image %}
                        <img src="{{ asset('uploads/images/' ~ vedette.image) }}" alt="{{ vedette.title }}">
                    {% else %}
                        <div class="blog-card-noimg"><i class="fas fa-newspaper"></i></div>
                    {% endif %}
                </div>
                <div class="blog-featured-body">
                    <span class="blog-featured-badge"><i class="fas fa-star"></i> Dernier article</span>
                    {% if vedette.topicLabel %}<span class="blog-topic">{{ vedette.topicLabel }}</span>{% endif %}
                    <h2 class="blog-featured-title">{{ vedette.title }}</h2>
                    <p class="blog-featured-excerpt">
                        {% set resume = vedette.excerpt ?: vedette.content %}
                        {{ resume|length > 200 ? resume|slice(0, 200) ~ '…' : resume }}
                    </p>
                    <span class="blog-featured-foot">
                        <span class="blog-date"><i class="far fa-calendar-alt"></i> {{ vedette.publishedAt ? vedette.publishedAt|date('d/m/Y') : '' }}</span>
                        <span class="blog-readmore">Lire l'article <i class="fas fa-arrow-right"></i></span>
                    </span>
                </div>
            </a>
        {% endif %}

        <div class="blog-grid">
            {% for post in posts|filter(p => p != vedette) %}
                <article class="blog-card">
                    <a href="{{ path('blog_show', {slug: post.slug}) }}" class="blog-card-imglink">
                        {% if post.image %}
                            <img src="{{ asset('uploads/images/' ~ post.image) }}" alt="{{ post.title }}" loading="lazy">
                        {% else %}
                            <div class="blog-card-noimg"><i class="fas fa-newspaper"></i></div>
                        {% endif %}
                    </a>
                    <div class="blog-card-body">
                        {% if post.topicLabel %}
                            <span class="blog-topic">{{ post.topicLabel }}</span>
                        {% endif %}
                        <h2 class="blog-card-title">
                            <a href="{{ path('blog_show', {slug: post.slug}) }}">{{ post.title }}</a>
                        </h2>
                        <p class="blog-card-excerpt">
                            {% set resume = post.excerpt ?: post.content %}
                            {{ resume|length > 140 ? resume|slice(0, 140) ~ '…' : resume }}
                        </p>
                        <div class="blog-card-foot">
                            <span class="blog-date">
                                <i class="far fa-calendar-alt"></i>
                                {{ post.publishedAt ? post.publishedAt|date('d/m/Y') : '' }}
                            </span>
                            <a href="{{ path('blog_show', {slug: post.slug}) }}" class="blog-readmore">
                                Lire l'article <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}
