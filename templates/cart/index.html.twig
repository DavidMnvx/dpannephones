{% extends 'base.html.twig' %}

{% block title %}Mon Panier — D'Panne Phones{% endblock %}

{% block body %}

{# Bannière #}
<div id="carouselExampleIndicators2" class="carousel slide mb-5" data-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset(site_image('banner_cart', 'images/baner/Boutique.png')) }}" alt="Panier">
            <div class="carousel-caption">
                <h5 id="uneRep">Mon Panier</h5>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4 mb-5">

    {# Messages flash (erreur paiement, panier vide, etc.) #}
    {{ include('_partials/flashes.html.twig') }}

    {{ include('checkout/_steps.html.twig', { current: 1 }) }}

    <div class="cart-page-title"><i class="fas fa-shopping-cart mr-2" style="color:rgb(9,71,113)"></i> Mon Panier</div>
    <p style="font-size:14px;color:#6c757d;margin-bottom:28px;">
        {% if cart is not empty %}
            {{ cart|length }} article{{ cart|length > 1 ? 's' : '' }} dans votre panier
        {% endif %}
    </p>

    {% if cart is empty %}
        <div class="empty-cart">
            <i class="fas fa-shopping-basket"></i>
            <p>Votre panier est vide</p>
            <small>Ajoutez des articles depuis la boutique pour les retrouver ici.</small>
            <br><br>
            <a href="{{ path('boutique_index') }}" style="display:inline-block;background:rgb(9,71,113);color:white;padding:12px 28px;border-radius:10px;font-size:14px;font-weight:600;text-decoration:none;">
                <i class="fas fa-arrow-left mr-2"></i> Retour à la boutique
            </a>
        </div>
    {% else %}
        <div class="row">
            <div class="col-lg-8">
                <div class="cart-table-wrap">
                    <table class="cart-table">
                        <thead>
                            <tr>
                                <th>Article</th>
                                <th>Prix unitaire</th>
                                <th>Qté</th>
                                <th>Sous-total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for cartItem in cart %}
                                <tr>
                                    <td>
                                        <div style="display:flex;align-items:center;gap:14px;">
                                            {% if cartItem.article.image %}
                                                <img src="{{ asset('uploads/images/' ~ cartItem.article.image) }}" class="cart-product-img" alt="{{ cartItem.article.name }}">
                                            {% else %}
                                                <div class="cart-product-img" style="display:flex;align-items:center;justify-content:center;"><i class="fas fa-image" style="color:#dee2e6;font-size:20px;"></i></div>
                                            {% endif %}
                                            <div>
                                                <div class="cart-product-name">
                                                    {{ cartItem.article.name }}
                                                    {% if cartItem.options and cartItem.options.color is defined %}
                                                        <span class="cart-color-badge">{{ cartItem.options.color }}</span>
                                                    {% endif %}
                                                </div>
                                                {% if cartItem.options and cartItem.options.model is defined %}
                                                    <small class="d-block text-muted">Modèle : {{ cartItem.options.model }}</small>
                                                {% endif %}
                                                {% if cartItem.article.categorie %}
                                                    <div class="cart-product-cat">{{ cartItem.article.categorie|replace({'_': ' '})|capitalize }}</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td class="cart-price">{{ cartItem.article.price|number_format(2, ',', ' ') }} €</td>
                                    <td>
                                        <div class="cart-qty-ctrl">
                                            <a href="{{ path('cart_decrement', {id: cartItem.id}) }}"
                                               class="qty-btn qty-btn--minus"
                                               title="{{ cartItem.quantity == 1 ? 'Retirer l\'article' : 'En retirer un' }}">
                                                {% if cartItem.quantity == 1 %}
                                                    <i class="fas fa-trash-alt" style="font-size:11px;"></i>
                                                {% else %}
                                                    <i class="fas fa-minus"></i>
                                                {% endif %}
                                            </a>
                                            <span class="qty-value">{{ cartItem.quantity }}</span>
                                            <a href="{{ path('cart_increment', {id: cartItem.id}) }}"
                                               class="qty-btn qty-btn--plus"
                                               title="En ajouter un">
                                                <i class="fas fa-plus"></i>
                                            </a>
                                        </div>
                                    </td>
                                    <td class="cart-price">{{ (cartItem.article.price * cartItem.quantity)|number_format(2, ',', ' ') }} €</td>
                                    <td>
                                        {# Suppression directe, sans dialogue système : l'action est réversible en un clic depuis la boutique #}
                                        <a href="{{ path('cart_remove', {id: cartItem.id}) }}" class="btn-remove" title="Retirer l'article">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="cart-summary">

                    {# ── En-tête ticket ── #}
                    <div class="receipt-header">
                        <i class="fas fa-receipt mr-2" style="color:rgb(9,71,113);"></i>
                        Récapitulatif de commande
                    </div>

                    {# ── Lignes articles ── #}
                    <div class="receipt-items">
                        {% for cartItem in cart %}
                            {% set lineTotal = cartItem.article.price * cartItem.quantity %}
                            <div class="receipt-item">
                                <div class="receipt-item-name">
                                    {{ cartItem.article.name }}
                                    {% if cartItem.options and cartItem.options.color is defined %}
                                        <small class="receipt-item-option">{{ cartItem.options.color }}</small>
                                    {% endif %}
                                    {% if cartItem.options and cartItem.options.model is defined %}
                                        <small class="receipt-item-option">{{ cartItem.options.model }}</small>
                                    {% endif %}
                                </div>
                                <div class="receipt-item-right">
                                    <span class="receipt-item-qty">× {{ cartItem.quantity }}</span>
                                    <span class="receipt-item-price">{{ lineTotal|number_format(2, ',', ' ') }} €</span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {# ── Calculs TVA ── #}
                    {% set subtotalHT = subtotal / 1.20 %}
                    {% set subtotalTVA = subtotal - subtotalHT %}

                    <div class="receipt-divider"></div>

                    <div class="receipt-tax-row">
                        <span>Sous-total HT</span>
                        <span>{{ subtotalHT|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <div class="receipt-tax-row">
                        <span>TVA (20 %)</span>
                        <span>{{ subtotalTVA|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <div class="receipt-tax-row">
                        <span>Sous-total TTC</span>
                        <span>{{ subtotal|number_format(2, ',', ' ') }} €</span>
                    </div>

                    {# ── Ligne remise code promo ── #}
                    {% if promoCode is defined and promoCode %}
                        <div class="receipt-tax-row receipt-tax-row--promo">
                            <span>
                                <i class="fas fa-ticket-alt mr-1" style="color:#16a34a;"></i>
                                Code <strong>{{ promoCode.code }}</strong>
                                <form method="post" action="{{ path('cart_remove_promo') }}" style="display:inline;margin-left:6px;">
                                    <button type="submit" style="background:none;border:none;color:#9ca3af;font-size:11px;cursor:pointer;padding:0;text-decoration:underline;">
                                        retirer
                                    </button>
                                </form>
                            </span>
                            <span style="color:#16a34a;font-weight:700;">
                                −{{ promoDiscount|number_format(2, ',', ' ') }} €
                            </span>
                        </div>
                    {% endif %}

                    {# ── Ligne livraison ── #}
                    <div class="receipt-tax-row receipt-tax-row--shipping">
                        <span>
                            <i class="fas fa-truck mr-1" style="color:rgb(9,71,113);"></i>
                            Livraison
                            {% if selectedMode and availableShipping[selectedMode] is defined %}
                                <small style="color:#6b7280;font-size:11px;">· {{ availableShipping[selectedMode].label }}</small>
                            {% endif %}
                        </span>
                        <span>
                            {% if shippingCost > 0 %}
                                {{ shippingCost|number_format(2, ',', ' ') }} €
                            {% else %}
                                <span style="color:#16a34a;font-weight:700;">Gratuit</span>
                            {% endif %}
                        </span>
                    </div>

                    <div class="receipt-divider receipt-divider--thick"></div>

                    <div class="receipt-total-row">
                        <span class="receipt-total-label">Total TTC</span>
                        <span class="receipt-total-amount">{{ total|number_format(2, ',', ' ') }} €</span>
                    </div>

                    <div class="receipt-legal">
                        <i class="fas fa-info-circle mr-1"></i>
                        TVA 20 % incluse — Prix affichés TTC
                    </div>

                    {# ══ Code promo ══ #}
                    {% if promoCode is not defined or not promoCode %}
                        <form method="post" action="{{ path('cart_apply_promo') }}" class="promo-form">
                            <label class="promo-form-label">
                                <i class="fas fa-ticket-alt mr-1" style="color:#16a34a;"></i>
                                Code promo
                            </label>
                            <div class="promo-form-row">
                                <input type="text" name="promo_code" class="promo-input"
                                       placeholder="Ex. : BIENVENUE10"
                                       autocomplete="off"
                                       style="text-transform:uppercase;">
                                <button type="submit" class="promo-apply-btn">
                                    Appliquer
                                </button>
                            </div>
                        </form>
                    {% endif %}

                    <a href="{{ path('checkout_shipping') }}" class="btn-checkout btn-checkout--stripe">
                        Passer la commande <i class="fas fa-arrow-right ml-2"></i>
                    </a>
                    <a href="{{ path('boutique_index') }}" class="btn-continue">
                        <i class="fas fa-arrow-left mr-1"></i> Continuer mes achats
                    </a>

                </div>
            </div>
        </div>
    {% endif %}

</div>

{% endblock %}
