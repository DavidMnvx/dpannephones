{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — D'Panne Phones{% endblock %}

{% block body %}
<div class="auth-page-wrap">
  <div class="auth-card auth-card--center">

    {% for message in app.flashes('error') %}
      <div class="auth-flash auth-flash--error">
        <i class="fas fa-times-circle mr-2"></i>{{ message }}
      </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
      <div class="auth-flash auth-flash--warning">
        <i class="fas fa-exclamation-triangle mr-2"></i>{{ message }}
      </div>
    {% endfor %}

    <h1 class="auth-title">Mot de passe oublié&nbsp;?</h1>
    <p class="check-email-intro" style="margin-bottom:24px;">
      Ça arrive à tout le monde. Donnez-nous l'adresse email de votre compte —
      on vous envoie un lien pour en choisir un nouveau, valable une heure.
    </p>

    <form method="post" style="text-align:left;">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
      <div class="login-field">
        <label for="email" class="login-label">
          <i class="fas fa-envelope mr-1"></i> Votre adresse email
        </label>
        <input type="email"
               id="email"
               name="email"
               class="login-input"
               placeholder="jean.dupont@exemple.fr"
               autocomplete="email"
               required
               autofocus>
      </div>
      <button type="submit" class="login-submit-btn" style="margin-top:18px;">
        <i class="fas fa-paper-plane mr-2"></i> Recevoir le lien
      </button>
    </form>

    <p style="margin-top:22px;font-size:14px;">
      <a href="{{ path('app_login') }}" class="login-forgot">← Retour à la connexion</a>
    </p>

  </div>
</div>
{% endblock %}
