{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — D'Panne Phones{% endblock %}

{% block body %}
<div class="auth-page-wrap">
  <div class="auth-card auth-card--center">

    {% if erreur %}
      <div class="auth-flash auth-flash--error">
        <i class="fas fa-times-circle mr-2"></i>{{ erreur }}
      </div>
    {% endif %}

    <h1 class="auth-title">Choisissez votre nouveau mot de passe</h1>
    <p class="check-email-intro" style="margin-bottom:24px;">
      Encore un instant et vous retrouvez votre compte —
      8 caractères minimum, et de préférence un mot de passe qui ne sert qu'ici.
    </p>

    {# Le formulaire poste sur l'URL signée courante : la signature est revalidée à la soumission. #}
    <form method="post" style="text-align:left;">
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
      <div class="login-field">
        <label for="password" class="login-label">
          <i class="fas fa-lock mr-1"></i> Nouveau mot de passe
        </label>
        <input type="password"
               id="password"
               name="password"
               class="login-input"
               autocomplete="new-password"
               minlength="8"
               required
               autofocus>
      </div>
      <div class="login-field" style="margin-top:14px;">
        <label for="password_confirm" class="login-label">
          <i class="fas fa-lock mr-1"></i> Confirmez-le
        </label>
        <input type="password"
               id="password_confirm"
               name="password_confirm"
               class="login-input"
               autocomplete="new-password"
               minlength="8"
               required>
      </div>
      <button type="submit" class="login-submit-btn" style="margin-top:18px;">
        <i class="fas fa-check mr-2"></i> Enregistrer et me connecter
      </button>
    </form>

  </div>
</div>
{% endblock %}
