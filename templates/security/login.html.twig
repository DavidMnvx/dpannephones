{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}

    <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel" data-interval="4000">
        
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="d-block w-100" src="{{ asset('images/baner/connexion.png') }}" alt="First slide">
                <div class="carousel-caption">
                    <h5 id="quiSommesNous" >Connexion</h5>
                </div>
            </div>        
        </div>
    </div>
    <div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-center">
                    <h1>Connectez-vous</h1>
                </div>
                <div class="card-body">
                    <form method="post">
                        {% if error %}
                            <div class="alert alert-danger">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>
                        {% endif %}

                        <div class="form-group">
                            <label for="username">Email</label>
                            <input type="text" class="form-control" id="username" name="_username" value="{{ last_username }}" required autofocus>
                        </div>

                        <div class="form-group">
                            <label for="password">Mot de passe</label>
                            <input type="password" class="form-control" id="password" name="_password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button type="submit" class="btn btn-primary btn-outline-block">Connexion</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
