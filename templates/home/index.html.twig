{# ═══════════════════════════════════════════════
   4 BLOCS PRÉSENTATION
═══════════════════════════════════════════════ #}
<div class="home-section-divider"></div>

<div class="presentation-container">

    {# Bloc 1 — Smartphones #}
    <div class="presentation-row reveal">
        <div class="presentation-img">
            <img src="{{ asset('images/accueil/real-mobile_accueil.png') }}" class="img-fluid-1" alt="Smartphones reconditionnés">
        </div>
        <div class="presentation-content">
            <div class="presentation-eyebrow">Téléphones</div>
            <h3 class="presentation-title">Smartphones Reconditionnés &amp; Occasions</h3>
            <p class="presentation-text">
                L'achat de <strong>téléphones d'occasion ou reconditionnés</strong> réduit l'empreinte écologique et évite la consommation de nouvelles ressources. Ces appareils vérifiés et testés offrent une alternative <strong>durable et économique</strong> aux téléphones neufs.
            </p>
            <a href="{{ path('boutique_index', {'categorie': 'telephone'}) }}" class="presentation-btn">
                <i class="fas fa-shopping-bag mr-2"></i>Voir les téléphones
            </a>
        </div>
    </div>

    {# Bloc 2 — PC #}
    <div class="presentation-row presentation-row--reverse reveal">
        <div class="presentation-img">
            <img src="{{ asset('images/accueil/pcAccueil.png') }}" class="img-fluid" alt="PC d'occasion">
        </div>
        <div class="presentation-content">
            <div class="presentation-eyebrow">Ordinateurs</div>
            <h3 class="presentation-title">Réparation &amp; Vente de PC d'Occasion</h3>
            <p class="presentation-text">
                Réparer votre PC ou acheter un <strong>ordinateur d'occasion</strong> prolonge la durée de vie des appareils et réduit les déchets électroniques. Nos techniciens diagnostiquent et réparent tous types de pannes pour vous éviter un investissement inutile.
            </p>
            <a href="{{ path('app_ordinateur') }}" class="presentation-btn">
                <i class="fas fa-laptop mr-2"></i>Réparer mon PC
            </a>
        </div>
    </div>

    {# Bloc 3 — Coques #}
    <div class="presentation-row reveal">
        <div class="presentation-img">
            <img src="{{ asset('images/accueil/coqueAccueil2.png') }}" class="img-fluid" alt="Coques téléphone">
        </div>
        <div class="presentation-content">
            <div class="presentation-eyebrow">Accessoires</div>
            <h3 class="presentation-title">Protégez Votre Téléphone</h3>
            <p class="presentation-text">
                Une <strong>coque de qualité</strong> absorbe les chocs et prévient les rayures pour éviter des réparations coûteuses. Notre boutique propose une large sélection de coques pour tous les modèles, alliant <strong>style et protection</strong>.
            </p>
            <a href="{{ path('boutique_index', {'categorie': 'accessoires'}) }}" class="presentation-btn">
                <i class="fas fa-shield-alt mr-2"></i>Voir les accessoires
            </a>
        </div>
    </div>

    {# Bloc 4 — Hydrogel #}
    <div class="presentation-row presentation-row--reverse reveal">
        <div class="presentation-img">
            <img src="{{ asset('images/accueil/Hydrogel3.png') }}" class="img-fluid" alt="Film hydrogel">
        </div>
        <div class="presentation-content">
            <div class="presentation-eyebrow">Protection écran</div>
            <h3 class="presentation-title">Film Hydrogel Sur Mesure</h3>
            <p class="presentation-text">
                Le <strong>film hydrogel</strong> est la protection la plus avancée pour votre écran. Il absorbe les impacts, est <strong>auto-réparant</strong> et s'adapte parfaitement aux contours de votre appareil. Pose immédiate en boutique, en quelques minutes.
            </p>
            <a href="{{ path('boutique_index', {'categorie': 'film_hydrogel'}) }}" class="presentation-btn">
                <i class="fas fa-mobile-alt mr-2"></i>Découvrir le film hydrogel
            </a>
        </div>
    </div>

</div>


{# ═══════════════════════════════════════════════
   DERNIERS ARTICLES — masqués si vides
═══════════════════════════════════════════════ #}
{% if dernierArticles is defined and dernierArticles is not empty %}

<div class="home-section-divider"></div>

{# Grille articles #}
<section class="home-articles-section reveal">
    <div class="home-articles-header">
        <div class="home-articles-eyebrow"><i class="fas fa-shopping-bag mr-2"></i>Notre boutique</div>
        <h2 class="home-articles-title">Derniers articles ajoutés</h2>
        <p class="home-articles-subtitle">Découvrez nos dernières nouveautés disponibles à la vente</p>
    </div>
    <div class="home-articles-grid">
        {% for article in dernierArticles|slice(0, 4) %}
        <div class="product-card">
            <div class="product-img-wrap">
                {% if article.image %}
                    <img src="{{ asset('uploads/images/' ~ article.image) }}" alt="{{ article.name }}">
                {% else %}
                    <i class="fas fa-image no-img"></i>
                {% endif %}
            </div>
            <div class="product-body">
                <div class="product-badges">
                    <span class="badge-etat {{ article.isNew ? 'badge-neuf' : 'badge-occasion' }}">
                        {{ article.isNew ? 'Neuf' : "D'occasion" }}
                    </span>
                    {% if article.grade %}
                        <span class="badge-grade">Grade {{ article.grade }}</span>
                    {% endif %}
                </div>
                <div class="product-name">{{ article.name }}</div>
                <div class="product-footer">
                    <span class="product-price">{{ article.price }} €</span>
                    {% if article.categorie is defined and article.categorie == 'film_hydrogel' %}
                        <a href="{{ path('boutique_index', {categorie: 'film_hydrogel'}) }}" class="btn-cart btn-cart--hydrogel">
                            <i class="fas fa-shield-alt"></i> Découvrir
                        </a>
                    {% else %}
                        <a href="{{ path('cart_add', {id: article.id}) }}" class="btn-cart">
                            <i class="fas fa-cart-plus"></i> Ajouter
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    <div class="home-articles-cta">
        <a href="{{ path('boutique_index') }}" class="home-articles-btn">
            Voir tous les articles <i class="fas fa-arrow-right ml-2"></i>
        </a>
    </div>
</section>

{% endif %}{# fin bloc articles #}



{# ═══════════════════════════════════════════════
   AVIS GOOGLE — masqués si vides
═══════════════════════════════════════════════ #}
{% if reviews is defined and reviews|length > 0 %}

<div class="home-section-divider"></div>

<div class="reviews-section reveal">
    <div class="reviews-header">
        <div class="reviews-eyebrow"><i class="fas fa-star mr-2"></i>Avis clients</div>
        <h2 class="reviews-title">Les clients ont laissé leurs avis</h2>
        {% if rating is defined %}
        <div class="reviews-global-rating">
            <span class="reviews-score">{{ rating }}</span>
            <div class="reviews-stars">
                {% for i in range(1, 5) %}
                    <i class="fas fa-star{% if i > rating|round %}-half-alt{% endif %}"></i>
                {% endfor %}
            </div>
            {% if totalRatings is defined %}
                <span class="reviews-count">{{ totalRatings }} avis</span>
            {% endif %}
        </div>
        {% endif %}
    </div>

    <div class="review-container">
        {% for review in reviews %}
        <div class="review-card">
            <div class="review-card-header">
                {% if review.profile_photo_url %}
                    <img src="{{ review.profile_photo_url }}" alt="{{ review.author_name }}" class="review-avatar" loading="lazy">
                {% else %}
                    {# Avatar avec initiales — généré depuis le nom #}
                    {% set parts = review.author_name|split(' ') %}
                    {% set initials = (parts[0]|first ~ (parts[1]|default('')|first))|upper %}
                    {% set colors = ['#3b82f6', '#16a34a', '#f59e0b', '#ec4899', '#8b5cf6', '#06b6d4', '#ef4444'] %}
                    {% set bgColor = colors[loop.index0 % colors|length] %}
                    <div class="review-avatar review-avatar--initials" style="background:{{ bgColor }};">
                        {{ initials }}
                    </div>
                {% endif %}
                <div class="review-meta">
                    <div class="review-author">{{ review.author_name }}</div>
                    <div class="review-time">
                        {{ review.relative_time ?? review.relative_time_description ?? '' }}
                        {% if review.rating == 5 %}
                            <span class="review-badge-verified" title="Avis 5 étoiles"><i class="fab fa-google"></i></span>
                        {% endif %}
                    </div>
                </div>
                <div class="review-stars-small">
                    {% for i in range(1, 5) %}
                        <i class="{{ i <= review.rating ? 'fas' : 'far' }} fa-star"></i>
                    {% endfor %}
                </div>
            </div>
            <p class="review-text">
                <i class="fas fa-quote-left review-quote-icon"></i>
                {{ review.text }}
            </p>
        </div>
        {% endfor %}
    </div>

    {# Lien vers Google Reviews #}
    <div class="reviews-cta">
        <a href="https://www.google.com/maps/place/?q=place_id:ChIJQ8joB7_5yRIRHpgyRx9z26o"
           target="_blank" rel="noopener noreferrer" class="reviews-google-link">
            <i class="fab fa-google mr-2"></i>
            Voir tous les avis sur Google
            <i class="fas fa-external-link-alt ml-2" style="font-size:11px;"></i>
        </a>
    </div>
</div>

{% endif %}{# fin bloc avis Google #}

{# ═══════════════════════════════════════════════
   AVIS CLIENTS DU SITE (achat vérifié)
═══════════════════════════════════════════════ #}
{% if clientReviews is defined and clientReviews|length > 0 %}

<div class="home-section-divider"></div>

<div class="reviews-section reveal">
    <div class="reviews-header">
        <div class="reviews-eyebrow" style="color:#16a34a;background:#dcfce7;border-color:rgba(22,163,74,0.2);">
            <i class="fas fa-shield-check mr-1"></i>Achats vérifiés
        </div>
        <h2 class="reviews-title">Retours de nos clients du site</h2>
        <p style="font-size:14px;color:#64748b;max-width:560px;margin:10px auto 0;">
            Avis laissés par nos clients après leur commande sur dpannephones.com — tous vérifiés par notre équipe.
        </p>
    </div>

    <div class="review-container">
        {% for review in clientReviews %}
            {% set name = review.displayName %}
            {% set parts = name|split(' ') %}
            {% set initials = (parts[0]|first ~ (parts[1]|default('')|first))|upper %}
            {% set colors = ['#3b82f6', '#16a34a', '#f59e0b', '#ec4899', '#8b5cf6', '#06b6d4', '#ef4444'] %}
            {% set bgColor = colors[loop.index0 % colors|length] %}
            <div class="review-card">
                <div class="review-card-header">
                    <div class="review-avatar review-avatar--initials" style="background:{{ bgColor }};">
                        {{ initials }}
                    </div>
                    <div class="review-meta">
                        <div class="review-author">
                            {{ name }}
                            {% if review.isVerified %}
                                <span class="review-badge-verified" style="background:linear-gradient(135deg, #16a34a 0%, #15803d 100%);" title="Achat vérifié">
                                    <i class="fas fa-check"></i>
                                </span>
                            {% endif %}
                        </div>
                        <div class="review-time">
                            {{ review.publishedAt ? review.publishedAt|date('d F Y') : review.createdAt|date('d F Y') }}
                        </div>
                    </div>
                    <div class="review-stars-small">
                        {% for i in range(1, 5) %}
                            <i class="{{ i <= review.rating ? 'fas' : 'far' }} fa-star"></i>
                        {% endfor %}
                    </div>
                </div>
                <h4 style="font-size:14.5px;font-weight:800;color:#0f172a;margin:6px 0 6px;">{{ review.title }}</h4>
                <p class="review-text">{{ review.comment|slice(0, 200) }}{% if review.comment|length > 200 %}…{% endif %}</p>
            </div>
        {% endfor %}
    </div>

    <div class="reviews-cta">
        <a href="{{ path('reviews_index') }}" class="reviews-google-link" style="color:rgb(9,71,113) !important;border-color:#e2e8f0;">
            <i class="fas fa-comments mr-2"></i>
            Voir tous les avis du site
            <i class="fas fa-arrow-right ml-2" style="font-size:11px;"></i>
        </a>
    </div>
</div>

{% endif %}{# fin bloc avis clients #}

{# ═══════════════════════════════════════════════
   AUTO-CAROUSEL AVIS MOBILE — Script discret
   Sur mobile (≤ 768px), on duplique les cards pour un défilement
   infini fluide. Sur desktop, grille normale (pas d'animation).
═══════════════════════════════════════════════ #}
<script>
(function() {
    /**
     * Transforme une grille en carrousel auto-scrolling sur mobile.
     * Duplique les cards pour un loop seamless.
     */
    function setupMobileCarousel(selector, activeClass, cloneAttr) {
        var isMobile = window.innerWidth <= 768;
        var containers = document.querySelectorAll(selector);

        containers.forEach(function(container) {
            // Reset si on passe mobile → desktop
            if (!isMobile) {
                if (container.classList.contains(activeClass)) {
                    container.classList.remove(activeClass);
                    container.querySelectorAll('[' + cloneAttr + ']').forEach(function(c) { c.remove(); });
                }
                return;
            }

            // Déjà configuré ? skip
            if (container.classList.contains(activeClass)) return;

            var cards = Array.from(container.children);
            if (cards.length < 2) return;

            cards.forEach(function(card) {
                var clone = card.cloneNode(true);
                clone.setAttribute('aria-hidden', 'true');
                clone.setAttribute(cloneAttr, 'true');
                container.appendChild(clone);
            });

            container.classList.add(activeClass);
        });
    }

    function setupAllCarousels() {
        setupMobileCarousel('.review-container',      'review-auto-scroll',         'data-review-clone');
        setupMobileCarousel('.home-articles-grid',    'home-articles-auto-scroll',  'data-article-clone');
    }

    // Setup au chargement
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupAllCarousels);
    } else {
        setupAllCarousels();
    }

    // Re-setup au resize (debounced)
    var resizeTimer;
    window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(setupAllCarousels, 250);
    });
})();
</script>

{% endblock %}
