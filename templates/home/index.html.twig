{% extends 'base.html.twig' %}

{% block title %}D'Pannes Phone — Réparation & Vente à Pélissanne{% endblock %}

{# ── JSON-LD aggregateRating (pour étoiles Google Search) ── #}
{% block jsonld %}
    {% set totalReviewsOnPage = (reviews|length) + (clientReviews|length) %}
    {% if rating and totalRatings %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": "{{ absolute_url('/') }}#business",
      "name": "D'Panne Phones",
      "url": "{{ absolute_url('/') }}",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{ rating }}",
        "reviewCount": "{{ totalRatings }}",
        "bestRating": "5",
        "worstRating": "1"
      }
    }
    </script>
    {% endif %}
{% endblock %}

{% block body %}

{# ═══════════════════════════════════════════════
   FLASH MESSAGES (confirmation avis, etc.)
═══════════════════════════════════════════════ #}
<div class="rev-flash-wrap" style="width:92%;max-width:1100px;margin:0 auto;padding:0 16px;">
    {% for msg in app.flashes('success') %}
        <div class="rev-flash rev-flash--success" style="margin-top:20px;">
            <i class="fas fa-check-circle"></i>
            <div>{{ msg|raw }}</div>
            <button type="button" class="rev-flash-close" onclick="this.parentElement.style.display='none'" aria-label="Fermer">&times;</button>
        </div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="rev-flash rev-flash--error" style="margin-top:20px;">
            <i class="fas fa-exclamation-circle"></i>
            <div>{{ msg|raw }}</div>
            <button type="button" class="rev-flash-close" onclick="this.parentElement.style.display='none'" aria-label="Fermer">&times;</button>
        </div>
    {% endfor %}
    {% for msg in app.flashes('info') %}
        <div class="rev-flash rev-flash--info" style="margin-top:20px;">
            <i class="fas fa-info-circle"></i>
            <div>{{ msg|raw }}</div>
            <button type="button" class="rev-flash-close" onclick="this.parentElement.style.display='none'" aria-label="Fermer">&times;</button>
        </div>
    {% endfor %}
    {% for msg in app.flashes('warning') %}
        <div class="rev-flash rev-flash--warning" style="margin-top:20px;">
            <i class="fas fa-exclamation-triangle"></i>
            <div>{{ msg|raw }}</div>
            <button type="button" class="rev-flash-close" onclick="this.parentElement.style.display='none'" aria-label="Fermer">&times;</button>
        </div>
    {% endfor %}
</div>

{# ═══════════════════════════════════════════════
   CAROUSEL HERO
═══════════════════════════════════════════════ #}
