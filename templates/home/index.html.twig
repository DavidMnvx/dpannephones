        <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
        <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
        <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        <li data-target="#carouselExampleIndicators" data-slide-to="3"></li>
    </ol>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset(site_image('banner_home_carousel_1', 'images/carousel/carousel1.jpg')) }}" alt="Réparation smartphone">
            <div class="carousel-caption home">
                <h5>Réparation rapide &amp; prix juste</h5>
                <p>Diagnostique gratuit en boutique — devis précis avant toute intervention</p>
                <div class="carousel-ctas">
                    <a href="{{ path('reparations_home') }}" class="carousel-btn-primary">Démarrer une réparation</a>
                    <a href="{{ path('contact') }}" class="carousel-btn-secondary">Nous contacter</a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="{{ asset(site_image('banner_home_carousel_2', 'images/carousel/carousel2.jpeg')) }}" alt="Téléphones reconditionnés">
            <div class="carousel-caption home">
                <h5>Téléphones reconditionnés &amp; occasions</h5>
                <p>Des appareils vérifiés, testés et garantis — à des prix accessibles</p>
                <div class="carousel-ctas">
                    <a href="{{ path('boutique_index') }}" class="carousel-btn-primary">Voir la boutique</a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="{{ asset(site_image('banner_home_carousel_3', 'images/carousel/carousel3.jpeg')) }}" alt="Accessoires et protection">
            <div class="carousel-caption home">
                <h5>Protégez votre appareil</h5>
                <p>Coques, films hydrogel posés sur mesure — protection maximale en quelques minutes</p>
                <div class="carousel-ctas">
                    <a href="{{ path('boutique_index') }}" class="carousel-btn-primary">Découvrir les accessoires</a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="{{ asset(site_image('banner_home_carousel_4', 'images/carousel/carousel4.jpeg')) }}" alt="PC et ordinateurs">
            <div class="carousel-caption home">
                <h5>PC Gaming, Bureautique &amp; Portables</h5>
                <p>Vente de PC configurés sur mesure et réparation d'ordinateurs toutes marques</p>
                <div class="carousel-ctas">
                    <a href="{{ path('boutique_index') }}" class="carousel-btn-primary">Voir les PC</a>
                    <a href="{{ path('app_ordinateur') }}" class="carousel-btn-secondary">Réparer mon PC</a>
                </div>
            </div>
        </div>
    </div>
    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </a>
</div>

{# ── Bande défilante nouveautés ── #}
{% if dernierArticles is defined and dernierArticles is not empty %}
