{% extends 'base.html.twig' %}

{% block title %}D'Pannes Phone — Réparation & Vente à Pélissanne{% endblock %}

{% block body %}

{# ═══════════════════════════════════════════════
   CAROUSEL HERO
═══════════════════════════════════════════════ #}
<div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel" data-interval="5000">
    <ol class="carousel-indicators">
        <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
        <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
        <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        <li data-target="#carouselExampleIndicators" data-slide-to="3"></li>
    </ol>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img class="d-block w-100" src="{{ asset('images/carousel/carousel1.jpg') }}" alt="Réparation smartphone">
            <div class="carousel-caption home">
                <h5>Réparation rapide &amp; prix juste</h5>
                <p>Diagnostique gratuit en boutique — devis précis avant toute intervention</p>
                <div class="carousel-ctas">
                    <a href="{{ path('reparations_home') }}" class="carousel-btn-primary">Démarrer une réparation</a>
                    <a href="{{ path('contact') }}" class="carousel-btn-secondary">Nous contacter</a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="{{ asset('images/carousel/carousel2.jpeg') }}" alt="Téléphones reconditionnés">
            <div class="carousel-caption home">
                <h5>Téléphones reconditionnés &amp; occasions</h5>
                <p>Des appareils vérifiés, testés et garantis — à des prix accessibles</p>
                <div class="carousel-ctas">
                    <a href="{{ path('boutique_index') }}" class="carousel-btn-primary">Voir la boutique</a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="{{ asset('images/carousel/carousel3.jpeg') }}" alt="Accessoires et protection">
            <div class="carousel-caption home">
                <h5>Protégez votre appareil</h5>
                <p>Coques, films hydrogel posés sur mesure — protection maximale en quelques minutes</p>
                <div class="carousel-ctas">
                    <a href="{{ path('boutique_index') }}" class="carousel-btn-primary">Découvrir les accessoires</a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <img class="d-block w-100" src="{{ asset('images/carousel/carousel4.jpeg') }}" alt="PC et ordinateurs">
            <div class="carousel-caption home">
                <h5>PC Gaming, Bureautique &amp; Portables</h5>
                <p>Vente de PC configurés sur mesure et réparation d'ordinateurs toutes marques</p>
                <div class="carousel-ctas">
                    <a href="{{ path('boutique_index') }}" class="carousel-btn-primary">Voir les PC</a>
                    <a href="{{ path('app_ordinateur') }}" class="carousel-btn-secondary">Réparer mon PC</a>
                </div>
            </div>
        </div>
    </div>
    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
    </a>
</div>


{# ═══════════════════════════════════════════════
   SÉLECTION D'APPAREIL — action principale, en 1er
═══════════════════════════════════════════════ #}
<div class="appareil-section reveal">
    <div class="appareil-header">
        <div class="appareil-eyebrow">Réparation</div>
        <h2 class="appareil-title">Quel appareil souhaitez-vous réparer ?</h2>
        <p class="appareil-subtitle">Sélectionnez votre type d'appareil pour commencer</p>
    </div>
    <div class="appareil-grid appareil-grid--large">

        <a href="{{ path('choix_marque', {'type': 'phone'}) }}" class="appareil-card appareil-card--large">
            <div class="appareil-img-wrap">
                <img src="{{ asset('images/accueil/rep_phone_accueil.png') }}" alt="Téléphone">
            </div>
            <div class="appareil-card-footer">
                <span class="appareil-label"><i class="fas fa-mobile-alt mr-2"></i>Téléphone</span>
                <span class="appareil-arrow"><i class="fas fa-arrow-right"></i></span>
            </div>
        </a>

        <a href="{{ path('choix_marque', {'type': 'tablet'}) }}" class="appareil-card appareil-card--large">
            <div class="appareil-img-wrap">
                <img src="{{ asset('images/accueil/rep_tablette_accueil.png') }}" alt="Tablette">
            </div>
            <div class="appareil-card-footer">
                <span class="appareil-label"><i class="fas fa-tablet-alt mr-2"></i>Tablette</span>
                <span class="appareil-arrow"><i class="fas fa-arrow-right"></i></span>
            </div>
        </a>

        <a href="{{ path('app_ordinateur') }}" class="appareil-card appareil-card--large">
            <div class="appareil-img-wrap">
                <img src="{{ asset('images/accueil/rep_pc_accueil.png') }}" alt="Ordinateur">
            </div>
            <div class="appareil-card-footer">
                <span class="appareil-label"><i class="fas fa-laptop mr-2"></i>Ordinateur</span>
                <span class="appareil-arrow"><i class="fas fa-arrow-right"></i></span>
            </div>
        </a>

    </div>
</div>


{# ═══════════════════════════════════════════════
   NOTRE BOUTIQUE
═══════════════════════════════════════════════ #}
<div class="home-section-divider"></div>

<section class="accueil-boutique-section reveal">
    <div class="accueil-boutique-img-wrap">
        <img src="{{ asset('images/accueil/boutique_accueil2.jpeg') }}" alt="Notre boutique D'panne Phones">
        <div class="accueil-boutique-img-overlay">
            <span class="accueil-boutique-badge"><i class="fas fa-store mr-2"></i>En boutique à Pélissanne</span>
        </div>
    </div>

    <div class="accueil-boutique-content">
        <div class="accueil-boutique-eyebrow">Depuis 2017</div>
        <h2 class="accueil-boutique-title">Notre Boutique</h2>
        <p class="accueil-boutique-desc">
            Bienvenue chez <strong>D'panne Phones</strong> — votre spécialiste en réparation de smartphones, tablettes et ordinateurs.
            Venez découvrir notre sélection de téléphones reconditionnés, accessoires et bien plus encore.
        </p>

        <div class="accueil-horaires">
            <div class="accueil-horaires-title"><i class="fas fa-clock mr-2"></i>Horaires d'ouverture</div>
            <div class="accueil-horaires-grid">
                <div class="accueil-horaires-row">
                    <span class="accueil-horaires-day">Lun — Ven</span>
                    <span class="accueil-horaires-dot"></span>
                    <span class="accueil-horaires-time">9h00 – 12h00 &nbsp;|&nbsp; 14h00 – 18h00</span>
                </div>
                <div class="accueil-horaires-row">
                    <span class="accueil-horaires-day">Samedi</span>
                    <span class="accueil-horaires-dot"></span>
                    <span class="accueil-horaires-time">9h00 – 12h00</span>
                </div>
                <div class="accueil-horaires-row closed">
                    <span class="accueil-horaires-day">Dimanche</span>
                    <span class="accueil-horaires-dot"></span>
                    <span class="accueil-horaires-time">Fermé</span>
                </div>
            </div>
        </div>

        <div class="accueil-boutique-actions">
            <a href="{{ path('boutique_index') }}" class="accueil-btn-primary">
                <i class="fas fa-shopping-bag mr-2"></i>Voir la boutique
            </a>
            <a href="{{ path('contact') }}" class="accueil-btn-secondary">
                <i class="fas fa-phone mr-2"></i>Nous contacter
            </a>
        </div>
    </div>
</section>


{# ═══════════════════════════════════════════════
   DERNIERS ARTICLES — masqués si vides
═══════════════════════════════════════════════ #}
{% if dernierArticles is defined and dernierArticles is not empty %}

<div class="home-section-divider"></div>

{# Bande défilante #}
<div class="articles-ticker-wrap">
    <div class="articles-ticker-label">
        <i class="fas fa-shopping-bag mr-2"></i>Nouveautés
    </div>
    <div class="articles-ticker-track-wrap">
        <div class="articles-ticker-track">
            {% for article in dernierArticles %}
            <a href="{{ path('boutique_index') }}" class="articles-ticker-item">
                {% if article.image %}
                    <img src="{{ asset('uploads/images/' ~ article.image) }}" alt="{{ article.name }}">
                {% else %}
                    <span class="articles-ticker-noimg"><i class="fas fa-image"></i></span>
                {% endif %}
                <span class="articles-ticker-name">{{ article.name }}</span>
                <span class="articles-ticker-price">{{ article.price }} €</span>
            </a>
            {% endfor %}
            {% for article in dernierArticles %}
            <a href="{{ path('boutique_index') }}" class="articles-ticker-item">
                {% if article.image %}
                    <img src="{{ asset('uploads/images/' ~ article.image) }}" alt="{{ article.name }}">
                {% else %}
                    <span class="articles-ticker-noimg"><i class="fas fa-image"></i></span>
                {% endif %}
                <span class="articles-ticker-name">{{ article.name }}</span>
                <span class="articles-ticker-price">{{ article.price }} €</span>
            </a>
            {% endfor %}
        </div>
    </div>
</div>

{# Grille articles #}
<section class="home-articles-section reveal">
    <div class="home-articles-header">
        <div class="home-articles-eyebrow"><i class="fas fa-shopping-bag mr-2"></i>Notre boutique</div>
        <h2 class="home-articles-title">Derniers articles ajoutés</h2>
        <p class="home-articles-subtitle">Découvrez nos dernières nouveautés disponibles à la vente</p>
    </div>
    <div class="home-articles-grid">
        {% for article in dernierArticles|slice(0, 4) %}
        <div class="product-card">
            <div class="product-img-wrap">
                {% if article.image %}
                    <img src="{{ asset('uploads/images/' ~ article.image) }}" alt="{{ article.name }}">
                {% else %}
                    <i class="fas fa-image no-img"></i>
                {% endif %}
            </div>
            <div class="product-body">
                <div class="product-badges">
                    <span class="badge-etat {{ article.isNew ? 'badge-neuf' : 'badge-occasion' }}">
                        {{ article.isNew ? 'Neuf' : "D'occasion" }}
                    </span>
                    {% if article.grade %}
                        <span class="badge-grade">Grade {{ article.grade }}</span>
                    {% endif %}
                </div>
                <div class="product-name">{{ article.name }}</div>
                <div class="product-footer">
                    <span class="product-price">{{ article.price }} €</span>
                    <a href="{{ path('cart_add', {id: article.id}) }}" class="btn-cart">
                        <i class="fas fa-cart-plus"></i> Ajouter
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    <div class="home-articles-cta">
        <a href="{{ path('boutique_index') }}" class="home-articles-btn">
            Voir tous les articles <i class="fas fa-arrow-right ml-2"></i>
        </a>
    </div>
</section>

{% endif %}{# fin bloc articles #}


{# ═══════════════════════════════════════════════
   4 BLOCS PRÉSENTATION
═══════════════════════════════════════════════ #}
<div class="home-section-divider"></div>

<div class="presentation-container">

    {# Bloc 1 — Smartphones #}
    <div class="presentation-row reveal">
        <div class="presentation-img">
            <img src="{{ asset('images/accueil/real-mobile_accueil.png') }}" class="img-fluid-1" alt="Smartphones reconditionnés">
        </div>
        <div class="presentation-content">
            <div class="presentation-eyebrow">Téléphones</div>
            <h3 class="presentation-title">Smartphones Reconditionnés &amp; Occasions</h3>
            <p class="presentation-text">
                L'achat de <strong>téléphones d'occasion ou reconditionnés</strong> réduit l'empreinte écologique et évite la consommation de nouvelles ressources. Ces appareils vérifiés et testés offrent une alternative <strong>durable et économique</strong> aux téléphones neufs.
            </p>
            <a href="{{ path('boutique_index', {'categorie': 'telephone'}) }}" class="presentation-btn">
                <i class="fas fa-shopping-bag mr-2"></i>Voir les téléphones
            </a>
        </div>
    </div>

    {# Bloc 2 — PC #}
    <div class="presentation-row presentation-row--reverse reveal">
        <div class="presentation-img">
            <img src="{{ asset('images/accueil/pcAccueil.png') }}" class="img-fluid" alt="PC d'occasion">
        </div>
        <div class="presentation-content">
            <div class="presentation-eyebrow">Ordinateurs</div>
            <h3 class="presentation-title">Réparation &amp; Vente de PC d'Occasion</h3>
            <p class="presentation-text">
                Réparer votre PC ou acheter un <strong>ordinateur d'occasion</strong> prolonge la durée de vie des appareils et réduit les déchets électroniques. Nos techniciens diagnostiquent et réparent tous types de pannes pour vous éviter un investissement inutile.
            </p>
            <a href="{{ path('app_ordinateur') }}" class="presentation-btn">
                <i class="fas fa-laptop mr-2"></i>Réparer mon PC
            </a>
        </div>
    </div>

    {# Bloc 3 — Coques #}
    <div class="presentation-row reveal">
        <div class="presentation-img">
            <img src="{{ asset('images/accueil/coqueAccueil2.png') }}" class="img-fluid" alt="Coques téléphone">
        </div>
        <div class="presentation-content">
            <div class="presentation-eyebrow">Accessoires</div>
            <h3 class="presentation-title">Protégez Votre Téléphone</h3>
            <p class="presentation-text">
                Une <strong>coque de qualité</strong> absorbe les chocs et prévient les rayures pour éviter des réparations coûteuses. Notre boutique propose une large sélection de coques pour tous les modèles, alliant <strong>style et protection</strong>.
            </p>
            <a href="{{ path('boutique_index', {'categorie': 'accessoires'}) }}" class="presentation-btn">
                <i class="fas fa-shield-alt mr-2"></i>Voir les accessoires
            </a>
        </div>
    </div>

    {# Bloc 4 — Hydrogel #}
    <div class="presentation-row presentation-row--reverse reveal">
        <div class="presentation-img">
            <img src="{{ asset('images/accueil/Hydrogel3.png') }}" class="img-fluid" alt="Film hydrogel">
        </div>
        <div class="presentation-content">
            <div class="presentation-eyebrow">Protection écran</div>
            <h3 class="presentation-title">Film Hydrogel Sur Mesure</h3>
            <p class="presentation-text">
                Le <strong>film hydrogel</strong> est la protection la plus avancée pour votre écran. Il absorbe les impacts, est <strong>auto-réparant</strong> et s'adapte parfaitement aux contours de votre appareil. Pose immédiate en boutique, en quelques minutes.
            </p>
            <a href="{{ path('boutique_index', {'categorie': 'film_hydrogel'}) }}" class="presentation-btn">
                <i class="fas fa-mobile-alt mr-2"></i>Découvrir le film hydrogel
            </a>
        </div>
    </div>

</div>


{# ═══════════════════════════════════════════════
   AVIS GOOGLE — masqués si vides
═══════════════════════════════════════════════ #}
{% if reviews is defined and reviews|length > 0 %}

<div class="home-section-divider"></div>

<div class="reviews-section reveal">
    <div class="reviews-header">
        <div class="reviews-eyebrow"><i class="fas fa-star mr-2"></i>Avis clients</div>
        <h2 class="reviews-title">Les clients ont laissé leurs avis</h2>
        {% if rating is defined %}
        <div class="reviews-global-rating">
            <span class="reviews-score">{{ rating }}</span>
            <div class="reviews-stars">
                {% for i in range(1, 5) %}
                    <i class="fas fa-star{% if i > rating|round %}-half-alt{% endif %}"></i>
                {% endfor %}
            </div>
            {% if totalRatings is defined %}
                <span class="reviews-count">{{ totalRatings }} avis</span>
            {% endif %}
        </div>
        {% endif %}
    </div>

    <div class="review-container">
        {% for review in reviews %}
        <div class="review-card">
            <div class="review-card-header">
                <img src="{{ review.profile_photo_url }}" alt="{{ review.author_name }}" class="review-avatar">
                <div class="review-meta">
                    <div class="review-author">{{ review.author_name }}</div>
                    <div class="review-time">{{ review.relative_time_description }}</div>
                </div>
                <div class="review-stars-small">
                    {% for i in range(1, 5) %}
                        <i class="{{ i <= review.rating ? 'fas' : 'far' }} fa-star"></i>
                    {% endfor %}
                </div>
            </div>
            <p class="review-text">{{ review.text }}</p>
        </div>
        {% endfor %}
    </div>
</div>

{% endif %}{# fin bloc avis #}

{% endblock %}
