# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# ⚠️  NE METTRE AUCUNE VRAIE CLÉ SECRÈTE ICI ⚠️
# Ce fichier est versionné dans Git. Les secrets doivent être dans .env.local
# (dev) ou dans les variables d'env du serveur (prod).

###> symfony/framework-bundle ###
APP_ENV=dev
# APP_SECRET est à définir dans .env.local (dev) ou via variables d'env VPS (prod)
APP_SECRET=CHANGE_ME_IN_ENV_LOCAL
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL à définir dans .env.local (dev) ou via variables d'env VPS (prod)
DATABASE_URL="mysql://root:root@127.0.0.1:3306/d_panne_phones?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# MAILER_DSN à définir dans .env.local (SMTP Brevo en dev, idem en prod)
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM=contact@dpannephones.com
MAILER_FROM_NAME="D'Panne Phones"
# Email du support qui recevra : formulaire de contact + notification nouvelles commandes
ADMIN_EMAIL=dpannephones@outlook.fr
###< symfony/mailer ###

###> stripe ###
# ⚠️  NE JAMAIS mettre les vraies clés ici — utiliser .env.local ou variables d'env VPS
# Dashboard : https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
###< stripe ###

###> google analytics ###
# ID de mesure Google Analytics 4 (format : G-XXXXXXXXXX).
# Laisser vide pour désactiver le tracking (dev par défaut).
# À renseigner uniquement en production, dans .env.prod.local sur le VPS.
# Dashboard : https://analytics.google.com
GOOGLE_ANALYTICS_ID=
###< google analytics ###
