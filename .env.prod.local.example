# ════════════════════════════════════════════════════════════════════════
#  .env.prod.local — TEMPLATE POUR LA PRODUCTION (VPS)
# ════════════════════════════════════════════════════════════════════════
#
#  ⚠️  IMPORTANT :
#  1. Copier ce fichier sur le VPS vers `.env.prod.local` (sans .example)
#  2. Remplir avec les VRAIES clés de production
#  3. Vérifier que le fichier a les bonnes permissions (chmod 600)
#  4. NE JAMAIS commiter ce fichier (il est dans .gitignore grâce à `.env.*.local`)
#
# ════════════════════════════════════════════════════════════════════════

###> Symfony framework ###
APP_ENV=prod
APP_DEBUG=0
# Générer un NOUVEAU secret unique avec : openssl rand -hex 32
APP_SECRET=REMPLACER_PAR_UN_SECRET_UNIQUE_DE_64_CARACTERES
###< Symfony framework ###

###> Doctrine database ###
# URL de la base MySQL de production (ajuster host/user/password/port)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME?serverVersion=8.0.32&charset=utf8mb4"
###< Doctrine ###

###> Brevo SMTP (production) ###
# Même clé que dev, sauf si vous utilisez un sous-compte dédié prod
BREVO_DSN=smtp://LOGIN%40smtp-brevo.com:CLE_SMTP@smtp-relay.brevo.com:587
# Email qui reçoit : formulaire de contact + notifications commandes + notifications avis
ADMIN_EMAIL=dpannephones@outlook.fr
MAILER_FROM=contact@dpannephones.com
MAILER_FROM_NAME="D'Panne Phones"
###< Brevo ###

###> Stripe — CLÉS LIVE DE PRODUCTION ###
# Dashboard : https://dashboard.stripe.com/apikeys (mode LIVE)
# ⚠️  Ces clés doivent avoir été RÉGÉNÉRÉES après le nettoyage de l'historique Git
STRIPE_PUBLIC_KEY=pk_live_VOTRE_NOUVELLE_CLE_PUBLIQUE
STRIPE_SECRET_KEY=sk_live_VOTRE_NOUVELLE_CLE_SECRETE
# Webhook : https://dashboard.stripe.com/webhooks
# Le endpoint à configurer sur Stripe : https://dpannephones.com/payment/webhook
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_NOUVEAU_WEBHOOK_SECRET
###< Stripe ###

###> Trusted proxies (si derrière Nginx/Cloudflare) ###
# TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
# TRUSTED_HOSTS='^dpannephones\.com$'
###< Trusted proxies ###

###> Google Analytics 4 (optionnel) ###
# Pour activer le tracking de trafic sur le site public :
# 1. Créer une propriété GA4 sur https://analytics.google.com
# 2. Récupérer l'ID de mesure (format : G-XXXXXXXXXX)
# 3. Le coller ici (décommenter la ligne)
# ⚠️  Nécessite un bandeau de consentement cookies (RGPD)
# Laisser vide ou supprimer la ligne = tracking désactivé
GOOGLE_ANALYTICS_ID=
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
###< Google Analytics ###
